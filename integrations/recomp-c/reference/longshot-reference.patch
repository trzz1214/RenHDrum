@@ -0,0 +1,114 @@
+/* (longshot) Game-state adaptive trigger layer for OoT (Plan 143).
+   Reads button/menu/camera/audio signals each controller poll and drives DualSense trigger presets
+   via rh_trigger_preset without requiring Longshot rebuilds to tune numbers (HOS_TRIG_* env vars). */
+#include "hos.h"
+#include "rh_host.h"
+#include "oot_trigger.h"
+#include <math.h>
+#include <stdint.h>
+#include <stdlib.h>
+#ifndef LONGSHOT_ENV_H
+#include "../gpu/vk/compat/longshot_env.h"
+#endif
+
+int64_t hos_now_ns(void);
+int64_t hos_audio_last_ocarina_ns(void);
+float hos_pad_r2_depth(void);                       /* host/pad_sdl.c */
+void hos_oot_link_read(int32_t *verb, int32_t *sel); /* host/oot_trigprobe.c */
+int hos_oot_gamedata_int(uint32_t hash, int64_t *v);
+uint32_t hos_oot_flag_hash(const char *name);
+
+static volatile int trig_env_cache = -1;
+static OotTrigState trig_state = OOT_TRIG_STATE_INIT;
+
+int hos_oot_trigger_enabled(void) {
+    int v = __atomic_load_n(&trig_env_cache, __ATOMIC_ACQUIRE);
+    if (v < 0) {
+        const char *e = getenv("HOS_TRIG_PRESETS");
+        v = !e || !env_value_off(e);
+        __atomic_store_n(&trig_env_cache, v, __ATOMIC_RELEASE);
+    }
+    return v && rh_hd_triggers_on();
+}
+
+static float trig_env_float(const char *name, float def, float lo, float hi) {
+    const char *s = getenv(name);
+    if (!s || !*s) return def;
+    char *end = NULL;
+    float v = strtof(s, &end);
+    if (end == s || !isfinite(v)) return def;
+    while (*end == ' ' || *end == '\t') end++;
+    if (*end != '\0') return def;
+    if (v < lo) v = lo;
+    if (v > hi) v = hi;
+    return v;
+}
+
+static const OotTrigCfg *trig_config(void) {
+    static int loaded;
+    static OotTrigCfg cfg;
+    if (!loaded) {
+        cfg.sling = trig_env_float("HOS_TRIG_SLING", OOT_TRIG_SLING_DEFAULT, 0.0f, 1.0f);
+        cfg.bow = trig_env_float("HOS_TRIG_BOW", OOT_TRIG_BOW_DEFAULT, 0.0f, 1.0f);
+        cfg.hook = trig_env_float("HOS_TRIG_HOOK", OOT_TRIG_HOOK_DEFAULT, 0.0f, 1.0f);
+        cfg.din = trig_env_float("HOS_TRIG_DIN", OOT_TRIG_DIN_DEFAULT, 0.0f, 1.0f);
+        cfg.hook_pulse = trig_env_float("HOS_TRIG_HOOK_PULSE", OOT_TRIG_HOOK_PULSE_DEFAULT, 0.0f, 1.0f);
+        cfg.deep_fire = trig_env_float("HOS_TRIG_DEEP_FIRE", (float)OOT_TRIG_DEEP_FIRE_DEFAULT, 0.0f, 1.0f) >= 0.5f;
+        cfg.deep_at = trig_env_float("HOS_TRIG_DEEP_AT", OOT_TRIG_DEEP_AT_DEFAULT, 0.5f, 1.0f);
+        cfg.hammer = trig_env_float("HOS_TRIG_HAMMER", OOT_TRIG_HAMMER_DEFAULT, 0.0f, 1.0f);
+        cfg.rumble_on = trig_env_float("HOS_TRIG_RUMBLE_ON", OOT_TRIG_RUMBLE_ON_DEFAULT, 0.0f, 1.0f);
+        cfg.rumble_off = trig_env_float("HOS_TRIG_RUMBLE_OFF", OOT_TRIG_RUMBLE_OFF_DEFAULT, 0.0f, 1.0f);
+        cfg.hammer_hit = trig_env_float("HOS_TRIG_HAMMER_HIT", OOT_TRIG_HAMMER_HIT_DEFAULT, 0.0f, 1.0f);
+        cfg.hammer_pulse = trig_env_float("HOS_TRIG_HAMMER_PULSE", OOT_TRIG_HAMMER_PULSE_DEFAULT, 0.0f, 1.0f);
+        cfg.quake = trig_env_float("HOS_TRIG_QUAKE", OOT_TRIG_QUAKE_DEFAULT, 0.0f, 1.0f);
+        cfg.hook_cancel = trig_env_float("HOS_TRIG_HOOK_CANCEL", (float)OOT_TRIG_HOOK_CANCEL_DEFAULT, 0.0f, 1.0f) >= 0.5f;
+        cfg.cancel_after_ms = (int)trig_env_float("HOS_TRIG_CANCEL_AFTER_MS", (float)OOT_TRIG_CANCEL_AFTER_MS_DEFAULT, 0.0f, 5000.0f);
+        loaded = 1;
+    }
+    return &cfg;
+}
+
+void hos_oot_trigprobe_frame(void);   /* host/oot_trigprobe.c: HOS_TRIG_PROBE=1 */
+void hos_oot_leds_frame(void);   /* host/oot_leds.c (plans 147, 149) */
+
+/* Returns the buttons the game should see: ZR let go while deep fire has fired (the rest is untouched). */
+uint64_t hos_oot_trigger_frame(uint64_t buttons, int menu_open) {
+    hos_oot_trigprobe_frame();
+    static int trig_was_on = 0;
+    if (!hos_oot_trigger_enabled()) {
+        if (trig_was_on) {
+            trig_state = (OotTrigState)OOT_TRIG_STATE_INIT;
+            trig_was_on = 0;
+        }
+        return hos_oot_leds_frame(), buttons;
+    }
+    trig_was_on = 1;
+    static uint32_t h_arrow, h_seed;
+    if (!h_arrow) h_arrow = hos_oot_flag_hash("PouchData.Item_Arrow_Normal.StockNum"),
+                  h_seed = hos_oot_flag_hash("PouchData.Item_DekuSeed.StockNum");
+    OotTrigIn in = {hos_now_ns(), -1, -1, -1, -1, hos_pad_r2_depth(), menu_open != 0, hos_audio_last_ocarina_ns(),
+                  (int)(buttons >> OOT_TRIG_B_ZR & 1), rh_game_rumble_amp()};
+    int32_t verb, sel;
+    hos_oot_link_read(&verb, &sel);
+    in.verb = verb, in.sel = sel;
+    if (!hos_oot_gamedata_int(h_arrow, &in.arrows)) in.arrows = -1;
+    if (!hos_oot_gamedata_int(h_seed, &in.seeds)) in.seeds = -1;
+    const OotTrigOut out = oot_trigger_eval(&trig_state, trig_config(), &in);
+    hos_oot_leds_frame();   /* (the light bar: Link hit, or low life) */
+    static int64_t last_key = -1;
+    const int depth10 = (int)(in.depth * 10.0f + 0.5f);
+    const int sent = out.send_r ? out.id_r : 31;   /* what R2 got: 0 = OFF, 31 = nothing */
+    const int rumble10 = (int)(in.rumble * 10.0f + 0.5f);
+    const int64_t key = (int64_t)sent << 40 | (int64_t)rumble10 << 29 | out.rule | (in.menu_open << 3) | depth10 << 4 | ((out.sel + 1) & 0xff) << 8 | ((verb + 1) & 0x3ff) << 16 | out.clear_zr << 28 | (int64_t)(out.force_zr | out.force_b << 1) << 26;
+    static int64_t last_ammo = -2;
+    if (key != last_key || out.ammo != last_ammo) {
+        last_key = key, last_ammo = out.ammo;
+        hos_log("trigger: rule=%d sent=%d sel=0x%x ammo=%lld depth=%.1f verb=%d menu=%d deep=%d rumble=%.2f cancel=%d", out.rule, sent,
+                (unsigned)out.sel, (long long)out.ammo, depth10 / 10.0, verb, in.menu_open, out.clear_zr, (double)in.rumble, out.force_zr | out.force_b << 1);
+    }
+    if (out.send_l) rh_trigger_preset(0, out.id_l, out.level_l);
+    if (out.send_r) rh_trigger_preset(1, out.id_r, out.level_r);
+    if (out.force_zr) buttons |= 1ULL << OOT_TRIG_B_ZR;   /* the cancel chain: ZR held, B pressed then let go */
+    if (out.force_b) buttons |= 1ULL << OOT_TRIG_B_B;
+    return out.clear_zr ? buttons & ~(1ULL << OOT_TRIG_B_ZR) : buttons;
+}
diff --git a/host/oot_trigger.h b/host/oot_trigger.h
new file mode 100644
index 00000000..f8030b5f
--- /dev/null
+++ b/host/oot_trigger.h
@@ -0,0 +1,279 @@
+/* (longshot) Pure game-state -> DualSense trigger preset rules for OoT (Plan 143, step 6c).
+   The item on ZR (player +0x7D0), its ammo, Link's verb and how deep R2 is pulled pick R2's preset; L2 never has one (layer 1).
+   Kept header-only so host/oot_trigger.c and tests/test_oot_trigger.py share the exact logic without the game. */
+#ifndef LONGSHOT_OOT_TRIGGER_H
+#define LONGSHOT_OOT_TRIGGER_H
+
+#include <stdint.h>
+
+#ifndef RENHDRUM_TRIG_OFF
+#define RENHDRUM_TRIG_OFF          0
+#endif
+#ifndef RENHDRUM_TRIG_TENSION
+#define RENHDRUM_TRIG_TENSION      1
+#endif
+#ifndef RENHDRUM_TRIG_HEAVY_LOAD
+#define RENHDRUM_TRIG_HEAVY_LOAD   11
+#endif
+#ifndef RENHDRUM_TRIG_IMPACT_PULSE
+#define RENHDRUM_TRIG_IMPACT_PULSE 12
+#endif
+#ifndef RENHDRUM_TRIG_TWO_STAGE
+#define RENHDRUM_TRIG_TWO_STAGE    2
+#endif
+#ifndef RENHDRUM_TRIG_ENGINE_ROUGH
+#define RENHDRUM_TRIG_ENGINE_ROUGH 13
+#endif
+
+#define OOT_TRIG_SLING_DEFAULT        0.5f    /* TENSION level while R2 is pulled with the slingshot on ZR */
+#define OOT_TRIG_BOW_DEFAULT          0.75f   /* ... with the bow */
+#define OOT_TRIG_HOOK_DEFAULT         0.6f    /* TWO_STAGE level: the "aiming" notch of the Hookshot / Longshot */
+#define OOT_TRIG_DIN_DEFAULT          0.6f    /* ENGINE_ROUGH level while Din's Fire is cast */
+#define OOT_TRIG_HAMMER_DEFAULT       0.7f    /* HEAVY_LOAD level while the Megaton Hammer is swung */
+#define OOT_TRIG_HOOK_PULSE_DEFAULT   1.0f    /* the Hookshot / Longshot pulse */
+#define OOT_TRIG_DEEP_FIRE_DEFAULT    1       /* 1 = squeezing R2 past the notch fires the Hookshot / Longshot (ZR let go for the game) */
+#define OOT_TRIG_DEEP_AT_DEFAULT      0.95f   /* "to the end" */
+/* (the deep-fire latch opens when the pad's own ZR bit is off: R2 under the button threshold, not a number of ours) */
+#define OOT_TRIG_ANALOG_LO            0.1f    /* a real analog trigger passes through LO..HI on its way down; */
+#define OOT_TRIG_ANALOG_HI            0.8f    /* a digital ZR (Pro 1 ...) jumps straight to 1.0 and never fires deep */
+#define OOT_TRIG_RUMBLE_ON_DEFAULT    0.03f   /* the game's rumble counts as "on" from this amplitude */
+#define OOT_TRIG_RUMBLE_OFF_DEFAULT   0.015f  /* ... and as "off" once it stays under this ... */
+#define OOT_TRIG_RUMBLE_OFF_NS    100000000LL  /* ... for this long (no flicker) */
+#define OOT_TRIG_QUAKE_MIN            0.3f    /* the quake never goes under this share of its level while the rumble lasts */
+#define OOT_TRIG_HAMMER_HIT_DEFAULT   0.06f    /* the game's rumble over this = the hammer has struck */
+#define OOT_TRIG_HAMMER_PULSE_DEFAULT 1.0f    /* the strike pulse */
+#define OOT_TRIG_QUAKE_DEFAULT        0.7f    /* ENGINE_ROUGH level of the quake at the strike's peak */
+#define OOT_TRIG_HOOK_CANCEL_DEFAULT  1       /* 1 = letting go of a Hookshot / Longshot aim before the deep squeeze cancels it */
+#define OOT_TRIG_CANCEL_AFTER_MS_DEFAULT 250  /* ZR held at least this long before a let-go counts as a cancel (a tap is a sword swing) */
+#define OOT_TRIG_CANCEL_B_NS      100000000LL  /* cancel chain, phase 1: the game sees ZR held + B held */
+#define OOT_TRIG_CANCEL_END_NS    150000000LL  /* phase 2 (to here): ZR held, B let go; then the real buttons */
+#define OOT_TRIG_B_B                  1       /* the B bit of nn_hid.c (static-asserted there) */
+#define OOT_TRIG_B_ZR                 9       /* the ZR bit of nn_hid.c (static-asserted there) */
+
+#define OOT_TRIG_AUDIO_QUIET_NS  300000000LL   /* Ocarina sound this recent -> both triggers Off */
+#define OOT_TRIG_SEL_HOLD_NS      80000000LL   /* a new item on ZR counts once it held this long (gear noise) */
+#define OOT_TRIG_PULL_MIN         0.03f        /* R2 deeper than this is "pulled" */
+
+enum { OOT_SEL_BOOMERANG = 0x03, OOT_SEL_SLING = 0x04, OOT_SEL_HOOK = 0x05, OOT_SEL_LONGSHOT = 0x06, OOT_SEL_BOW = 0x1E,
+       OOT_SEL_DIN = 0x0A /* Din's Fire */, OOT_SEL_HAMMER = 0x07 /* Megaton Hammer */,
+       OOT_SEL_ARROW_FIRE = 0x2E, OOT_SEL_ARROW_ICE = 0x2F, OOT_SEL_ARROW_LIGHT = 0x30 /* shot like a bow, ammo = arrows */ };
+enum { OOT_VERB_HOOK_SHOOT = 5, OOT_VERB_DIN_CAST = 243, OOT_VERB_HAMMER = 112 /* hammer swing / strike */ };
+/* PULSE (3) = the shot event: IMPACT_PULSE for the Hookshot / Longshot, OFF (one send) for the slingshot / bow */
+enum { OOT_RULE_NONE, OOT_RULE_SMOOTH, OOT_RULE_AIM, OOT_RULE_PULSE, OOT_RULE_HOOK, OOT_RULE_SPELL, OOT_RULE_HAMMER, OOT_RULE_QUAKE };
+
+typedef struct OotTrigCfg {
+    float sling;
+    float bow;
+    float hook;
+    float din;
+    float hook_pulse;
+    int deep_fire;
+    float deep_at;
+    float hammer;
+    float rumble_on;
+    float hammer_hit;
+    float hammer_pulse;
+    float quake;
+    int hook_cancel;
+    int cancel_after_ms;
+    float rumble_off;
+} OotTrigCfg;
+
+typedef struct OotTrigState {
+    int sel;                 /* the item that counts (held >= OOT_TRIG_SEL_HOLD_NS), -1 none / unknown */
+    int cand;                /* what ZR shows now, and since when */
+    int64_t cand_ns;
+    int64_t last_arrows, last_seeds;   /* -1 not known */
+    int last_verb;
+    int latched;             /* deep fire: ZR is held let go for the game until R2 comes back under DEEP_FREE */
+    int analog_seen;         /* this pull went through LO..HI (a real analog trigger) */
+    int last_sent;           /* sustained preset id (TENSION, TWO_STAGE, ENGINE_ROUGH, HEAVY_LOAD) R2 was last sent, -1 none */
+    int64_t rumble_low_ns;   /* since when the game's rumble is under RUMBLE_OFF, -1 not */
+    int hammer_hit;          /* this swing has struck (the game's rumble passed HAMMER_HIT) */
+    float hammer_peak;       /* the strongest game rumble of this strike */
+    int prev_zr;             /* the pad's ZR bit last call */
+    int64_t zr_since_ns;     /* when it went on, -1 off */
+    int pull_deep;           /* this ZR press reached the deep squeeze */
+    int cancel_phase;        /* 0 none, 1 ZR + B forced, 2 ZR forced */
+    int64_t cancel_ns;       /* when the chain began */
+    int rumble_active;       /* the game's rumble is on (with hysteresis) */
+    int din_rumbled;         /* this Din cast has had the game's rumble on */
+} OotTrigState;
+
+#define OOT_TRIG_STATE_INIT {-1, -1, 0, -1, -1, -1, 0, 0, -1, -1, 0, 0.0f, 0, -1, 0, 0, 0, 0, 0}
+
+typedef struct OotTrigIn {
+    int64_t now_ns;
+    int sel;                 /* player +0x7D0 as read, -1 when unreadable or empty (0xffffffff) */
+    int64_t arrows, seeds;   /* -1 unreadable */
+    int verb;                /* -1 unreadable */
+    float depth;             /* R2 pull 0..1 */
+    int menu_open;
+    int64_t last_ocarina_ns;
+    int zr_raw;              /* the pad's own ZR bit (before deep fire clears it) */
+    float rumble;            /* the game's rumble amplitude 0..1 (rh_game_rumble_amp) */
+} OotTrigIn;
+
+typedef struct OotTrigOut {
+    int send_l;
+    uint8_t id_l;
+    float level_l;
+    int send_r;
+    uint8_t id_r;
+    float level_r;
+    int rule;                /* OOT_RULE_* */
+    int sel;                 /* the item that counts */
+    int64_t ammo;            /* its ammo, -1 when it has none / unreadable */
+    int clear_zr;            /* deep fire: the game must see ZR let go */
+    int force_zr, force_b;   /* cancel chain: the game must see ZR / B held */
+} OotTrigOut;
+
+static inline float oot_trig_clamp01(float v) {
+    return v < 0.0f ? 0.0f : (v > 1.0f ? 1.0f : v);
+}
+
+static inline OotTrigOut oot_trigger_rules(OotTrigState *st, const OotTrigCfg *cfg, const OotTrigIn *in) {
+    OotTrigOut out = {0, 0, 0.0f, 0, 0, 0.0f, OOT_RULE_NONE, -1, -1, 0, 0, 0};
+    const int64_t now = in->now_ns;
+
+    /* The item on ZR counts only after it held 80 ms: a quick change of item must not make the trigger click gears. */
+    if (in->sel == st->sel) st->cand = in->sel, st->cand_ns = now;
+    else if (in->sel != st->cand) st->cand = in->sel, st->cand_ns = now;
+    else if (now - st->cand_ns >= OOT_TRIG_SEL_HOLD_NS) st->sel = in->sel;
+    const int sel = st->sel;
+    const int is_sling = sel == OOT_SEL_SLING,
+              is_bow = sel == OOT_SEL_BOW || sel == OOT_SEL_ARROW_FIRE || sel == OOT_SEL_ARROW_ICE || sel == OOT_SEL_ARROW_LIGHT;
+    const int is_hook = sel == OOT_SEL_HOOK || sel == OOT_SEL_LONGSHOT;
+    const int64_t ammo = is_sling ? in->seeds : is_bow ? in->arrows : -1;
+    out.sel = sel;
+    out.ammo = ammo;
+
+    /* What happened since the last call (the memory is kept whatever wins below, so a menu never fakes a shot). */
+    const int shot = (is_sling && st->last_seeds >= 0 && in->seeds >= 0 && in->seeds < st->last_seeds) ||
+                     (is_bow && st->last_arrows >= 0 && in->arrows >= 0 && in->arrows < st->last_arrows) ||
+                     (is_hook && in->verb == OOT_VERB_HOOK_SHOOT && st->last_verb != OOT_VERB_HOOK_SHOOT);
+    st->last_seeds = in->seeds, st->last_arrows = in->arrows, st->last_verb = in->verb;
+    const int pulled = in->depth > OOT_TRIG_PULL_MIN;
+    if (in->depth <= OOT_TRIG_PULL_MIN) st->analog_seen = 0;
+    else if (in->depth >= OOT_TRIG_ANALOG_LO && in->depth <= OOT_TRIG_ANALOG_HI) st->analog_seen = 1;
+
+    const int hammer_swing = sel == OOT_SEL_HAMMER && in->verb == OOT_VERB_HAMMER;
+    if (!hammer_swing) st->hammer_hit = 0, st->hammer_peak = 0.0f;   /* a new swing starts clean */
+    const int is_din = sel == OOT_SEL_DIN && in->verb == OOT_VERB_DIN_CAST;
+    /* The game's rumble, on from RUMBLE_ON, off after 100 ms under RUMBLE_OFF (the real numbers are small and jumpy). */
+    if (in->rumble >= cfg->rumble_on) st->rumble_active = 1, st->rumble_low_ns = -1;
+    else if (st->rumble_active && in->rumble < cfg->rumble_off) {
+        if (st->rumble_low_ns < 0) st->rumble_low_ns = now;
+        if (now - st->rumble_low_ns >= OOT_TRIG_RUMBLE_OFF_NS) st->rumble_active = 0, st->rumble_low_ns = -1;
+    } else st->rumble_low_ns = -1;
+    if (!is_din) st->din_rumbled = 0;
+    else if (st->rumble_active) st->din_rumbled = 1;
+
+    /* The pad's ZR press: when it began, and whether it reached the deep squeeze (cancel needs a press that did not). */
+    if (in->zr_raw && !st->prev_zr) st->zr_since_ns = now, st->pull_deep = 0, st->cancel_phase = 0;   /* (pressed again: chain over) */
+    const int zr_released = !in->zr_raw && st->prev_zr;
+    st->prev_zr = in->zr_raw;
+    if (st->latched) st->pull_deep = 1;
+    const int64_t zr_held_ns = st->zr_since_ns >= 0 ? now - st->zr_since_ns : 0;
+    if (st->cancel_phase && (!is_hook || in->menu_open)) st->cancel_phase = 0;
+
+    /* Pause menu or Ocarina sound: both triggers smooth Off, whatever else. */
+    if (in->menu_open || (in->last_ocarina_ns > 0 && now >= in->last_ocarina_ns &&
+                          (now - in->last_ocarina_ns) <= OOT_TRIG_AUDIO_QUIET_NS)) {
+        out.rule = OOT_RULE_SMOOTH;
+        out.send_r = out.send_l = 1;
+        out.id_r = out.id_l = RENHDRUM_TRIG_OFF;
+        st->latched = 0;   /* (no button change in a menu) */
+        return out;
+    }
+
+    /* Deep fire (Hookshot / Longshot only): R2 squeezed past the notch (after a real analog pull) -> the game sees ZR let
+       go and fires while the finger is still down; kept let go until the pad's ZR bit is off. The slingshot and bow
+       fire when R2 is let go, as in the game. */
+    if (st->latched && !in->zr_raw) st->latched = 0;
+    if (!st->latched && cfg->deep_fire && st->analog_seen && in->depth >= cfg->deep_at && is_hook)
+        st->latched = 1;
+    out.clear_zr = st->latched;
+
+    /* Cancel: ZR held a while on the Hookshot / Longshot, never squeezed deep, then let go -> the game is told ZR is still held
+       and B is pressed for 100 ms (Link lowers the hookshot), B let go for 50 ms, then the real buttons. */
+    if (cfg->hook_cancel && cfg->deep_fire && is_hook && !st->cancel_phase && zr_released && !st->pull_deep && !st->latched &&
+        zr_held_ns >= (int64_t)cfg->cancel_after_ms * 1000000LL)
+        st->cancel_phase = 1, st->cancel_ns = now, st->zr_since_ns = -1;
+    if (st->cancel_phase) {
+        const int64_t dt = now - st->cancel_ns;
+        if (dt >= OOT_TRIG_CANCEL_END_NS) st->cancel_phase = 0;
+        else out.force_zr = 1, out.force_b = dt < OOT_TRIG_CANCEL_B_NS;
+        if (st->cancel_phase) st->cancel_phase = out.force_b ? 1 : 2;
+    }
+
+    /* A shot (ammo down, or the hookshot flying), even if R2 is already let go. Hookshot / Longshot: one release pulse.
+       Slingshot / bow: one OFF, so layer 1 (the game's rumble) takes the trigger for the release. */
+    if (shot) {
+        out.rule = OOT_RULE_PULSE;
+        out.send_r = 1;
+        if (is_hook) {
+            out.id_r = RENHDRUM_TRIG_IMPACT_PULSE;
+            out.level_r = oot_trig_clamp01(cfg->hook_pulse);
+        } else {
+            out.id_r = RENHDRUM_TRIG_OFF;
+        }
+        return out;
+    }
+
+    /* Not pulled (let go): nothing, the core releases after its own 500 ms. Empty ammo or an unknown item: nothing. */
+    if (!pulled || st->latched) return out;   /* (latched = already fired: only the pulse above) */
+    if (is_sling || is_bow) {
+        if (ammo <= 0) return out;
+        /* The force climbs with how deep R2 goes (the core's TENSION zones), not with time. */
+        out.rule = OOT_RULE_AIM;
+        out.send_r = 1;
+        out.id_r = RENHDRUM_TRIG_TENSION;
+        out.level_r = oot_trig_clamp01(is_sling ? cfg->sling : cfg->bow);
+    }
+    if (is_hook) {   /* the notch that says "aiming"; squeezing through it fires (latch above) */
+        out.rule = OOT_RULE_HOOK;
+        out.send_r = 1;
+        out.id_r = RENHDRUM_TRIG_TWO_STAGE;
+        out.level_r = oot_trig_clamp01(cfg->hook);
+    } else if (hammer_swing) {
+        if (!st->hammer_hit && in->rumble >= cfg->hammer_hit) st->hammer_hit = 1, st->hammer_peak = in->rumble, out.rule = OOT_RULE_PULSE,
+            out.send_r = 1, out.id_r = RENHDRUM_TRIG_IMPACT_PULSE, out.level_r = oot_trig_clamp01(cfg->hammer_pulse);   /* the strike */
+        else if (!st->hammer_hit) {   /* heavy like lifting the hammer, until the strike */
+            out.rule = OOT_RULE_HAMMER;
+            out.send_r = 1;
+            out.id_r = RENHDRUM_TRIG_HEAVY_LOAD;
+            out.level_r = oot_trig_clamp01(cfg->hammer);
+        } else if (st->rumble_active) {   /* the quake spreading out follows the game's rumble; it never goes back to HEAVY_LOAD */
+            if (in->rumble > st->hammer_peak) st->hammer_peak = in->rumble;
+            out.rule = OOT_RULE_QUAKE;
+            out.send_r = 1;
+            out.id_r = RENHDRUM_TRIG_ENGINE_ROUGH;
+            const float share = st->hammer_peak > 0.0f ? oot_trig_clamp01(in->rumble / st->hammer_peak) : 1.0f;
+            out.level_r = oot_trig_clamp01(cfg->quake * (share < OOT_TRIG_QUAKE_MIN ? OOT_TRIG_QUAKE_MIN : share));
+        }   /* (game rumble over: nothing -> one OFF) */
+    } else if (is_din && (!st->din_rumbled || st->rumble_active)) {   /* a small rough hum from the start of the cast until the game's rumble has come and gone */
+        out.rule = OOT_RULE_SPELL;
+        out.send_r = 1;
+        out.id_r = RENHDRUM_TRIG_ENGINE_ROUGH;
+        out.level_r = oot_trig_clamp01(cfg->din);
+    }
+    return out;
+}
+
+/* The rules above, plus: a sustained preset that was sent and is not reported this frame gets one OFF at once (not after the
+   core's 500 ms + soft release). Not after a pulse (it would cut it); a menu / Ocarina OFF already counts as released. */
+static inline OotTrigOut oot_trigger_eval(OotTrigState *st, const OotTrigCfg *cfg, const OotTrigIn *in) {
+    OotTrigOut out = oot_trigger_rules(st, cfg, in);
+    if (out.send_r) {
+        const int sustained = out.id_r == RENHDRUM_TRIG_TENSION || out.id_r == RENHDRUM_TRIG_TWO_STAGE ||
+                              out.id_r == RENHDRUM_TRIG_ENGINE_ROUGH || out.id_r == RENHDRUM_TRIG_HEAVY_LOAD;
+        st->last_sent = sustained ? (int)out.id_r : -1;
+    } else if (st->last_sent >= 0) {
+        out.send_r = 1, out.id_r = RENHDRUM_TRIG_OFF, out.level_r = 0.0f;
+        st->last_sent = -1;
+    }
+    return out;
+}
+
+#endif /* LONGSHOT_OOT_TRIGGER_H */
diff --git a/host/oot_trigprobe.c b/host/oot_trigprobe.c
new file mode 100644
index 00000000..7d5df597
--- /dev/null
+++ b/host/oot_trigprobe.c
@@ -0,0 +1,199 @@
+/* (longshot) Trigger probe for OoT (plan 143 6b): HOS_TRIG_PROBE=1 logs, only when a value changes, the signals that
+   might tell which item is on ZR and what Link is doing. Every line starts with "trigprobe:". Read-only: no game write,
+   no effect on the triggers. Called from hos_oot_trigger_frame (the controller read), so the reads are range-checked
+   (hos_guest_range) and may be a frame stale; this is a debug aid, not a rule.
+   Signals: Link's verb (the state id of the pointer chain host/oot_sprint.c reads), the camera's field of view, the arrow
+   and Deku seed counts, the u32 words at player +0x7c0..+0x7e0, and every Int / Enum / UInt / String64 flag that changed
+   between the pause menu opening and closing. A signal that cannot be read is said once, never guessed. */
+#include "hos.h"
+#include "oot_trigprobe.h"
+#include <math.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#ifndef LONGSHOT_ENV_H
+#include "../gpu/vk/compat/longshot_env.h"
+#endif
+
+int64_t hos_now_ns(void);
+unsigned hos_oot_menu_ticks(void);
+int hos_oot_gamedata_int(uint32_t hash, int64_t *v);
+uint32_t hos_oot_flag_hash(const char *name);
+int hos_oot_flag_text(uint32_t hash, char buf[64]);
+int hos_oot_flags_snapshot(uint32_t *key, uint32_t *val, char *kind, int cap);
+
+#define TP_ACTOR_MGR 0x84c9e0d0ULL     /* (host/oot_sprint.c's) the pointer to the actor manager pointer */
+#define TP_CAMERAS_SLOT 0x84ca6bc0ULL  /* (host/oot_state_tap.c's) the camera manager's holder */
+#define TP_FOV_AT 0x130                /* camera manager + this: the field of view in radians (a hint, to be confirmed) */
+#define TP_PLAYER_AT 0x7c0             /* player + this: the words that may name the item on ZR */
+#define TP_PLAYER_WORDS 9              /* +0x7c0 .. +0x7e0 */
+#define TP_MENU_QUIET_NS 150000000LL   /* the pause menu is closed this long after its last screen update */
+#define TP_FLAG_CAP 65536
+#define TP_SHOW 48                     /* changed flags logged per menu close */
+
+static uint64_t tp_u64(uint64_t a) {
+    const void *p = a >= 0x100000 ? hos_guest_range(a, 8) : NULL;
+    uint64_t v = 0;
+    if (p) memcpy(&v, p, 8);
+    return v;
+}
+static int tp_u32(uint64_t a, uint32_t *v) {
+    const void *p = a >= 0x100000 ? hos_guest_range(a, 4) : NULL;
+    if (p) memcpy(v, p, 4);
+    return p != NULL;
+}
+
+/* the controlled Link's actor (0 when not readable): actor manager +0x470 is the controlled one, its +0x18 the actor */
+static uint64_t tp_actor(void) {
+    const uint64_t mgr = tp_u64(tp_u64(g_module_base + TP_ACTOR_MGR));
+    const uint64_t ctl = mgr ? tp_u64(mgr + 0x470) : 0;
+    return ctl ? tp_u64(ctl + 0x18) : 0;
+}
+
+/* Link's actor, his player object ([[actor+0x270]+0x358]), the end of the verb's pointer chain and the verb itself (-1 when
+   not readable). Shared with host/oot_trigger.c (hos_oot_link_read), which needs them with the probe off. */
+static int32_t tp_link(uint64_t *actor_out, uint64_t *player_out, uint64_t *chain_out) {
+    int32_t verb = -1;
+    const uint64_t actor = tp_actor();
+    uint64_t p = actor ? tp_u64(actor + 0x270) : 0;
+    const uint64_t player = p ? tp_u64(p + 0x358) : 0;
+    if (p) p = tp_u64(p + 0x188);
+    if (p) p = tp_u64(p + 0x1c0);
+    uint32_t w;
+    if (p && tp_u32(p + 0x28, &w)) {
+        if (w == 0x11a && !tp_u32(p + 0x4c, &w)) w = (uint32_t)-1;
+        verb = (int32_t)w;
+    }
+    *actor_out = actor, *player_out = player, *chain_out = p;
+    return verb;
+}
+
+/* The trigger rules' read (plan 143 6c): Link's verb and the item on ZR (player +0x7d0), both -1 when not readable. */
+void hos_oot_link_read(int32_t *verb, int32_t *sel) {
+    uint64_t actor, player, chain;
+    uint32_t w;
+    *verb = tp_link(&actor, &player, &chain);
+    *sel = player && tp_u32(player + TP_PLAYER_AT + 0x10, &w) ? (int32_t)w : -1;
+}
+
+static void say_once(int *flag, const char *what) {
+    if (*flag) return;
+    *flag = 1;
+    hos_log("trigprobe: cannot read %s", what);
+}
+
+static int tp_enabled(void) {
+    static int v = -1;
+    if (v < 0) v = env_on("HOS_TRIG_PROBE");
+    return v;
+}
+
+static void tp_menu_edge(int open) {
+    static TpFlag *a, *b;
+    static TpChange *ch;
+    static uint32_t *key, *val;
+    static char *kind;
+    static int na, bad;
+    if (!a && !bad) {
+        a = malloc(sizeof *a * TP_FLAG_CAP), b = malloc(sizeof *b * TP_FLAG_CAP), ch = malloc(sizeof *ch * TP_FLAG_CAP);
+        key = malloc(sizeof *key * TP_FLAG_CAP), val = malloc(sizeof *val * TP_FLAG_CAP), kind = malloc(TP_FLAG_CAP);
+        if (!a || !b || !ch || !key || !val || !kind) bad = 1, a = NULL, hos_log("trigprobe: no memory for the flag snapshots");
+    }
+    if (bad) return;
+    const int n = hos_oot_flags_snapshot(key, val, kind, TP_FLAG_CAP);
+    TpFlag *to = open ? a : b;
+    for (int i = 0; i < n; i++) to[i] = (TpFlag){key[i], val[i], kind[i]};
+    if (open) {
+        na = n;
+        hos_log("trigprobe: pause menu opened (%d flags kept)", n);
+        return;
+    }
+    if (!na || !n) {
+        hos_log("trigprobe: pause menu closed; flags %s", n ? "had no snapshot at its opening" : "cannot be read");
+        return;
+    }
+    const int c = tp_diff(a, na, b, n, ch, TP_FLAG_CAP);
+    hos_log("trigprobe: pause menu closed: %d flags changed (%d / %d)", c, na, n);
+    for (int i = 0; i < c && i < TP_SHOW; i++) {
+        char t[64] = "";
+        if (ch[i].kind == 'T') hos_oot_flag_text(ch[i].key, t);
+        hos_log("trigprobe: flag 0x%08x %c %s%u -> %u%s%s%s", ch[i].key, ch[i].kind, ch[i].added ? "new " : "",
+                ch[i].old_val, ch[i].new_val, t[0] ? " \"" : "", t, t[0] ? "\"" : "");
+    }
+    if (c > TP_SHOW) hos_log("trigprobe: ... %d more changed flags not shown", c - TP_SHOW);
+}
+
+void hos_oot_trigprobe_frame(void) {
+    if (!tp_enabled()) return;
+    const int64_t now = hos_now_ns();
+    static int say_actor, say_verb, say_fov, say_ammo, say_player, started;
+    if (!started) {
+        started = 1;
+        hos_log("trigprobe: on (verb, fov, arrows, seeds, player+0x7c0.., pause-menu flag changes)");
+    }
+
+    /* the pause menu: open while its screens keep updating */
+    static unsigned last_ticks;
+    static int64_t last_tick_ns;
+    static int menu;
+    const unsigned ticks = hos_oot_menu_ticks();
+    if (ticks != last_ticks) last_ticks = ticks, last_tick_ns = now;
+    const int open = last_tick_ns && now - last_tick_ns < TP_MENU_QUIET_NS;
+    if (open != menu) menu = open, tp_menu_edge(open);
+
+    /* Link's verb: the state id at [[[actor +0x270] +0x188] +0x1c0] +0x28 (+0x4c when that reads 0x11a) */
+    static int32_t last_verb = -2;
+    uint64_t actor, player, p;
+    const int32_t verb = tp_link(&actor, &player, &p);
+    if (!actor) say_once(&say_actor, "Link's actor (no controlled Link yet)");
+    else if (verb < 0 && !p) say_once(&say_verb, "Link's verb (the pointer chain ends at 0)");
+    if (verb != last_verb) last_verb = verb, hos_log("trigprobe: verb=%d", verb);
+
+    /* the camera's field of view, degrees to one decimal */
+    static int last_fov = -2;
+    int fov = -1;
+    const uint64_t cams = tp_u64(tp_u64(g_module_base + TP_CAMERAS_SLOT));
+    uint32_t raw;
+    float f;
+    if (cams && tp_u32(cams + TP_FOV_AT, &raw)) {
+        memcpy(&f, &raw, 4);
+        if (isfinite(f) && f > 0.01f && f < 3.1f) fov = (int)lroundf(f * 57.29578f * 10.0f);
+        else if (actor && !say_fov) {   /* (before Link exists the manager is still empty: not worth saying) */
+            say_fov = 1;
+            hos_log("trigprobe: cannot read the field of view: camera manager +0x130 holds 0x%08x, not a radian angle", raw);
+        }
+    } else if (actor) say_once(&say_fov, "the field of view (no camera manager)");
+    if (fov != last_fov) {
+        last_fov = fov;
+        if (fov < 0) hos_log("trigprobe: fov=?");
+        else hos_log("trigprobe: fov=%d.%d", fov / 10, fov % 10);
+    }
+
+    /* arrows and Deku seeds */
+    static int64_t last_arrow = -2, last_seed = -2;
+    static uint32_t h_arrow, h_seed;
+    if (!h_arrow) h_arrow = hos_oot_flag_hash("PouchData.Item_Arrow_Normal.StockNum"),
+                  h_seed = hos_oot_flag_hash("PouchData.Item_DekuSeed.StockNum");
+    int64_t arrow = -1, seed = -1;
+    if (!hos_oot_gamedata_int(h_arrow, &arrow)) arrow = -1, say_once(&say_ammo, "an ammo count (flag not found in the game data)");
+    if (!hos_oot_gamedata_int(h_seed, &seed)) seed = -1;
+    if (arrow != last_arrow || seed != last_seed) {
+        last_arrow = arrow, last_seed = seed;
+        hos_log("trigprobe: arrows=%lld seeds=%lld", (long long)arrow, (long long)seed);
+    }
+
+    /* the player's words that may name the item on ZR */
+    static uint32_t last_words[TP_PLAYER_WORDS];
+    static int have_words;
+    uint32_t words[TP_PLAYER_WORDS];
+    int ok = player != 0;
+    for (int i = 0; ok && i < TP_PLAYER_WORDS; i++) ok = tp_u32(player + TP_PLAYER_AT + 4 * (uint64_t)i, &words[i]);
+    if (!ok) {
+        if (actor) say_once(&say_player, "player +0x7c0 (the pointer [[actor+0x270]+0x358] is not readable)");
+    } else if (!have_words || memcmp(words, last_words, sizeof words)) {
+        have_words = 1;
+        memcpy(last_words, words, sizeof words);
+        hos_log("trigprobe: player+0x7c0 %08x %08x %08x %08x %08x %08x %08x %08x %08x", words[0], words[1], words[2],
+                words[3], words[4], words[5], words[6], words[7], words[8]);
+    }
+}
diff --git a/host/oot_trigprobe.h b/host/oot_trigprobe.h
new file mode 100644
index 00000000..ea928f76
--- /dev/null
+++ b/host/oot_trigprobe.h
@@ -0,0 +1,32 @@
+/* (longshot) The pure part of the trigger probe (plan 143 6b): which game-data flags differ between two snapshots.
+   Header-only so host/oot_trigprobe.c and tests/test_oot_trigprobe.py share it without the game. */
+#ifndef LONGSHOT_OOT_TRIGPROBE_H
+#define LONGSHOT_OOT_TRIGPROBE_H
+
+#include <stdint.h>
+#include <stdlib.h>
+
+typedef struct TpFlag { uint32_t key, val; char kind; } TpFlag;
+typedef struct TpChange { uint32_t key, old_val, new_val; char kind; int added; } TpChange;
+
+static inline int tp_cmp(const void *a, const void *b) {
+    const uint32_t x = ((const TpFlag *)a)->key, y = ((const TpFlag *)b)->key;
+    return x < y ? -1 : x > y;
+}
+
+/* a and b are sorted in place; the flags of b that are new or hold another value than in a go to out (at most cap).
+   Returns how many went to out. */
+static inline int tp_diff(TpFlag *a, int na, TpFlag *b, int nb, TpChange *out, int cap) {
+    qsort(a, (size_t)na, sizeof *a, tp_cmp);
+    qsort(b, (size_t)nb, sizeof *b, tp_cmp);
+    int n = 0, i = 0;
+    for (int j = 0; j < nb && n < cap; j++) {
+        while (i < na && a[i].key < b[j].key) i++;
+        const int have = i < na && a[i].key == b[j].key;
+        if (have && a[i].val == b[j].val) continue;
+        out[n++] = (TpChange){b[j].key, have ? a[i].val : 0, b[j].val, b[j].kind, !have};
+    }
+    return n;
+}
+
+#endif /* LONGSHOT_OOT_TRIGPROBE_H */
