diff --git a/gpu/vk/menu/hd_rumble.cpp b/gpu/vk/menu/hd_rumble.cpp
new file mode 100644
index 00000000..866d275c
--- /dev/null
+++ b/gpu/vk/menu/hd_rumble.cpp
@@ -0,0 +1,283 @@
+// The Insert menu's HD Rumble settings page (gpu/vk/menu/hd_rumble.cpp): opens from the Controls tab's HD Rumble
+// settings row (after the HD Rumble switch) and edits the core RenHDrum 0.5.0 options through MkwVkHost::rh_option,
+// persisting to renhdrum.ini beside the game.
+#include "menu_module.h"
+#include "menu/hd_rumble.h"
+
+#ifndef MENU_LAYOUT_ONLY
+#include "vk_internal.h"
+#endif
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <initializer_list>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace mkwvk {
+
+namespace {
+
+struct RhRowDef {
+    const char* menu_key;
+    const char* opt_key;
+    const char* label;
+    const char* help;
+    menu::Kind kind;
+    int lo, hi, step, def;
+    int tier;
+    int link; // 0 any, 1 USB only, 2 Bluetooth only
+    std::initializer_list<const char*> choices;
+};
+
+constexpr RhRowDef kRhRows[] = {
+    // Basic (tier 0)
+    {"rh_switch_bt_mode", "switch_bt_mode", "Switch: Bluetooth mode",
+     "Detailed (5 ms): every detail, like wired. Compatible: works on every Bluetooth adapter; used automatically when Detailed cannot run.",
+     menu::Kind::Choice, 0, 1, 1, 0, 0, 2, {"Detailed (5 ms)", "Compatible"}},
+    {"rh_dualsense_haptics", "dualsense_haptics", "DualSense: Haptics",
+     "Rumble through the two haptic voice coils. Off: the standard rumble.",
+     menu::Kind::Toggle, 0, 1, 1, 1, 0, 0, {}},
+    {"rh_dualsense_hd_haptics", "dualsense_hd_haptics", "DualSense: HD Haptics",
+     "HD Rumble upgraded for DualSense. The controller speaker and the L2/R2 triggers react to the rumble. Off = standard HD Rumble.",
+     menu::Kind::Toggle, 0, 1, 1, 1, 0, 0, {}},
+    {"rh_dualsense_volume", "dualsense_volume", "DualSense: Strength",
+     "Lower it if the rumble feels too strong.",
+     menu::Kind::Slider, 10, 100, 5, 100, 0, 0, {}},
+    {"rh_xbox_enabled", "xbox_enabled", "HD Rumble on Xbox",
+     "The game's HD Rumble translated for the Xbox motors. Off: the standard rumble.",
+     menu::Kind::Toggle, 0, 1, 1, 1, 0, 0, {}},
+
+    // Advanced (tier 1)
+    {"rh_gain", "gain", "Intensity",
+     "Overall rumble strength.",
+     menu::Kind::Slider, 25, 1000, 5, 100, 1, 0, {}},
+    {"rh_low_boost", "low_boost", "Lift weak rumble",
+     "Makes faint rumble easier to feel.",
+     menu::Kind::Slider, 0, 100, 5, 0, 1, 0, {}},
+    {"rh_usb_no_queue", "usb_no_queue", "Switch USB: Send without queuing",
+     "Send Switch USB rumble packets immediately without waiting in a queue.",
+     menu::Kind::Toggle, 0, 1, 1, 1, 1, 1, {}},
+    {"rh_envelope_5ms", "envelope_5ms", "Switch USB: Detailed 5 ms rumble",
+     "Play 5 ms rumble detail over Switch USB.",
+     menu::Kind::Toggle, 0, 1, 1, 1, 1, 1, {}},
+    {"rh_frequency_in_packet", "frequency_in_packet", "Switch USB: Accurate pitch, low band",
+     "Keep accurate low-band pitch in Switch USB packets.",
+     menu::Kind::Toggle, 0, 1, 1, 1, 1, 1, {}},
+    {"rh_frequency_both_bands", "frequency_both_bands", "Switch USB: Accurate pitch, both bands",
+     "Keep accurate pitch on both bands in Switch USB packets.",
+     menu::Kind::Toggle, 0, 1, 1, 1, 1, 1, {}},
+    {"rh_crisp_notes", "crisp_notes", "Switch USB: Accent each note",
+     "Sharpen note onsets on Switch USB.",
+     menu::Kind::Toggle, 0, 1, 1, 1, 1, 1, {}},
+    {"rh_usb_interval_ms", "usb_interval_ms", "Switch USB: Send interval",
+     "Used only while Detailed 5 ms rumble is off.",
+     menu::Kind::Choice, 0, 3, 1, 1, 1, 1, {"10 ms", "15 ms", "20 ms", "30 ms"}},
+    {"rh_usb_auto_slow", "usb_auto_slow", "Switch USB: Slow down on heavy rumble",
+     "Ease Switch USB packet rate during heavy rumble.",
+     menu::Kind::Toggle, 0, 1, 1, 1, 1, 1, {}},
+    {"rh_bt_after_input", "bt_after_input", "Switch BT: Send between button reads",
+     "Send Switch Bluetooth rumble between controller input reads.",
+     menu::Kind::Toggle, 0, 1, 1, 1, 1, 2, {}},
+    {"rh_bt_crisp_notes", "bt_crisp_notes", "Switch BT: Accent each note",
+     "Sharpen note onsets on Switch Bluetooth.",
+     menu::Kind::Toggle, 0, 1, 1, 1, 1, 2, {}},
+    {"rh_dualsense_crisp_notes", "dualsense_crisp_notes", "DualSense: Accent each note",
+     "Sharpen note onsets on DualSense.",
+     menu::Kind::Toggle, 0, 1, 1, 1, 1, 0, {}},
+    {"rh_xbox_mode", "xbox_mode", "Xbox: Mode",
+     "RenHDrum: translated HD Rumble. Direct: direct motor mix with trigger rumble.",
+     menu::Kind::Choice, 0, 1, 1, 0, 1, 0, {"RenHDrum", "Direct"}},
+    {"rh_xbox_strength", "xbox_strength", "Xbox: Motor strength",
+     "100% = as the game sends it. Raise it if the rumble feels weak.",
+     menu::Kind::Slider, 0, 1000, 10, 100, 1, 0, {}},
+    {"rh_xbox_detail", "xbox_detail", "Xbox Direct: Detail on main motor",
+     "Used when Xbox Mode is Direct.",
+     menu::Kind::Slider, 0, 100, 5, 50, 1, 0, {}},
+    {"rh_xbox_accents", "xbox_accents", "Xbox Direct: Hit accents",
+     "Used when Xbox Mode is Direct.",
+     menu::Kind::Slider, 0, 100, 5, 50, 1, 0, {}},
+    {"rh_xbox_trigger_mix", "xbox_trigger_mix", "Xbox Direct: Trigger rumble",
+     "Used when Xbox Mode is Direct.",
+     menu::Kind::Slider, 0, 100, 5, 20, 1, 0, {}},
+};
+
+constexpr int kRhRowCount = (int)(sizeof kRhRows / sizeof kRhRows[0]);
+int rh_vals[kRhRowCount];
+bool rh_advanced_open = false;
+
+#ifndef MENU_LAYOUT_ONLY
+std::string rh_status_cached;
+constexpr const char* kRhStatusLongest = "Connected: DualSense (Bluetooth), HD Rumble (speaker + triggers)";
+
+bool can_rh_option() { return host && host->version >= 36 && host->rh_option != nullptr; }
+
+void rh_poll_status() {
+    if (!can_rh_option()) {
+        rh_status_cached = "Unavailable";
+        return;
+    }
+    char buf[256] = "";
+    host->rh_option(3, nullptr, 0, buf, (int)sizeof buf);
+    rh_status_cached = buf[0] ? buf : "Unavailable";
+}
+
+int rh_active_link() {
+    if (rh_status_cached.empty()) rh_poll_status();
+    if (rh_status_cached.find("(USB)") != std::string::npos) return 1;
+    if (rh_status_cached.find("(Bluetooth)") != std::string::npos) return 2;
+    return 0;
+}
+
+bool rh_link_matches(int link) {
+    if (link == 0) return true;
+    const int active = rh_active_link();
+    return active == 0 || active == link;
+}
+
+void rh_set_row(int idx, int v) {
+    if (!can_rh_option()) return;
+    host->rh_option(1, kRhRows[idx].opt_key, v, nullptr, 0);
+    rh_poll_status();
+    menu_redraw();
+}
+
+void rh_reset_all() {
+    if (!can_rh_option()) return;
+    host->rh_option(2, nullptr, 0, nullptr, 0);
+    refresh_hd_rumble();
+}
+
+std::string rh_status_text() {
+    rh_poll_status();
+    return rh_status_cached;
+}
+
+const char* hn_rh_status(int, int variant) {
+    if (variant == 0) return kRhStatusLongest;
+    if (variant > 0) return nullptr;
+    if (rh_status_cached.empty()) rh_poll_status();
+    return rh_status_cached.empty() ? nullptr : rh_status_cached.c_str();
+}
+#else
+bool rh_link_matches(int) { return true; }
+void rh_set_row(int, int) {}
+#endif
+
+void rh_toggle_advanced() {
+    rh_advanced_open = !rh_advanced_open;
+#ifndef MENU_LAYOUT_ONLY
+    menu_redraw();
+#endif
+}
+
+} // namespace
+
+void refresh_hd_rumble() {
+    for (int i = 0; i < kRhRowCount; i++) rh_vals[i] = kRhRows[i].def;
+#ifndef MENU_LAYOUT_ONLY
+    if (can_rh_option()) {
+        for (int i = 0; i < kRhRowCount; i++) {
+            const int v = host->rh_option(0, kRhRows[i].opt_key, 0, nullptr, 0);
+            if (v >= 0) rh_vals[i] = std::clamp(v, kRhRows[i].lo, kRhRows[i].hi);
+        }
+        rh_poll_status();
+    }
+    menu_redraw();
+#endif
+}
+
+MENU_MODULE(hd_rumble) {
+    for (int i = 0; i < kRhRowCount; i++) rh_vals[i] = kRhRows[i].def;
+
+    menu::tab("controls")
+        .row({.key = "@HD Rumble settings",
+              .label = "HD Rumble settings",
+              .help = "Configure RenHDrum HD Rumble per controller: Switch Pro, DualSense HD Haptics, Xbox and Advanced tuning.",
+              .kind = menu::Kind::Page,
+              .opens = "hd_rumble"}, menu::after("hd_rumble"));
+
+    auto b = menu::page("hd_rumble");
+    b.row({.key = "@hd_rumble_status",
+           .label = "Status",
+           .help = "Current controller and HD Rumble status from RenHDrum.",
+           .kind = menu::Kind::Action,
+           .text = MENU_HOOK([](int) { return rh_status_text(); }),
+           .hint = MENU_HOOK(hn_rh_status),
+           .on_activate = MENU_HOOK(refresh_hd_rumble),
+           .verb = "Refresh"});
+
+    b.heading("hd_basic", "Basic");
+    for (int i = 0; i < kRhRowCount; i++) {
+        if (kRhRows[i].tier != 0) continue;
+        const RhRowDef& d = kRhRows[i];
+        menu::Setting s;
+        s.key = d.menu_key;
+        s.label = d.label;
+        s.help = d.help;
+        s.kind = d.kind;
+        s.value = &rh_vals[i];
+        s.lo = d.lo;
+        s.hi = d.hi;
+        s.step = d.step;
+        s.preset_exempt = true;
+        if (d.choices.size() > 0) s.choices.assign(d.choices.begin(), d.choices.end());
+        if (d.kind == menu::Kind::Slider) s.text = menu_text::percent;
+        if (d.link != 0) {
+            const int link = d.link;
+            s.shown = [link] { return rh_link_matches(link); };
+        }
+        s.on_change = [i](int v) { rh_set_row(i, v); };
+        b.row(std::move(s));
+    }
+
+    b.heading("hd_advanced", "Advanced");
+    b.row({.key = "rh_advanced_toggle",
+           .label = "Advanced settings",
+           .help = "Show or hide advanced tuning options (intensity, weak rumble lift, Switch USB/Bluetooth timing, DualSense and Xbox Direct).",
+           .kind = menu::Kind::Action,
+           .text = [](int) { return std::string(rh_advanced_open ? "Hide" : "Show"); },
+           .on_activate = rh_toggle_advanced,
+           .verb = "Toggle"});
+
+    for (int i = 0; i < kRhRowCount; i++) {
+        if (kRhRows[i].tier != 1) continue;
+        const RhRowDef& d = kRhRows[i];
+        menu::Setting s;
+        s.key = d.menu_key;
+        s.label = d.label;
+        s.help = d.help;
+        s.kind = d.kind;
+        s.value = &rh_vals[i];
+        s.lo = d.lo;
+        s.hi = d.hi;
+        s.step = d.step;
+        s.preset_exempt = true;
+        if (d.choices.size() > 0) s.choices.assign(d.choices.begin(), d.choices.end());
+        if (d.kind == menu::Kind::Slider) s.text = menu_text::percent;
+        const int link = d.link;
+        s.shown = [link] { return rh_advanced_open && rh_link_matches(link); };
+        s.on_change = [i](int v) { rh_set_row(i, v); };
+        b.row(std::move(s));
+    }
+
+    b.heading("hd_renhdrum", "RenHDrum");
+    b.row({.key = "rh_reset",
+           .label = "Reset to recommended",
+           .help = "Resets every RenHDrum setting to the recommended values and saves renhdrum.ini.",
+           .kind = menu::Kind::Action,
+           .text = [](int) { return std::string("Reset"); },
+           .on_activate = MENU_HOOK(rh_reset_all),
+           .verb = "Reset"})
+     .row({.key = "rh_credit",
+           .label = "Powered by RenHDrum",
+           .help = "Powered by RenHDrum 0.5.0 (github.com/trzz1214/RenHDrum). Settings are saved to renhdrum.ini beside the game.",
+           .kind = menu::Kind::Action,
+           .text = [](int) { return std::string("Core 0.5.0"); },
+           .on_activate = nullptr,
+           .verb = "Info"});
+}
+
+} // namespace mkwvk
