+}}
+__declspec(dllexport) int32_t renhdrum_engine_push_half_sample(
+    void *e, int64_t now_us, bool is_right, float al, float fl, float ah, float fh) {{
+    (void)e; (void)now_us; (void)is_right; (void)fl; (void)fh;
+    InterlockedExchange(&g_emit_silent, (al == 0.0f && ah == 0.0f) ? 1 : 0);
