diff --git a/tests/test_oot_pad_light.py b/tests/test_oot_pad_light.py
new file mode 100644
index 00000000..f84be3e9
--- /dev/null
+++ b/tests/test_oot_pad_light.py
@@ -0,0 +1,135 @@
+"""DualSense lights and touchpad halves in OoT (host/oot_pad_light.h, plans 147 and 149): the light bar (a red flash on a
+hit, an orange breath at one heart or less), the microphone LED on a low battery, and a touchpad click's half -> the map or the bag.
+
+Compiles host/oot_pad_light.h as a small standalone C test without the game.
+
+python -I -B tests/test_oot_pad_light.py [--cc gcc]
+"""
+import argparse
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from compiler_command import compiler_command, parse_compiler  # noqa: E402
+
+RUN_ALL_ARGS = ["--cc", "{cc}"]
+ROOT = Path(__file__).resolve().parents[1]
+
+FIXTURE = r"""
+#include <assert.h>
+#include <stdio.h>
+#include "oot_pad_light.h"
+
+static const int64_t S = 1000000000LL, MS = 1000000LL;
+
+static int is(OotBar b, int r, int g, int bl) { return b.valid && b.r == r && b.g == g && b.b == bl; }
+
+int main(void) {
+    OotBarState st = OOT_BAR_STATE_INIT;
+    /* life not known: leave the bar alone */
+    assert(!oot_bar_color(&st, -1, 12, 0).valid && !oot_bar_color(&st, 12, 0, 0).valid);
+
+    /* full life, no event: the pad's own colour (SDL's player 1: 0, 0, 64) */
+    assert(is(oot_bar_color(&st, 12, 12, 1 * S), OOT_BAR_BASE_R, OOT_BAR_BASE_G, OOT_BAR_BASE_B));
+    assert(is(oot_bar_color(&st, 12, 12, 2 * S), 0, 0, 64));
+
+    /* a hit (12 -> 10): red for 150 ms, then back */
+    assert(is(oot_bar_color(&st, 10, 12, 3 * S), 255, 0, 0));
+    assert(is(oot_bar_color(&st, 10, 12, 3 * S + 149 * MS), 255, 0, 0));
+    assert(is(oot_bar_color(&st, 10, 12, 3 * S + 150 * MS), 0, 0, 64));
+
+    /* a second hit 300 ms after the first began (flash ended 150 ms ago, under the 350 ms gap): no flash */
+    assert(is(oot_bar_color(&st, 8, 12, 3 * S + 300 * MS), 0, 0, 64));
+    /* a hit 500 ms after the first began: flash */
+    assert(is(oot_bar_color(&st, 6, 12, 3 * S + 500 * MS), 255, 0, 0));
+
+    /* at most 2 flashes a second, whatever the hits: count the flash starts over 10 s of a hit every 100 ms */
+    {
+        OotBarState s2 = OOT_BAR_STATE_INIT;
+        int flashes = 0, was = 0;
+        int64_t life = 400;
+        (void)oot_bar_color(&s2, life, 400, 0);
+        for (int64_t t = 0; t < 10 * S; t += 10 * MS) {
+            if (t % (100 * MS) == 0 && life > 5) life--;
+            const int red = oot_bar_color(&s2, life, 400, t + MS).r == 255;
+            flashes += red && !was;
+            was = red;
+        }
+        assert(flashes <= 20 && flashes >= 15);
+    }
+
+    /* healing is no hit; a refill then a hit is */
+    st = (OotBarState)OOT_BAR_STATE_INIT;
+    (void)oot_bar_color(&st, 8, 12, 0);
+    assert(is(oot_bar_color(&st, 10, 12, 10 * S), 0, 0, 64));
+    assert(is(oot_bar_color(&st, 9, 12, 11 * S), 255, 0, 0));
+
+    /* a hit that kills (life 0): no flash, the bar goes back to the base */
+    st = (OotBarState)OOT_BAR_STATE_INIT;
+    (void)oot_bar_color(&st, 2, 12, 0);
+    assert(is(oot_bar_color(&st, 0, 12, 1 * S), 0, 0, 64));
+
+    /* one heart or less (1..4): the orange breath, 1 s a cycle: dim 15 % at the start, full at half a cycle */
+    st = (OotBarState)OOT_BAR_STATE_INIT;
+    (void)oot_bar_color(&st, 4, 12, 0);
+    OotBar b = oot_bar_color(&st, 4, 12, 20 * S);              /* t = 0: 0.15 */
+    assert(b.valid && b.r == 38 && b.g == 10 && b.b == 0);     /* 255 * 0.15 = 38.25, 64 * 0.15 = 9.6 */
+    b = oot_bar_color(&st, 4, 12, 20 * S + S / 2);             /* t = 0.5: 1.0 */
+    assert(is(b, 255, 64, 0));
+    b = oot_bar_color(&st, 4, 12, 21 * S);                     /* a whole cycle on: the same as t = 0 */
+    assert(b.r == 38 && b.g == 10);
+    b = oot_bar_color(&st, 4, 12, 21 * S + S / 4);             /* t = 0.25: 0.15 + 0.85 * 0.5 = 0.575 */
+    assert(b.r == 147 && b.g == 37 && b.b == 0);
+    assert(oot_bar_color(&st, 1, 80, 22 * S + S / 2).r == 255);   /* a quarter of 20 hearts: low too */
+    b = oot_bar_color(&st, 5, 12, 24 * S);                     /* a heart and a quarter: not low */
+    assert(is(b, 0, 0, 64));
+
+    /* a hit over the breath: red wins, then the breath again */
+    st = (OotBarState)OOT_BAR_STATE_INIT;
+    (void)oot_bar_color(&st, 4, 12, 0);
+    assert(is(oot_bar_color(&st, 3, 12, 30 * S + S / 2), 255, 0, 0));
+    b = oot_bar_color(&st, 3, 12, 30 * S + S / 2 + 200 * MS);
+    assert(b.r != 255 || b.g != 0);                            /* the breath (orange), not the flash */
+
+    /* the microphone LED: breathing at 20 % or less on a battery, off above 25 %, charging / wired / unknown: off, a band between */
+    assert(oot_mic_mode(1, 20, 0) == 2 && oot_mic_mode(1, 5, 0) == 2 && oot_mic_mode(1, 0, 0) == 2);
+    assert(oot_mic_mode(1, 21, 0) == 0 && oot_mic_mode(1, 25, 0) == 0);   /* (rising: the band keeps what it was) */
+    assert(oot_mic_mode(1, 22, 2) == 2 && oot_mic_mode(1, 25, 2) == 2);
+    assert(oot_mic_mode(1, 26, 2) == 0 && oot_mic_mode(1, 90, 2) == 0);
+    assert(oot_mic_mode(3, 10, 2) == 0 && oot_mic_mode(4, 100, 2) == 0 && oot_mic_mode(2, -1, 2) == 0);   /* charging, charged, no battery */
+    assert(oot_mic_mode(0, 10, 2) == 0 && oot_mic_mode(-1, 10, 2) == 0 && oot_mic_mode(1, -1, 2) == 0);   /* unknown, error */
+
+    /* the touchpad: left half = the map, right half = the bag, the middle goes right */
+    assert(oot_touch_zone(0.0f) == OOT_ZONE_MAP && oot_touch_zone(0.49f) == OOT_ZONE_MAP);
+    assert(oot_touch_zone(0.5f) == OOT_ZONE_BAG && oot_touch_zone(0.51f) == OOT_ZONE_BAG && oot_touch_zone(1.0f) == OOT_ZONE_BAG);
+
+    puts("PASS: oot_pad_light rules");
+    return 0;
+}
+"""
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--cc", default=None)
+    args = parser.parse_args()
+    cc = parse_compiler(args.cc) if args.cc else compiler_command("CC", "gcc", "clang")
+    flags = subprocess.CREATE_NO_WINDOW | subprocess.BELOW_NORMAL_PRIORITY_CLASS if os.name == "nt" else 0
+    with tempfile.TemporaryDirectory(prefix="oot-pad-light-") as tmp:
+        src = Path(tmp) / "t.c"
+        exe = Path(tmp) / "t.exe"
+        src.write_text(FIXTURE, encoding="utf-8")
+        subprocess.run(
+            cc + ["-std=c11", "-O2", "-Wall", "-Wextra", "-Werror", "-I", str(ROOT / "host"), str(src), "-o", str(exe)],
+            check=True,
+            creationflags=flags,
+            timeout=60,
+        )
+        subprocess.run([str(exe)], check=True, creationflags=flags, timeout=30)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_oot_trigger.py b/tests/test_oot_trigger.py
new file mode 100644
index 00000000..2f49356d
--- /dev/null
+++ b/tests/test_oot_trigger.py
@@ -0,0 +1,542 @@
+"""OoT adaptive trigger preset rules (host/oot_trigger.h, plan 143 6c): item on ZR, ammo ramp, shot pulse, hookshot, menu/audio Off.
+
+Compiles host/oot_trigger.h as a small standalone C test without the game.
+
+python -I -B tests/test_oot_trigger.py [--cc gcc]
+"""
+import argparse
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from compiler_command import compiler_command, parse_compiler  # noqa: E402
+
+RUN_ALL_ARGS = ["--cc", "{cc}"]
+ROOT = Path(__file__).resolve().parents[1]
+
+FIXTURE = r"""
+#include <assert.h>
+#include <math.h>
+#include <stdio.h>
+#include "oot_trigger.h"
+
+static int nearf(float a, float b) { return fabsf(a - b) < 1e-4f; }
+static const int64_t MS = 1000000LL;
+static const OotTrigCfg cfg = {
+    OOT_TRIG_SLING_DEFAULT, OOT_TRIG_BOW_DEFAULT, OOT_TRIG_HOOK_DEFAULT, OOT_TRIG_DIN_DEFAULT, OOT_TRIG_HOOK_PULSE_DEFAULT,
+    1, OOT_TRIG_DEEP_AT_DEFAULT, OOT_TRIG_HAMMER_DEFAULT,
+    OOT_TRIG_RUMBLE_ON_DEFAULT, OOT_TRIG_HAMMER_HIT_DEFAULT, OOT_TRIG_HAMMER_PULSE_DEFAULT, OOT_TRIG_QUAKE_DEFAULT,
+    1, OOT_TRIG_CANCEL_AFTER_MS_DEFAULT, OOT_TRIG_RUMBLE_OFF_DEFAULT,
+};
+static const OotTrigCfg cfg_nodeep = {
+    OOT_TRIG_SLING_DEFAULT, OOT_TRIG_BOW_DEFAULT, OOT_TRIG_HOOK_DEFAULT, OOT_TRIG_DIN_DEFAULT, OOT_TRIG_HOOK_PULSE_DEFAULT,
+    0, OOT_TRIG_DEEP_AT_DEFAULT, OOT_TRIG_HAMMER_DEFAULT,
+    OOT_TRIG_RUMBLE_ON_DEFAULT, OOT_TRIG_HAMMER_HIT_DEFAULT, OOT_TRIG_HAMMER_PULSE_DEFAULT, OOT_TRIG_QUAKE_DEFAULT,
+    1, OOT_TRIG_CANCEL_AFTER_MS_DEFAULT, OOT_TRIG_RUMBLE_OFF_DEFAULT,
+};
+
+static OotTrigIn mk(int64_t t_ms, int sel, int64_t arrows, int64_t seeds, int verb, float depth) {
+    OotTrigIn in = {t_ms * MS, sel, arrows, seeds, verb, depth, 0, 0, depth >= 0.25f, 0.0f};   /* the pad's ZR bit: on from R2 0.25 */
+    return in;
+}
+static OotTrigIn mkr(int64_t t_ms, int sel, int verb, float depth, float rumble) {
+    OotTrigIn in = mk(t_ms, sel, 0, 0, verb, depth);
+    in.rumble = rumble;
+    return in;
+}
+static OotTrigOut ev(OotTrigState *st, OotTrigIn in) { return oot_trigger_eval(st, &cfg, &in); }
+/* three calls 50 ms apart with R2 let go: the item has held >= 80 ms, so it counts */
+static void settle(OotTrigState *st, int64_t *t, int sel, int64_t arrows, int64_t seeds) {
+    for (int i = 0; i < 3; i++) { ev(st, mk(*t, sel, arrows, seeds, 40, 0.0f)); *t += 50; }
+}
+
+int main(void) {
+    OotTrigState st = OOT_TRIG_STATE_INIT;
+    int64_t t = 1000;
+    OotTrigOut o;
+
+    /* Unknown / unreadable item (-1), Boomerang, a strange item: R2 pulled -> nothing (layer 1) */
+    settle(&st, &t, -1, 5, 5);
+    o = ev(&st, mk(t, -1, 5, 5, 40, 0.9f));
+    assert(!o.send_l && !o.send_r && o.rule == OOT_RULE_NONE);
+    settle(&st, &t, OOT_SEL_BOOMERANG, 5, 5);
+    o = ev(&st, mk(t, OOT_SEL_BOOMERANG, 5, 5, 40, 0.9f));
+    assert(!o.send_r && o.rule == OOT_RULE_NONE && o.sel == OOT_SEL_BOOMERANG);
+    settle(&st, &t, 0x77, 5, 5);
+    o = ev(&st, mk(t, 0x77, 5, 5, 40, 0.9f));
+    assert(!o.send_r);
+
+    /* Slingshot, seeds 28: R2 under 3 % -> nothing; pulled -> TENSION 0.5 at once, whatever the time or depth */
+    settle(&st, &t, OOT_SEL_SLING, 7, 28);
+    o = ev(&st, mk(t, OOT_SEL_SLING, 7, 28, 40, 0.02f));
+    assert(!o.send_r && !o.send_l);
+    t += 100;
+    o = ev(&st, mk(t, OOT_SEL_SLING, 7, 28, 40, 0.1f));
+    assert(o.send_r && o.id_r == RENHDRUM_TRIG_TENSION && nearf(o.level_r, 0.5f) && o.rule == OOT_RULE_AIM && !o.send_l);
+    assert(o.ammo == 28);
+    o = ev(&st, mk(t + 500, OOT_SEL_SLING, 7, 28, 40, 0.5f));
+    assert(o.id_r == RENHDRUM_TRIG_TENSION && nearf(o.level_r, 0.5f));
+    o = ev(&st, mk(t + 3000, OOT_SEL_SLING, 7, 28, 40, 0.9f));
+    assert(nearf(o.level_r, 0.5f));
+
+    /* Seeds 28 -> 27: one OFF (no pulse) even though R2 is already let go; the next frame nothing */
+    o = ev(&st, mk(t + 3016, OOT_SEL_SLING, 7, 27, 40, 0.0f));
+    assert(o.send_r && o.id_r == RENHDRUM_TRIG_OFF && o.rule == OOT_RULE_PULSE && !o.send_l && !o.clear_zr);
+    o = ev(&st, mk(t + 3032, OOT_SEL_SLING, 7, 27, 40, 0.0f));
+    assert(!o.send_r && o.rule == OOT_RULE_NONE);
+    /* arrows moving is no shot for the slingshot; seeds going up (a pickup) is none either */
+    o = ev(&st, mk(t + 3048, OOT_SEL_SLING, 3, 27, 40, 0.0f));
+    assert(!o.send_r);
+    o = ev(&st, mk(t + 3064, OOT_SEL_SLING, 3, 30, 40, 0.0f));
+    assert(!o.send_r);
+    t += 4000;
+
+    t += 4000;
+
+    /* Bow, arrows 7: TENSION 0.75; arrows 0: no TENSION (smooth), but the shot that emptied it still sends OFF */
+    settle(&st, &t, OOT_SEL_BOW, 7, 30);
+    o = ev(&st, mk(t, OOT_SEL_BOW, 7, 30, 40, 0.5f));
+    assert(o.id_r == RENHDRUM_TRIG_TENSION && nearf(o.level_r, 0.75f) && o.ammo == 7);
+    o = ev(&st, mk(t + 1000, OOT_SEL_BOW, 7, 30, 40, 0.5f));
+    assert(nearf(o.level_r, 0.75f));
+    o = ev(&st, mk(t + 1016, OOT_SEL_BOW, 0, 30, 40, 0.0f));
+    assert(o.rule == OOT_RULE_PULSE && o.id_r == RENHDRUM_TRIG_OFF);
+    o = ev(&st, mk(t + 1032, OOT_SEL_BOW, 0, 30, 40, 0.8f));
+    assert(!o.send_r && o.rule == OOT_RULE_NONE && o.ammo == 0);
+    t += 2000;
+
+    /* Hookshot / Longshot: TWO_STAGE 0.6 while held; verb turning to 5 -> pulse once; verb staying 5 -> nothing more */
+    settle(&st, &t, OOT_SEL_HOOK, 0, 0);
+    o = ev(&st, mk(t, OOT_SEL_HOOK, 0, 0, 40, 0.01f));
+    assert(!o.send_r);
+    o = ev(&st, mk(t + 16, OOT_SEL_HOOK, 0, 0, 40, 0.6f));
+    assert(o.id_r == RENHDRUM_TRIG_TWO_STAGE && nearf(o.level_r, 0.6f) && !o.send_l && o.rule == OOT_RULE_HOOK);
+    o = ev(&st, mk(t + 32, OOT_SEL_HOOK, 0, 0, OOT_VERB_HOOK_SHOOT, 1.0f));
+    assert(o.id_r == RENHDRUM_TRIG_IMPACT_PULSE && o.rule == OOT_RULE_PULSE && nearf(o.level_r, 1.0f));
+    o = ev(&st, mk(t + 48, OOT_SEL_HOOK, 0, 0, OOT_VERB_HOOK_SHOOT, 1.0f));
+    assert(!o.send_r);
+    t += 500;
+    settle(&st, &t, OOT_SEL_LONGSHOT, 0, 0);
+    o = ev(&st, mk(t, OOT_SEL_LONGSHOT, 0, 0, 40, 0.6f));
+    assert(o.id_r == RENHDRUM_TRIG_TWO_STAGE);
+    o = ev(&st, mk(t + 16, OOT_SEL_LONGSHOT, 0, 0, OOT_VERB_HOOK_SHOOT, 0.6f));
+    assert(o.id_r == RENHDRUM_TRIG_IMPACT_PULSE);
+    /* verb 5 with a bow on ZR is not a shot */
+    settle(&st, &t, OOT_SEL_BOW, 7, 30);
+    o = ev(&st, mk(t, OOT_SEL_BOW, 7, 30, OOT_VERB_HOOK_SHOOT, 0.0f));
+    assert(!o.send_r);
+
+    /* Debounce: a new item counts only after 80 ms; a flick of 60 ms changes nothing */
+    settle(&st, &t, OOT_SEL_BOW, 7, 30);
+    o = ev(&st, mk(t, OOT_SEL_SLING, 7, 30, 40, 0.5f));
+    assert(o.sel == OOT_SEL_BOW && o.id_r == RENHDRUM_TRIG_TENSION);
+    o = ev(&st, mk(t + 60, OOT_SEL_BOW, 7, 30, 40, 0.5f));
+    assert(o.sel == OOT_SEL_BOW);
+    o = ev(&st, mk(t + 70, OOT_SEL_SLING, 7, 30, 40, 0.5f));
+    o = ev(&st, mk(t + 140, OOT_SEL_SLING, 7, 30, 40, 0.5f));
+    assert(o.sel == OOT_SEL_BOW);
+    o = ev(&st, mk(t + 150, OOT_SEL_SLING, 7, 30, 40, 0.5f));
+    assert(o.sel == OOT_SEL_SLING);
+    t += 5000;
+
+    /* Pause menu and Ocarina sound (<= 300 ms): both OFF, beat everything; an arrow used inside the menu is no shot */
+    settle(&st, &t, OOT_SEL_BOW, 7, 30);
+    OotTrigIn in = mk(t, OOT_SEL_BOW, 7, 30, 40, 0.9f);
+    in.menu_open = 1;
+    o = oot_trigger_eval(&st, &cfg, &in);
+    assert(o.send_l && o.id_l == RENHDRUM_TRIG_OFF && o.send_r && o.id_r == RENHDRUM_TRIG_OFF && o.rule == OOT_RULE_SMOOTH);
+    in = mk(t + 16, OOT_SEL_BOW, 6, 30, 40, 0.9f);
+    in.menu_open = 1;
+    o = oot_trigger_eval(&st, &cfg, &in);
+    assert(o.id_r == RENHDRUM_TRIG_OFF);
+    in = mk(t + 32, OOT_SEL_BOW, 6, 30, 40, 0.9f);
+    o = oot_trigger_eval(&st, &cfg, &in);
+    assert(o.id_r == RENHDRUM_TRIG_TENSION);
+    in = mk(t + 1000, OOT_SEL_BOW, 6, 30, 40, 0.9f);
+    in.last_ocarina_ns = (t + 900) * MS;
+    o = oot_trigger_eval(&st, &cfg, &in);
+    assert(o.id_l == RENHDRUM_TRIG_OFF && o.id_r == RENHDRUM_TRIG_OFF && o.send_l && o.send_r);
+    in.last_ocarina_ns = (t + 1000) * MS - 300 * MS;   /* exactly 300 ms: still quiet */
+    o = oot_trigger_eval(&st, &cfg, &in);
+    assert(o.id_r == RENHDRUM_TRIG_OFF);
+    in.last_ocarina_ns = (t + 1000) * MS - 301 * MS;
+    o = oot_trigger_eval(&st, &cfg, &in);
+    assert(o.id_r == RENHDRUM_TRIG_TENSION);
+
+    /* L2 never gets a preset outside the Off of the menu / Ocarina */
+    assert(!o.send_l);
+
+    /* Fire / ice / light arrows (0x2E, 0x2F, 0x30) are bows: ammo = arrows; 0x09 is nothing */
+    int arrows_sel[3] = {OOT_SEL_ARROW_FIRE, OOT_SEL_ARROW_ICE, OOT_SEL_ARROW_LIGHT};
+    for (int i = 0; i < 3; i++) {
+        settle(&st, &t, arrows_sel[i], 7, 30);
+        o = ev(&st, mk(t, arrows_sel[i], 7, 30, 40, 0.5f));
+        assert(o.id_r == RENHDRUM_TRIG_TENSION && nearf(o.level_r, 0.75f));
+        o = ev(&st, mk(t + 16, arrows_sel[i], 7, 30, 40, 0.0f));
+        t += 1000;
+    }
+    settle(&st, &t, 0x09, 7, 30);
+    o = ev(&st, mk(t, 0x09, 7, 30, 40, 0.5f));
+    assert(!o.send_r);
+    t += 1000;
+
+    /* Din (0x0A): ENGINE_ROUGH 0.6 only with verb 243 and R2 pulled; Farore / Nayru (0x0B, 0x0C): nothing */
+    settle(&st, &t, OOT_SEL_DIN, 0, 0);
+    o = ev(&st, mk(t, OOT_SEL_DIN, 0, 0, 40, 0.5f));
+    assert(!o.send_r);   /* not casting */
+    o = ev(&st, mk(t + 16, OOT_SEL_DIN, 0, 0, OOT_VERB_DIN_CAST, 0.02f));
+    assert(!o.send_r);   /* R2 under 3 % */
+    /* the hum runs from the start of the cast (verb 243), the game's rumble or not */
+    o = ev(&st, mkr(t + 24, OOT_SEL_DIN, OOT_VERB_DIN_CAST, 0.5f, 0.0f));
+    assert(o.id_r == RENHDRUM_TRIG_ENGINE_ROUGH && nearf(o.level_r, 0.6f) && o.rule == OOT_RULE_SPELL && !o.send_l && !o.clear_zr);
+    o = ev(&st, mkr(t + 100, OOT_SEL_DIN, OOT_VERB_DIN_CAST, 1.0f, 0.0f));
+    assert(o.id_r == RENHDRUM_TRIG_ENGINE_ROUGH && !o.clear_zr);
+    /* the game's rumble (small real numbers) comes: still the hum; it jitters between OFF and ON levels: still on */
+    o = ev(&st, mkr(t + 200, OOT_SEL_DIN, OOT_VERB_DIN_CAST, 1.0f, 0.05f));
+    assert(o.id_r == RENHDRUM_TRIG_ENGINE_ROUGH);
+    o = ev(&st, mkr(t + 216, OOT_SEL_DIN, OOT_VERB_DIN_CAST, 1.0f, 0.02f));
+    assert(o.id_r == RENHDRUM_TRIG_ENGINE_ROUGH);
