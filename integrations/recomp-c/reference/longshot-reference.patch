+    /* A sustained preset that stops being reported: one OFF at once (R2 let go, Din over, Hookshot latch), never repeated */
+    {
+        OotTrigState hs = OOT_TRIG_STATE_INIT;
+        int64_t ht = 1000;
+        settle(&hs, &ht, OOT_SEL_BOW, 7, 30);
+        o = ev(&hs, mk(ht, OOT_SEL_BOW, 7, 30, 40, 0.5f));
