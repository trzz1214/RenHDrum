+static void *rh_ds_stream;
+static uint32_t rh_ds_dev2;
+static int rh_ds_is_bt;
+static void *rh_ds_bt_hid;
+static HANDLE rh_ds_bt_thread;
+static volatile LONG rh_ds_bt_run;
+static int rh_ds_audio_attempts;
