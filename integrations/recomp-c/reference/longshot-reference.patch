diff --git a/host/oot_pad_light.h b/host/oot_pad_light.h
new file mode 100644
index 00000000..9dba1b37
--- /dev/null
+++ b/host/oot_pad_light.h
@@ -0,0 +1,62 @@
+/* (longshot) Pure rules for the DualSense's lights and touchpad in OoT (Plans 147, 149).
+   The light bar: a short red flash when Link is hit, a slow orange breath at one heart or less, else the pad's own colour.
+   The microphone LED: breathes (the pad's own mode) while the pad runs on a battery of 20 % or less. A touchpad click's finger
+   x -> the map or the bag. Header-only so host/oot_leds.c, host/pad_sdl.c, the bridge and tests/test_oot_pad_light.py share the
+   exact logic without the game. */
+#ifndef LONGSHOT_OOT_PAD_LIGHT_H
+#define LONGSHOT_OOT_PAD_LIGHT_H
+
+#include <math.h>
+#include <stdint.h>
+
+#define OOT_LED_LOW_LIFE     4              /* quarter hearts: one heart or less */
+#define OOT_BAR_HIT_NS       150000000LL    /* a hit's red flash */
+#define OOT_BAR_HIT_GAP_NS   350000000LL    /* a new flash only this long after the last one ended (at most 2 a second) */
+#define OOT_BAR_BREATH_NS    1000000000LL   /* the low-life breath: 1 s a cycle */
+#define OOT_BAR_BASE_R 0                    /* SDL's colour for player 1 (SDL_hidapi_ps5.c, SetLedsForPlayerIndex: 0,0,0x40) */
+#define OOT_BAR_BASE_G 0
+#define OOT_BAR_BASE_B 64
+
+typedef struct OotBarState {
+    int64_t prev_life;   /* the last life seen, -1 none yet */
+    int64_t hit_ns;      /* when the last flash began, -1 none */
+} OotBarState;
+#define OOT_BAR_STATE_INIT {-1, -1}
+
+typedef struct OotBar {
+    int valid;   /* 0 = life not known: leave the light bar alone */
+    uint8_t r, g, b;
+} OotBar;
+
+/* The light bar for life out of max_life (quarter hearts) at now_ns. Life falling (and still above 0) starts a red flash; that
+   wins over the low-life breath. */
+static inline OotBar oot_bar_color(OotBarState *st, int64_t life, int64_t max_life, int64_t now_ns) {
+    OotBar out = {0, OOT_BAR_BASE_R, OOT_BAR_BASE_G, OOT_BAR_BASE_B};
+    if (life < 0 || max_life <= 0) return out;
+    out.valid = 1;
+    if (st->prev_life >= 0 && life < st->prev_life && life > 0 &&
+        (st->hit_ns < 0 || now_ns - st->hit_ns >= OOT_BAR_HIT_NS + OOT_BAR_HIT_GAP_NS))
+        st->hit_ns = now_ns;
+    st->prev_life = life;
+    if (st->hit_ns >= 0 && now_ns - st->hit_ns < OOT_BAR_HIT_NS) {
+        out.r = 255, out.g = 0, out.b = 0;
+    } else if (life > 0 && life <= OOT_LED_LOW_LIFE) {
+        const double t = (double)(now_ns % OOT_BAR_BREATH_NS) / (double)OOT_BAR_BREATH_NS;
+        const double k = 0.15 + 0.85 * (1.0 - cos(6.283185307179586 * t)) / 2.0;
+        out.r = (uint8_t)(255.0 * k + 0.5), out.g = (uint8_t)(64.0 * k + 0.5), out.b = 0;
+    }
+    return out;
+}
+
+/* The microphone LED mode (0 off, 2 breathing) for a power state (SDL_PowerState: 1 on battery) and percent (-1 unknown), cur
+   the mode now: on at 20 % or less on a battery, off above 25 % or when charging / wired / unknown, between the two as it was. */
+static inline int oot_mic_mode(int power_state, int pct, int cur) {
+    if (power_state != 1 || pct < 0 || pct > 25) return 0;
+    return pct <= 20 ? 2 : cur;
+}
+
+/* The touchpad: x 0..1 of the finger at the click. Left half = the map (Minus), right half = the bag (Plus). */
+enum { OOT_ZONE_MAP = 0, OOT_ZONE_BAG = 1 };
+static inline int oot_touch_zone(float x) { return x < 0.5f ? OOT_ZONE_MAP : OOT_ZONE_BAG; }
+
+#endif /* LONGSHOT_OOT_PAD_LIGHT_H */
