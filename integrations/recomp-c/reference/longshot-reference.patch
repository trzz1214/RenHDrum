+        ht += 1000;
+        o = ev(&hs, mk(ht, OOT_SEL_HOOK, 0, 0, 40, 0.0f));
+        o = ev(&hs, mk(ht + 16, OOT_SEL_HOOK, 0, 0, 40, 0.4f));
+        assert(o.id_r == RENHDRUM_TRIG_TWO_STAGE);
+        o = ev(&hs, mk(ht + 32, OOT_SEL_HOOK, 0, 0, OOT_VERB_HOOK_SHOOT, 0.4f));
+        assert(o.id_r == RENHDRUM_TRIG_IMPACT_PULSE);
+        o = ev(&hs, mk(ht + 48, OOT_SEL_HOOK, 0, 0, 40, 0.0f));
+        assert(!o.send_r);
