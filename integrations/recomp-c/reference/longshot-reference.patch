+        assert(!o.send_r);
+    }
+
+    /* Hookshot latch: let go of R2 from 1.0 through 0.27 with the pad's ZR bit still on -> stays latched (no second shot);
+       the bit off -> opens */
+    {
+        OotTrigState hs = OOT_TRIG_STATE_INIT;
+        int64_t ht = 1000;
+        settle(&hs, &ht, OOT_SEL_HOOK, 0, 0);
+        o = ev(&hs, mk(ht, OOT_SEL_HOOK, 0, 0, 40, 0.4f));
+        o = ev(&hs, mk(ht + 16, OOT_SEL_HOOK, 0, 0, 40, 1.0f));
+        assert(o.clear_zr);
+        OotTrigIn a = mk(ht + 32, OOT_SEL_HOOK, 0, 0, 40, 0.27f);
+        a.zr_raw = 1;
+        o = oot_trigger_eval(&hs, &cfg, &a);
+        assert(o.clear_zr && !o.send_r);
+        a = mk(ht + 48, OOT_SEL_HOOK, 0, 0, 40, 0.2f);
+        a.zr_raw = 1;
+        o = oot_trigger_eval(&hs, &cfg, &a);
+        assert(o.clear_zr);
+        a = mk(ht + 64, OOT_SEL_HOOK, 0, 0, 40, 0.2f);
+        a.zr_raw = 0;
+        o = oot_trigger_eval(&hs, &cfg, &a);
+        assert(!o.clear_zr);
+    }
+
+    /* Megaton Hammer swing, with the real rumble numbers: 0 -> 0.10 (strike) -> 0.03..0.09 -> 0: HEAVY_LOAD before the strike, one
+       pulse at the strike, then a quake that follows the game's rumble (never under 30 % of its level) until the rumble is off
+       (100 ms under RUMBLE_OFF), then one OFF; never back to HEAVY_LOAD; a new swing starts clean */
+    {
+        OotTrigState hs = OOT_TRIG_STATE_INIT;
+        int64_t ht = 1000;
+        settle(&hs, &ht, OOT_SEL_HAMMER, 0, 0);
+        o = ev(&hs, mkr(ht, OOT_SEL_HAMMER, OOT_VERB_HAMMER, 0.5f, 0.0f));
+        assert(o.id_r == RENHDRUM_TRIG_HEAVY_LOAD && o.rule == OOT_RULE_HAMMER);
+        o = ev(&hs, mkr(ht + 16, OOT_SEL_HAMMER, OOT_VERB_HAMMER, 0.5f, 0.02f));   /* under HAMMER_HIT: still lifting */
+        assert(o.id_r == RENHDRUM_TRIG_HEAVY_LOAD);
+        o = ev(&hs, mkr(ht + 32, OOT_SEL_HAMMER, OOT_VERB_HAMMER, 0.5f, 0.10f));   /* the strike */
+        assert(o.id_r == RENHDRUM_TRIG_IMPACT_PULSE && o.rule == OOT_RULE_PULSE && nearf(o.level_r, 1.0f));
+        o = ev(&hs, mkr(ht + 48, OOT_SEL_HAMMER, OOT_VERB_HAMMER, 0.5f, 0.10f));   /* at the peak: full quake */
+        assert(o.id_r == RENHDRUM_TRIG_ENGINE_ROUGH && o.rule == OOT_RULE_QUAKE && nearf(o.level_r, 0.7f));
+        o = ev(&hs, mkr(ht + 64, OOT_SEL_HAMMER, OOT_VERB_HAMMER, 0.5f, 0.05f));   /* half of the peak */
+        assert(o.id_r == RENHDRUM_TRIG_ENGINE_ROUGH && nearf(o.level_r, 0.35f));
+        o = ev(&hs, mkr(ht + 80, OOT_SEL_HAMMER, OOT_VERB_HAMMER, 0.5f, 0.03f));   /* 30 % of the peak: the floor */
+        assert(o.id_r == RENHDRUM_TRIG_ENGINE_ROUGH && nearf(o.level_r, 0.21f));
+        o = ev(&hs, mkr(ht + 96, OOT_SEL_HAMMER, OOT_VERB_HAMMER, 0.5f, 0.02f));   /* below the floor share: held at 0.3 x QUAKE */
+        assert(o.id_r == RENHDRUM_TRIG_ENGINE_ROUGH && nearf(o.level_r, 0.21f));
+        o = ev(&hs, mkr(ht + 112, OOT_SEL_HAMMER, OOT_VERB_HAMMER, 0.5f, 0.0f));   /* under RUMBLE_OFF: 100 ms of grace */
+        assert(o.id_r == RENHDRUM_TRIG_ENGINE_ROUGH);
+        o = ev(&hs, mkr(ht + 200, OOT_SEL_HAMMER, OOT_VERB_HAMMER, 0.5f, 0.0f));
+        assert(o.id_r == RENHDRUM_TRIG_ENGINE_ROUGH);
+        o = ev(&hs, mkr(ht + 216, OOT_SEL_HAMMER, OOT_VERB_HAMMER, 0.5f, 0.0f));   /* rumble over: one OFF */
