diff --git a/tests/test_oot_trigprobe.py b/tests/test_oot_trigprobe.py
new file mode 100644
index 00000000..568d33cf
--- /dev/null
+++ b/tests/test_oot_trigprobe.py
@@ -0,0 +1,71 @@
+"""Trigger probe's pure part (host/oot_trigprobe.h): which flags differ between two snapshots (plan 143 6b).
+
+Compiles host/oot_trigprobe.h as a small standalone C test without the game.
+
+python -I -B tests/test_oot_trigprobe.py [--cc gcc]
+"""
+import argparse
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from compiler_command import compiler_command, parse_compiler  # noqa: E402
+
+RUN_ALL_ARGS = ["--cc", "{cc}"]
+ROOT = Path(__file__).resolve().parents[1]
+
+FIXTURE = r"""
+#include <assert.h>
+#include <stdio.h>
+#include "oot_trigprobe.h"
+
+int main(void) {
+    /* unsorted on purpose: 5 changes, 9 same, 3 gone (not reported), 7 new, 11 text changes */
+    TpFlag a[] = {{9, 1, 'I'}, {5, 10, 'E'}, {3, 4, 'U'}, {11, 100, 'T'}};
+    TpFlag b[] = {{11, 200, 'T'}, {7, 2, 'I'}, {9, 1, 'I'}, {5, 11, 'E'}};
+    TpChange out[8];
+    int n = tp_diff(a, 4, b, 4, out, 8);
+    assert(n == 3);
+    assert(out[0].key == 5 && out[0].old_val == 10 && out[0].new_val == 11 && out[0].kind == 'E' && !out[0].added);
+    assert(out[1].key == 7 && out[1].old_val == 0 && out[1].new_val == 2 && out[1].added);
+    assert(out[2].key == 11 && out[2].kind == 'T' && out[2].new_val == 200 && !out[2].added);
+
+    /* nothing changed -> nothing; the cap stops the list */
+    TpFlag c[] = {{1, 1, 'I'}, {2, 2, 'I'}};
+    TpFlag d[] = {{1, 1, 'I'}, {2, 2, 'I'}};
+    assert(tp_diff(c, 2, d, 2, out, 8) == 0);
+    TpFlag e[] = {{1, 5, 'I'}, {2, 6, 'I'}};
+    TpFlag f[] = {{1, 1, 'I'}, {2, 2, 'I'}};
+    assert(tp_diff(e, 2, f, 2, out, 1) == 1);
+    assert(tp_diff(e, 0, f, 2, out, 8) == 2);   /* an empty first snapshot: all new */
+
+    puts("PASS: oot_trigprobe diff");
+    return 0;
+}
+"""
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--cc", default=None)
+    args = parser.parse_args()
+    cc = parse_compiler(args.cc) if args.cc else compiler_command("CC", "gcc", "clang")
+    flags = subprocess.CREATE_NO_WINDOW | subprocess.BELOW_NORMAL_PRIORITY_CLASS if os.name == "nt" else 0
+    with tempfile.TemporaryDirectory(prefix="oot-trigprobe-") as tmp:
+        src = Path(tmp) / "t.c"
+        exe = Path(tmp) / "t.exe"
+        src.write_text(FIXTURE, encoding="utf-8")
+        subprocess.run(
+            cc + ["-std=c11", "-O2", "-Wall", "-Wextra", "-Werror", "-I", str(ROOT / "host"), str(src), "-o", str(exe)],
+            check=True,
+            creationflags=flags,
+            timeout=60,
+        )
+        subprocess.run([str(exe)], check=True, creationflags=flags, timeout=30)
+
+
+if __name__ == "__main__":
+    main()
