-        RenHdcEngine *e = pads[i].engine;
-        memset(&pads[i], 0, sizeof pads[i]);
-        ReleaseSRWLockExclusive(&lk);
-        if (x) rh.xbox_rumble_destroy(x);   /* (out of the list first: nothing else reaches it now) */
-        if (e) rh.engine_destroy(e);
