+
+    CHECK(rh_detach(NULL) == 1);
+    CHECK(rh_detach((void *)0x9999) == 1);
+    rh_cleanup();
+    CHECK(rh_is_active((void *)0x9999) == 0);
+
+    printf("PASS: rh_bridge fallback\n");
+    return 0;
+}
+"""
+
+MOCK_SDL3_SRC = r"""
+#include <stdint.h>
+#include <string.h>
+#include <windows.h>
+
+/* pad tags: 0x1001/2 Switch Pro, 0x2001 Xbox One S, 0x2002 other vendor, 0x3001 Steam Controller wired (1302),
+   0x3003 Steam Controller Bluetooth (1303), 0x3002 Steam Input's stand-in pad (11FF, Steam handle) */
+static volatile LONG g_effect_count = 0;
+static int g_conn_state = 1; /* 1 = wired, 2 = wireless */
+static volatile LONG g_motor[4];
+static volatile LONG g_rumble_calls = 0;
+static volatile LONG g_trigger_calls = 0;
+static volatile LONG g_mode_writes = 0;
+static volatile LONG g_report_writes = 0;
+static volatile LONG g_hid_opens = 0;
+static volatile LONG g_hid_closes = 0;
+static volatile LONG g_first_write = -1;
+static volatile LONG g_last_mode_op = -1;
+static volatile LONG g_last_mode_format = -1;
+
+__declspec(dllexport) uint16_t SDL_GetGamepadVendor(void *pad) {
+    switch ((uintptr_t)pad) {
+    case 0x2001: return 0x045E;
+    case 0x2002: return 0x046D;
+    case 0x3001: case 0x3002: case 0x3003: return 0x28DE;
+    default: return 0x057E;
+    }
+}
+__declspec(dllexport) uint16_t SDL_GetGamepadProduct(void *pad) {
+    switch ((uintptr_t)pad) {
+    case 0x2001: return 0x028E;
+    case 0x2002: return 0xC216;
+    case 0x3001: return 0x1302;
+    case 0x3002: return 0x11FF;
+    case 0x3003: return 0x1303;
+    default: return 0x2009;
+    }
+}
+__declspec(dllexport) int SDL_GetGamepadType(void *pad) {
+    return (uintptr_t)pad == 0x2001 ? 3 /* XBOXONE */ : (uintptr_t)pad == 0x2002 ? 1 /* STANDARD */ : 0;
+}
+__declspec(dllexport) uint64_t SDL_GetGamepadSteamHandle(void *pad) { return (uintptr_t)pad == 0x3002 ? 0x1234 : 0; }
+__declspec(dllexport) int SDL_GetGamepadConnectionState(void *pad) {
+    (void)pad;
+    return g_conn_state;
+}
+__declspec(dllexport) void *SDL_GetGamepadJoystick(void *pad) {
+    return pad;
+}
+__declspec(dllexport) const char *SDL_GetGamepadPath(void *pad) { (void)pad; return "mock-hid-path"; }
+__declspec(dllexport) const char *SDL_GetJoystickPath(void *joy) { (void)joy; return "mock-hid-path"; }
+__declspec(dllexport) int SDL_SendJoystickEffect(void *joy, const void *data, int size) {
+    (void)joy; (void)data; (void)size;
+    InterlockedIncrement(&g_effect_count);
+    return 1;
+}
+/* SDL3 returns bool: only the low byte is set, the rest of the register is junk on purpose */
+__declspec(dllexport) int SDL_RumbleJoystick(void *joy, uint16_t lo, uint16_t hi, uint32_t ms) {
+    (void)joy; (void)ms;
+    InterlockedExchange(&g_motor[0], lo);
+    InterlockedExchange(&g_motor[1], hi);
+    InterlockedIncrement(&g_rumble_calls);
+    return (int)0x7FFFFF01;
+}
+__declspec(dllexport) int SDL_RumbleJoystickTriggers(void *joy, uint16_t l, uint16_t r, uint32_t ms) {
+    (void)joy; (void)ms;
+    InterlockedExchange(&g_motor[2], l);
+    InterlockedExchange(&g_motor[3], r);
+    InterlockedIncrement(&g_trigger_calls);
+    return (int)0x7FFFFF01;
+}
+__declspec(dllexport) void *SDL_hid_open_path(const char *path) { (void)path; InterlockedIncrement(&g_hid_opens); return (void *)0x77; }
+__declspec(dllexport) int SDL_hid_close(void *h) { (void)h; InterlockedIncrement(&g_hid_closes); return 0; }
+__declspec(dllexport) int SDL_hid_write(void *h, const void *data, size_t len) {
+    (void)h;
+    const uint8_t *d = (const uint8_t *)data;
+    InterlockedCompareExchange(&g_first_write, d[0], -1);
+    if (len == 4 && d[0] == 0x86) {
+        InterlockedIncrement(&g_mode_writes);
+        InterlockedExchange(&g_last_mode_op, d[1]);
+        InterlockedExchange(&g_last_mode_format, d[3]);
+    } else if (len == 64) {
+        InterlockedIncrement(&g_report_writes);
+    }
+    return (int)len;
+}
+
+__declspec(dllexport) void test_sdl_set_conn(int state) { g_conn_state = state; }
+__declspec(dllexport) LONG test_sdl_get_effects(void) { return InterlockedCompareExchange(&g_effect_count, 0, 0); }
+__declspec(dllexport) void test_sdl_reset_effects(void) { InterlockedExchange(&g_effect_count, 0); }
+__declspec(dllexport) LONG test_sdl_motor(int i) { return InterlockedCompareExchange(&g_motor[i], 0, 0); }
+__declspec(dllexport) LONG test_sdl_rumble_calls(void) { return InterlockedCompareExchange(&g_rumble_calls, 0, 0); }
+__declspec(dllexport) LONG test_sdl_trigger_calls(void) { return InterlockedCompareExchange(&g_trigger_calls, 0, 0); }
+__declspec(dllexport) LONG test_sdl_mode_writes(void) { return InterlockedCompareExchange(&g_mode_writes, 0, 0); }
+__declspec(dllexport) LONG test_sdl_report_writes(void) { return InterlockedCompareExchange(&g_report_writes, 0, 0); }
+__declspec(dllexport) LONG test_sdl_hid_opens(void) { return InterlockedCompareExchange(&g_hid_opens, 0, 0); }
+__declspec(dllexport) LONG test_sdl_hid_closes(void) { return InterlockedCompareExchange(&g_hid_closes, 0, 0); }
+__declspec(dllexport) LONG test_sdl_first_write(void) { return InterlockedCompareExchange(&g_first_write, 0, 0); }
+__declspec(dllexport) LONG test_sdl_last_mode_op(void) { return InterlockedCompareExchange(&g_last_mode_op, 0, 0); }
+__declspec(dllexport) LONG test_sdl_last_mode_format(void) { return InterlockedCompareExchange(&g_last_mode_format, 0, 0); }
+"""
+
+MOCK_RH_DLL_TEMPLATE = r"""
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+#include <windows.h>
+
+static volatile LONG g_emit_once = 0;
+static volatile LONG g_emit_silent = 0;
+static volatile LONG g_last_bt_level = -1;
+
+{VERSION_FN}
+
+__declspec(dllexport) void *renhdrum_engine_create(bool bt, bool crisp) {{
+    (void)bt; (void)crisp;
+    return (void *)0xCAFE;
+}}
+__declspec(dllexport) void renhdrum_engine_destroy(void *e) {{ (void)e; }}
+__declspec(dllexport) int32_t renhdrum_settings_default(int32_t *out) {{
+    memset(out, 0, 64);
+    out[0] = 1;
+    out[1] = 15;
+    out[2] = 4;
