+
+    /* HOS_TRIG_DEEP_FIRE=0: no change to the buttons */
+    settle(&st, &t, OOT_SEL_HOOK, 0, 0);
+    {
+        OotTrigIn a = mk(t, OOT_SEL_HOOK, 0, 0, 40, 0.4f);
+        o = oot_trigger_eval(&st, &cfg_nodeep, &a);
+        a = mk(t + 16, OOT_SEL_HOOK, 0, 0, 40, 1.0f);
