@@ -0,0 +1,182 @@
+"""The Insert menu's HD Rumble settings page (gpu/vk/menu/hd_rumble.cpp), compiled with the menu model and run with no game.
+
+Checks:
+- menu::build() produces no diagnostics;
+- the Controls tab places @HD Rumble settings (Kind::Page -> "hd_rumble") immediately after hd_rumble;
+- the hd_rumble page exposes Status (@hd_rumble_status), Basic (5 rows), Advanced toggle (rh_advanced_toggle, collapsed by
+  default and expanding all 17 Advanced rows on Input::Activate), Reset (rh_reset), and Credit (rh_credit);
+- all 22 core renhdrum_options keys (every key except enable_hd_rumble, which stays on Controls as hd_rumble) are present
+  as rh_<key>, preset_exempt and !restart, and none collide with FROZEN keys in longshot_options.ini;
+- gpu/vk/vk_api.h bumps MKWVK_API_VERSION >= 36 with (*rh_option), host/rx_backend.c wires host_rh_option, host/rh_host.h
+  provides the Linux stub, and gpu/vk/menu/hd_rumble.cpp checks host->version >= 36.
+
+    python -I -B tests/test_hd_rumble_menu.py [--cxx g++]
+"""
+import argparse
+import re
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))   # (python -I leaves the check's own folder off the path)
+from menu_model_fixture import compile_menu  # noqa: E402
+from test_menu_ini_keys import FROZEN  # noqa: E402
+
+RUN_ALL_ARGS = ["--cxx", "g++"]
+
+ROOT = Path(__file__).resolve().parents[1]
+
+BASIC_KEYS = (
+    "rh_switch_bt_mode",
+    "rh_dualsense_haptics",
+    "rh_dualsense_hd_haptics",
+    "rh_dualsense_volume",
+    "rh_xbox_enabled",
+)
+
+ADVANCED_KEYS = (
+    "rh_gain",
+    "rh_low_boost",
+    "rh_usb_no_queue",
+    "rh_envelope_5ms",
+    "rh_frequency_in_packet",
+    "rh_frequency_both_bands",
+    "rh_crisp_notes",
+    "rh_usb_interval_ms",
+    "rh_usb_auto_slow",
+    "rh_bt_after_input",
+    "rh_bt_crisp_notes",
+    "rh_dualsense_crisp_notes",
+    "rh_xbox_mode",
+    "rh_xbox_strength",
+    "rh_xbox_detail",
+    "rh_xbox_accents",
+    "rh_xbox_trigger_mix",
+)
+
+MAIN = r'''#include "menu_module.h"
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+using namespace mkwvk;
+namespace mkwvk { Options opts; }
+static int failures = 0;
+#define CHECK(cond) do { if (!(cond)) { fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); failures++; } } while (0)
+
+// CORE
+
+static int index_in(const std::vector<menu::LayoutItem>& items, const char* key) {
+    for (size_t i = 0; i < items.size(); i++)
+        if (items[i].key && !strcmp(items[i].key, key)) return (int)i;
+    return -1;
+}
+
+static bool shown_has(const char* page, const char* key) {
+    for (const auto& v : menu::snapshot(page))
+        if (v.kind != menu::Kind::Heading && v.key && !strcmp(v.key, key)) return true;
+    return false;
+}
+
+int main() {
+    menu::set_log([](const char*) {});
+    menu::build();
+    for (const auto& d : menu::diagnostics()) fprintf(stderr, "  diagnostic: %s\n", d.c_str());
+    CHECK(menu::diagnostics().empty());
+
+    // Controls tab: @HD Rumble settings right after hd_rumble
+    const auto controls = menu::layout("controls");
+    const int i_switch = index_in(controls, "hd_rumble");
+    const int i_link = index_in(controls, "@HD Rumble settings");
+    CHECK(i_switch >= 0 && i_link == i_switch + 1);
+    const menu::Setting* link = menu::find("@HD Rumble settings");
+    CHECK(link && link->kind == menu::Kind::Page && link->opens && !strcmp(link->opens, "hd_rumble"));
+
+    // Page layout & 22 keys (no enable_hd_rumble)
+    CHECK(menu::find("rh_enable_hd_rumble") == nullptr);
+    static const char* const kBasic[] = {
+        "rh_switch_bt_mode", "rh_dualsense_haptics", "rh_dualsense_hd_haptics",
+        "rh_dualsense_volume", "rh_xbox_enabled",
+    };
+    static const char* const kAdv[] = {
+        "rh_gain", "rh_low_boost", "rh_usb_no_queue", "rh_envelope_5ms",
+        "rh_frequency_in_packet", "rh_frequency_both_bands", "rh_crisp_notes",
+        "rh_usb_interval_ms", "rh_usb_auto_slow", "rh_bt_after_input", "rh_bt_crisp_notes",
+        "rh_dualsense_crisp_notes", "rh_xbox_mode", "rh_xbox_strength",
+        "rh_xbox_detail", "rh_xbox_accents", "rh_xbox_trigger_mix",
+    };
+    for (const char* k : kBasic) {
+        const menu::Setting* s = menu::find(k);
+        CHECK(s && s->preset_exempt && !s->restart);
+        CHECK(shown_has("hd_rumble", k));
+    }
+    for (const char* k : kAdv) {
+        const menu::Setting* s = menu::find(k);
+        CHECK(s && s->preset_exempt && !s->restart);
+        CHECK(!shown_has("hd_rumble", k));   // collapsed by default
+    }
+
+    // Status, Reset, Credit and Advanced toggle
+    const menu::Setting* status = menu::find("@hd_rumble_status");
+    const menu::Setting* adv = menu::find("rh_advanced_toggle");
+    const menu::Setting* reset = menu::find("rh_reset");
+    const menu::Setting* credit = menu::find("rh_credit");
+    CHECK(status && status->kind == menu::Kind::Action);
+    CHECK(adv && adv->kind == menu::Kind::Action);
+    CHECK(reset && reset->kind == menu::Kind::Action);
+    CHECK(credit && credit->kind == menu::Kind::Action);
+    CHECK(shown_has("hd_rumble", "@hd_rumble_status"));
+    CHECK(shown_has("hd_rumble", "rh_advanced_toggle"));
+    CHECK(shown_has("hd_rumble", "rh_reset"));
+    CHECK(shown_has("hd_rumble", "rh_credit"));
+
+    // Expanding & collapsing Advanced
+    const auto out_open = menu::input_key("hd_rumble", "rh_advanced_toggle", menu::Input::Activate);
+    CHECK(out_open.taken);
+    for (const char* k : kAdv) CHECK(shown_has("hd_rumble", k));
+    const auto out_close = menu::input_key("hd_rumble", "rh_advanced_toggle", menu::Input::Activate);
+    CHECK(out_close.taken);
+    for (const char* k : kAdv) CHECK(!shown_has("hd_rumble", k));
+
+    if (failures) return 1;
+    printf("PASS: hd_rumble menu page (22 keys, collapsed/expanded Advanced, Reset, Status, Credit)\n");
+    return 0;
+}
+'''
+
+
+def check(cond, what):
+    if not cond:
+        raise SystemExit("FAIL: " + what)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--cxx", default="g++")
+    args = parser.parse_args()
+
+    all_keys = set(BASIC_KEYS) | set(ADVANCED_KEYS) | {"rh_advanced_toggle", "rh_reset", "rh_credit"}
+    check(len(BASIC_KEYS) + len(ADVANCED_KEYS) == 22, "expected 22 core keys")
+    check(not (all_keys & set(FROZEN)), "hd_rumble key collides with FROZEN ini keys: %s" % sorted(all_keys & set(FROZEN)))
+
+    api = (ROOT / "gpu" / "vk" / "vk_api.h").read_text(encoding="utf-8")
+    ver = int(re.search(r"#define MKWVK_API_VERSION (\d+)", api).group(1))
+    check(ver >= 36, "MKWVK_API_VERSION < 36")
+    check("(*rh_option)" in api, "vk_api.h missing (*rh_option)")
+
+    backend = (ROOT / "host" / "rx_backend.c").read_text(encoding="utf-8")
+    check("host_rh_option" in backend, "rx_backend.c missing host_rh_option")
+
+    rh_host = (ROOT / "host" / "rh_host.h").read_text(encoding="utf-8")
+    check("rh_host_option" in rh_host, "rh_host.h missing Linux stub rh_host_option")
+
+    mod = (ROOT / "gpu" / "vk" / "menu" / "hd_rumble.cpp").read_text(encoding="utf-8")
+    check("host->version >= 36" in mod, "hd_rumble.cpp missing host->version >= 36 guard")
+
+    with tempfile.TemporaryDirectory(prefix="hd-rumble-menu-") as tmp:
+        subprocess.run([str(compile_menu(args.cxx, MAIN, tmp))], check=True)
+
+
+if __name__ == "__main__":
+    main()
