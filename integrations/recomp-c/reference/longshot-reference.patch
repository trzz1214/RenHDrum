+
+        m_poll = re.search(r"static void pads_poll\(void\)\s*\{", pad_txt)
+        self.assertIsNotNone(m_poll)
+        poll_body = pad_txt[m_poll.start():]
+        idx_claim = poll_body.index("if (rh_pad_claimed(i)) continue;")
+        idx_hd = poll_body.index("if (hd_poll(i, side, now)) continue;")
+        idx_due = poll_body.index("rumble_due(")
+        self.assertLess(idx_claim, idx_hd)
+        self.assertLess(idx_hd, idx_due)
+
+        m_clean = re.search(r"static void pad_exit_cleanup\(void\)\s*\{[^}]+\}", pad_txt)
+        self.assertIsNotNone(m_clean)
+        clean_body = m_clean.group(0)
+        self.assertIn("hos_sdl_pad_rumble(pads[i].gc, 0, 0, 0);", clean_body)
