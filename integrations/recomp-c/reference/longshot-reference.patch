+
+    /* Megaton Hammer (0x07): HEAVY_LOAD 0.7 only with verb 112 and R2 pulled; other verb / R2 under 3 %: nothing */
+    {
+        OotTrigState hs = OOT_TRIG_STATE_INIT;
+        int64_t ht = 1000;
+        settle(&hs, &ht, OOT_SEL_HAMMER, 0, 0);
+        o = ev(&hs, mk(ht, OOT_SEL_HAMMER, 0, 0, 40, 0.5f));
+        assert(!o.send_r);
+        o = ev(&hs, mk(ht + 16, OOT_SEL_HAMMER, 0, 0, OOT_VERB_HAMMER, 0.02f));
+        assert(!o.send_r);
+        o = ev(&hs, mk(ht + 32, OOT_SEL_HAMMER, 0, 0, OOT_VERB_HAMMER, 0.5f));
+        assert(o.id_r == RENHDRUM_TRIG_HEAVY_LOAD && nearf(o.level_r, 0.7f) && o.rule == OOT_RULE_HAMMER && !o.send_l && !o.clear_zr);
+        o = ev(&hs, mk(ht + 48, OOT_SEL_HAMMER, 0, 0, OOT_VERB_HAMMER, 1.0f));
