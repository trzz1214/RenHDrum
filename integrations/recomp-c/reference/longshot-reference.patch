+/* ---- Xbox One S state (4 motors: grips, triggers) ---- */
+static SRWLOCK rh_xb_lock = SRWLOCK_INIT;
+static RenHdcXboxRumble *rh_xb;
+static void *rh_xb_pad;
+static void *rh_xb_joy;
+static int64_t rh_xb_at[2];
