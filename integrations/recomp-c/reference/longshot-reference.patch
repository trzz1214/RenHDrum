+        o = ev(&hs, mkr(ht + 248, OOT_SEL_HAMMER, 40, 0.5f, 0.0f));   /* verb leaves 112: reset */
+        o = ev(&hs, mkr(ht + 264, OOT_SEL_HAMMER, OOT_VERB_HAMMER, 0.5f, 0.0f));
