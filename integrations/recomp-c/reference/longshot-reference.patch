+}}
+__declspec(dllexport) int32_t renhdrum_engine_tick(void *e, int64_t now_us, uint8_t *out10) {{
+    (void)e; (void)now_us;
+    if (InterlockedExchange(&g_emit_once, 0) == 1) {{
+        static const uint8_t vib[10] = {{0x10, 0x01, 0x80, 0x01, 0x40, 0x40, 0x80, 0x01, 0x40, 0x40}};
+        static const uint8_t sil[10] = {{0x10, 0x01, 0x00, 0x01, 0x40, 0x40, 0x00, 0x01, 0x40, 0x40}};
+        memcpy(out10, InterlockedCompareExchange(&g_emit_silent, 0, 0) ? sil : vib, 10);
+        return 1;
+    }}
+    return 0;
