+    o = ev(&st, mkr(t + 356, OOT_SEL_DIN, OOT_VERB_DIN_CAST, 1.0f, 0.0f));
+    assert(!o.send_r);
+    o = ev(&st, mk(t + 380, OOT_SEL_DIN, 0, 0, 40, 0.0f));
