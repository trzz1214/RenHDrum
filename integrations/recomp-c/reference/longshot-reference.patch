+        o = ev(&hs, mk(ht + 32, OOT_SEL_BOW, 7, 30, 40, 0.0f));
+        assert(!o.send_r);
+        ht += 1000;
+        /* Hookshot: the frame that latches stops TWO_STAGE -> one OFF; the pulse after it still goes; no OFF after the pulse */
+        settle(&hs, &ht, OOT_SEL_HOOK, 0, 0);
+        o = ev(&hs, mk(ht, OOT_SEL_HOOK, 0, 0, 40, 0.4f));
+        assert(o.id_r == RENHDRUM_TRIG_TWO_STAGE);
+        o = ev(&hs, mk(ht + 16, OOT_SEL_HOOK, 0, 0, 40, 0.97f));
+        assert(o.clear_zr && o.send_r && o.id_r == RENHDRUM_TRIG_OFF);
+        o = ev(&hs, mk(ht + 32, OOT_SEL_HOOK, 0, 0, 40, 1.0f));
