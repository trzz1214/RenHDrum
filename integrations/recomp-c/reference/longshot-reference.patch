new file mode 100644
index 00000000..3e2e836c
--- /dev/null
+++ b/host/oot_leds.c
@@ -0,0 +1,36 @@
+/* (longshot) The DualSense's light bar follows Link (Plans 147, 149): a red flash when he is hit, a breath at one heart or less.
+   The rules are host/oot_pad_light.h; the bridge sends the colour (rh_leds, host/renhdrum_recomp_bridge.c) only when it changes
+   and also breathes the microphone LED on a low battery. HOS_PAD_LEDS=0 leaves the lights as they were. */
+#include "hos.h"
+#include "rh_host.h"
+#include "oot_pad_light.h"
+#include <stdint.h>
+#include <stdlib.h>
+#ifndef LONGSHOT_ENV_H
+#include "../gpu/vk/compat/longshot_env.h"
+#endif
+
+int64_t hos_now_ns(void);
+int hos_oot_gamedata_int(uint32_t hash, int64_t *v);   /* host/oot_state_tap.c */
+
+#define LED_LIFE     0x31ab5580u   /* PlayerStatus.Life, quarter hearts */
+#define LED_MAX_LIFE 0xfbe01da1u   /* PlayerStatus.MaxLife */
+
+/* Called each read of the pads (host/oot_trigger.c) */
+void hos_oot_leds_frame(void) {
+    static int on = -1;
+    if (on < 0) {
+        const char *e = getenv("HOS_PAD_LEDS");
+        on = !e || !env_value_off(e);
+    }
+    if (!on) return;
+    static int64_t next;
+    static OotBarState bar = OOT_BAR_STATE_INIT;
+    const int64_t now = hos_now_ns();
+    if (now < next) return;
+    next = now + 20000000LL;   /* (50 a second: a hit's 150 ms flash is caught, the bridge sends at most about 12) */
+    int64_t life, max_life;
+    if (!hos_oot_gamedata_int(LED_LIFE, &life) || !hos_oot_gamedata_int(LED_MAX_LIFE, &max_life)) return;
+    const OotBar l = oot_bar_color(&bar, life, max_life, now);
+    if (l.valid) rh_leds(l.r, l.g, l.b);
+}
