+int hos_oot_flags_snapshot(uint32_t *key, uint32_t *val, char *kind, int cap) {
+    static const int kinds[] = {KIND_INT, KIND_ENUM, KIND_UINT, KIND_TEXT};
+    static const char letters[] = {'I', 'E', 'U', 'T'};
+    const uint64_t mgr = state_u64(state_u64(STATE_GAMEDATA_SLOT));
+    int n = 0;
+    for (int k = 0; mgr && k < 4; k++) {
+        StateTable h;
+        if (!state_table(mgr, kinds[k], &h)) continue;
+        for (uint32_t slot = 0; slot < h.size && n < cap; slot++) {
+            uint32_t pair[2], v = 0;
+            if (!state_peek(h.table + slot * 8ULL, pair, sizeof pair) || !pair[0] || pair[1] >= h.count) continue;
+            const uint64_t at = h.entries + (uint64_t)pair[1] * state_kind[kinds[k]].stride + state_kind[kinds[k]].value;
+            if (kinds[k] == KIND_TEXT) {
+                char t[64];
+                const uint64_t p = state_u64(at);
+                if (!p || !state_peek(p, t, sizeof t)) continue;
+                t[63] = 0;
+                v = 2166136261u;   /* FNV-1a */
+                for (const char *c = t; *c; c++) v = (v ^ (unsigned char)*c) * 16777619u;
+            } else if (!state_peek(at, &v, 4)) continue;
+            key[n] = pair[0], val[n] = v, kind[n] = letters[k], n++;
+        }
+    }
+    return n;
+}
