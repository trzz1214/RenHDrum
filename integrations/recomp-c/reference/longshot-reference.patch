+   POSIX builds keep clean no-op stubs (Linux builds fall back to Motors / built-in HD rumble).
+   Always declares the DualSense USB speaker-sharing interface used by host/pad_speaker.c. */
+#pragma once
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Shared DualSense USB audio-stream route tokens used by host/pad_speaker.c */
+enum { RH_SPEAKER_NONE = 0, RH_SPEAKER_GAME = 1, RH_SPEAKER_JACK = 2 };
+void *rh_usb_owner(void);
+int rh_usb_alive(void);
+int rh_usb_token(void);
+int rh_usb_restart_audio(void);
+int rh_usb_speaker(int want, int gain);
+
+#ifdef __cplusplus
+}
+#endif
+
+#ifdef _WIN32
+#include "renhdrum_recomp_bridge.h"
+#else
+#include "renhdrum.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+static inline int rh_load(void) { return 0; }
+static inline void rh_attach(void *pad) { (void)pad; }
+static inline int rh_detach(void *pad) { (void)pad; return 0; }
+static inline int rh_vibration(int side, float al, float fl, float ah, float fh) {
+    (void)side, (void)al, (void)fl, (void)ah, (void)fh;
+    return 0;
+}
+static inline void rh_permit(int on) { (void)on; }
+static inline void rh_cleanup(void) {}
+static inline void rh_shutdown(void) {}
+static inline int rh_is_active(void *pad) { (void)pad; return 0; }
+static inline int rh_pad_claimed(int i) { (void)i; return 0; }
+static inline void rh_set_enabled(int on) { (void)on; }
+static inline void rh_set_switch_gen(int gen) { (void)gen; }
+static inline void rh_trigger_preset(int side, uint8_t id, float level) { (void)side, (void)id, (void)level; }
+static inline int rh_hd_triggers_on(void) { return 1; }
+static inline void rh_leds(int r, int g, int b) { (void)r, (void)g, (void)b; }
+static inline float rh_game_rumble_amp(void) { return 0.0f; }
+static inline const char *rh_status_line(void) { return "HD Rumble is not available on this platform"; }
+static inline int rh_ds_render_frames(float *out, int frames) { (void)out, (void)frames; return -1; }
+static inline int rh_option_count(void) { return 0; }
+static inline const RenHdcOption *rh_option_at(int i) { (void)i; return NULL; }
+static inline int rh_option_get(const char *key, int *out) { (void)key, (void)out; return -1; }
+static inline int rh_option_set(const char *key, int value) { (void)key, (void)value; return -1; }
+static inline void rh_option_reset(void) {}
+
+#ifdef __cplusplus
+}
