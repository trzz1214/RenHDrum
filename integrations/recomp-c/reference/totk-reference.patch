+static void hd_rumble_option_row(int idx, int scope_id, uint32_t active_dev, int active_link,
+                                 bool master_off, const char *master_note) {
+    const RenHdcOption *opt = rh_option_at(idx);
+    if (!opt || !opt->key) return;
+    int val = opt->def;
+    rh_option_get(opt->key, &val);
+
+    bool disabled = master_off;
+    const char *dnote = master_off ? master_note : nullptr;
+    if (!disabled && active_dev != 0 && (opt->devices & active_dev) != 0 &&
+        opt->link != 0 && opt->link != active_link) {
+        disabled = true;
+        dnote = menu_text(active_link == INPUT_HD_LINK_USB ? UI_MENU_HD_WRONG_LINK_USB : UI_MENU_HD_WRONG_LINK_BT);
+    }
+    if (!disabled && opt->requires_row >= 0) {
+        const RenHdcOption *req = rh_option_at(opt->requires_row);
+        int rval = 1;
+        if (req && req->key) rh_option_get(req->key, &rval);
+        if (rval == 0) {
+            disabled = true;
+            dnote = menu_text(UI_MENU_HD_REQUIRES_PARENT);
+        }
+    }
+
+    char vbuf[96] = "";
+    const char *choice_ptrs[16] = {};
+    int n_choices = 0;
+    char choice_buf[256] = "";
+    if (opt->kind == 0) {
+        snprintf(vbuf, sizeof vbuf, "%s", menu_text(val ? UI_MENU_ON : UI_MENU_OFF));
+    } else if (opt->kind == 2 && opt->choices && *opt->choices) {
+        snprintf(choice_buf, sizeof choice_buf, "%s", opt->choices);
+        for (char *p = choice_buf; *p && n_choices < 16;) {
+            choice_ptrs[n_choices++] = p;
+            char *bar = strchr(p, '|');
+            if (!bar) break;
+            *bar = 0;
+            p = bar + 1;
+        }
+        int ci = (val >= 0 && val < n_choices) ? val : 0;
+        snprintf(vbuf, sizeof vbuf, "%s", n_choices > 0 ? choice_ptrs[ci] : "");
+    } else {
+        snprintf(vbuf, sizeof vbuf, "%d %%", val);
+    }
+
+    char id[96];
+    snprintf(id, sizeof id, "##rh_%d_%s", scope_id, opt->key);
+    if (disabled) opt_disable_next_text(dnote ? dnote : menu_text(UI_MENU_OFF));
+    bool arrows = (opt->kind != 0);
+    bool is_def = (val == opt->def);
+    bool held = false;
+    const char *label = (opt->label && *opt->label) ? opt->label : opt->key;
+    const char *desc = (opt->help && *opt->help) ? opt->help : label;
+    int step = opt_value_row(id, label, vbuf, nullptr, desc, arrows, is_def, &held);
+    if (step == 0 || disabled) return;
+
+    int nv = val;
+    if (opt->kind == 0) {
+        nv = val ? 0 : 1;
+    } else if (opt->kind == 2 && n_choices > 0) {
+        if (step == 2) nv = (val + 1) % n_choices;
+        else if (step < 0) nv = val > 0 ? val - 1 : 0;
+        else nv = val + 1 < n_choices ? val + 1 : n_choices - 1;
+    } else {
+        int inc = opt->step > 0 ? opt->step : 1;
+        int mult = (held && (opt->max - opt->min) > 40 * inc) ? 10 : 1;
+        if (step == 2) nv = val + inc > opt->max ? opt->min : val + inc;
+        else nv = val + step * inc * mult;
+        if (nv < opt->min) nv = opt->min;
+        if (nv > opt->max) nv = opt->max;
+    }
+    if (nv != val) rh_option_set(opt->key, nv);
+}
+
+static bool hd_rumble_has_rows(int count, int tier, uint32_t dev_mask, int link_filter, int exact_dev) {
+    for (int i = 0; i < count; i++) {
+        const RenHdcOption *o = rh_option_at(i);
+        if (!o || !o->key || !strcmp(o->key, "enable_hd_rumble")) continue;
+        if (o->tier != tier) continue;
+        if (exact_dev ? (o->devices != dev_mask) : ((o->devices & dev_mask) == 0)) continue;
+        if (link_filter > 0 && o->link != link_filter) continue;
+        return true;
+    }
+    return false;
+}
+
+static void hd_rumble_draw_group(int count, int tier, int scope_id, uint32_t dev_mask, int link_filter,
+                                 bool exact_dev, uint32_t active_dev, int active_link,
+                                 bool master_off, const char *master_note) {
+    for (int i = 0; i < count; i++) {
+        const RenHdcOption *o = rh_option_at(i);
+        if (!o || !o->key || !strcmp(o->key, "enable_hd_rumble")) continue;
+        if (o->tier != tier) continue;
+        if (exact_dev ? (o->devices != dev_mask) : ((o->devices & dev_mask) == 0)) continue;
+        if (link_filter >= 0 && o->link != link_filter && !(link_filter == 0 && o->link == 0)) continue;
+        if (link_filter > 0 && o->link != link_filter) continue;
+        if (link_filter == 0 && active_dev != 0 && o->link != 0 && o->link != active_link) continue;
+        hd_rumble_option_row(i, scope_id, active_dev, active_link, master_off, master_note);
+    }
+}
+
+static bool hd_rumble_is_recommended(int count, bool master_on) {
+    if (!master_on) return false;
+    for (int i = 0; i < count; i++) {
+        const RenHdcOption *o = rh_option_at(i);
+        if (!o || !o->key) continue;
+        int val = o->def;
+        rh_option_get(o->key, &val);
+        if (val != o->def) return false;
+    }
+    return true;
+}
