+        input_hd_set_enabled(cfg_bool("TOTK_HD_RUMBLE"));
+    }
+    bool master_on = cfg_bool("TOTK_HD_RUMBLE") != 0;
+    bool master_off = !master_on;
+    const char *master_note = menu_text(UI_MENU_OFF);
