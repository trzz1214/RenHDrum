+    if (dev_id == 0) return;
+    AcquireSRWLockExclusive(&rh_ds_audio_claim_lock);
+    for (int i = 0; i < RH_MAX_PADS; i++) {
+        if (rh_claimed_audio_devs[i] == dev_id) {
+            rh_claimed_audio_devs[i] = 0;
+        }
+    }
+    ReleaseSRWLockExclusive(&rh_ds_audio_claim_lock);
+}
