+        if (hd_rumble_has_rows(opt_n, 1, INPUT_HD_DEV_XBOX, -1, 1)) {
+            opt_group(UI_MENU_HD_FAM_XBOX);
+            hd_rumble_draw_group(opt_n, 1, 3, INPUT_HD_DEV_XBOX, -1, true, active_dev, active_link,
+                                 master_off, master_note);
+        }
+    }
+
+    ImGui::PopStyleColor(3);
+    ImGui::Dummy(ImVec2(0, 4 * scale));
+    opt_text(UI_MENU_HD_CREDIT, false);
+}
