+                         menu_text(UI_MENU_HD_STEAM_GRIPS_DESC), false);
+        } else {
+            for (int i = 0; i < opt_n; i++) {
+                const RenHdcOption *o = rh_option_at(i);
+                if (!o || !o->key || !strcmp(o->key, "enable_hd_rumble")) continue;
+                if (o->tier != 0 || (o->devices & active_dev) == 0) continue;
+                if (o->link != 0 && o->link != active_link) continue;
+                hd_rumble_option_row(i, 1, active_dev, active_link, master_off, master_note);
+            }
+        }
+    } else {
+        opt_text(UI_MENU_HD_NO_CONTROLLER, false);
+    }
+
+    ImGui::Dummy(ImVec2(0, 4 * scale));
+    const ImGuiStyle &st = ImGui::GetStyle();
+    ImGui::PushStyleColor(ImGuiCol_Header, st.Colors[ImGuiCol_Button]);
+    ImGui::PushStyleColor(ImGuiCol_HeaderHovered, st.Colors[ImGuiCol_ButtonHovered]);
+    ImGui::PushStyleColor(ImGuiCol_HeaderActive, st.Colors[ImGuiCol_ButtonActive]);
+
+    if (ImGui::CollapsingHeader(menu_text(UI_MENU_HD_OTHER))) {
+        static const struct { uint32_t dev; UiTextId title; } families[] = {
+            {INPUT_HD_DEV_SWITCH, UI_MENU_HD_FAM_SWITCH},
+            {INPUT_HD_DEV_DUALSENSE, UI_MENU_HD_FAM_DUALSENSE},
+            {INPUT_HD_DEV_XBOX, UI_MENU_HD_FAM_XBOX},
+            {INPUT_HD_DEV_STEAM, UI_MENU_HD_FAM_STEAM},
+        };
+        for (const auto &f : families) {
+            if (f.dev == active_dev) continue;
+            if (f.dev == INPUT_HD_DEV_STEAM) {
+                opt_group(f.title);
+                if (master_off) opt_disable_next_text(master_note);
+                opt_text_row("##hd_steam_other", menu_text(UI_MENU_HD_STEAM_GRIPS), "", nullptr,
+                             menu_text(UI_MENU_HD_STEAM_GRIPS_DESC), false);
+                continue;
+            }
+            if (!hd_rumble_has_rows(opt_n, 0, f.dev, -1, 0)) continue;
+            opt_group(f.title);
+            for (int i = 0; i < opt_n; i++) {
+                const RenHdcOption *o = rh_option_at(i);
+                if (!o || !o->key || !strcmp(o->key, "enable_hd_rumble")) continue;
+                if (o->tier != 0 || (o->devices & f.dev) == 0) continue;
+                hd_rumble_option_row(i, 2, 0, INPUT_HD_LINK_NONE, master_off, master_note);
+            }
+        }
+    }
+
+    if (ImGui::CollapsingHeader(menu_text(UI_MENU_HD_ADVANCED))) {
+        bool rec = hd_rumble_is_recommended(opt_n, master_on);
+        if (master_off) opt_disable_next_text(master_note);
+        if (opt_button("##hd_reset", UI_MENU_HD_RESET, UI_MENU_HD_RESET_DESC,
+                       menu_text(rec ? UI_MENU_HD_RECOMMENDED : UI_MENU_HD_CUSTOM)) &&
+            master_on) {
+            rh_option_reset();
+            cfg_set("TOTK_HD_RUMBLE", "1");
+            opt_save_soon();
+        }
+        if (hd_rumble_has_rows(opt_n, 1, 15, -1, 1)) {
+            opt_group(UI_MENU_HD_FAM_GENERAL);
+            hd_rumble_draw_group(opt_n, 1, 3, 15, -1, true, active_dev, active_link, master_off, master_note);
+        }
+        if (hd_rumble_has_rows(opt_n, 1, INPUT_HD_DEV_SWITCH, INPUT_HD_LINK_USB, 1)) {
+            opt_group(UI_MENU_HD_FAM_SWITCH_USB);
+            hd_rumble_draw_group(opt_n, 1, 3, INPUT_HD_DEV_SWITCH, INPUT_HD_LINK_USB, true, active_dev, active_link,
+                                 master_off, master_note);
+        }
+        if (hd_rumble_has_rows(opt_n, 1, INPUT_HD_DEV_SWITCH, INPUT_HD_LINK_BT, 1)) {
+            opt_group(UI_MENU_HD_FAM_SWITCH_BT);
+            hd_rumble_draw_group(opt_n, 1, 3, INPUT_HD_DEV_SWITCH, INPUT_HD_LINK_BT, true, active_dev, active_link,
+                                 master_off, master_note);
+        }
+        if (hd_rumble_has_rows(opt_n, 1, INPUT_HD_DEV_DUALSENSE, -1, 1)) {
