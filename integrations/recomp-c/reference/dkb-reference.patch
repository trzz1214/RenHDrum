+void input_hd_pad_info(uint32_t *dev_mask, int *link, char *name, size_t name_cap) {
+    uint32_t mask = 0;
+    int lk = INPUT_HD_LINK_NONE;
+    if (name && name_cap) name[0] = 0;
+    plat_mutex_lock(&lock);
+    if (state == 1 && pad && SDL_GamepadConnected(pad)) {
+        uint16_t vid = SDL_GetGamepadVendor(pad);
+        uint16_t pid = SDL_GetGamepadProduct(pad);
+        SDL_GamepadType gtype = SDL_GetGamepadType(pad);
+        int bt = SDL_GetGamepadConnectionState(pad) == SDL_JOYSTICK_CONNECTION_WIRELESS;
+        if (!is_steam_virtual_pad(pad) && !switch2_owns(SDL_GetGamepadID(pad))) {
+            if (vid == 0x057E && pid == 0x2009) mask = INPUT_HD_DEV_SWITCH;
+            else if (vid == 0x054C && (pid == 0x0CE6 || pid == 0x0DF2)) mask = INPUT_HD_DEV_DUALSENSE;
+            else if (vid == 0x28DE && (pid == 0x1302 || pid == 0x1303 || pid == 0x1304)) mask = INPUT_HD_DEV_STEAM;
+            else if (gtype == SDL_GAMEPAD_TYPE_XBOXONE || vid == 0x045E) mask = INPUT_HD_DEV_XBOX;
+        }
+        if (mask) {
+            lk = bt ? INPUT_HD_LINK_BT : INPUT_HD_LINK_USB;
+            if (name && name_cap) {
+                const char *nm = SDL_GetGamepadName(pad);
+                snprintf(name, name_cap, "%s", nm ? nm : "Controller");
+            }
+        }
+    }
+    plat_mutex_unlock(&lock);
+    if (dev_mask) *dev_mask = mask;
+    if (link) *link = lk;
+}
+
+void input_hd_test_rumble(void) {
