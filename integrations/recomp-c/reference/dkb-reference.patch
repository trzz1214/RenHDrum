+/* ---- Public API ---- */
+void rh_set_switch_gen(int gen) {
+    LONG g = (gen == 1) ? 1 : 2;
+    InterlockedExchange(&rh_switch_gen, g);
+    if (rh.set_nx2_mode) {
+        rh.set_nx2_mode(g == 1 ? 0 : 2);
+    }
+}
