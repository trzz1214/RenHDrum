diff --git a/tests/test_rh_bridge.py b/tests/test_rh_bridge.py
new file mode 100644
index 0000000..b568640
--- /dev/null
+++ b/tests/test_rh_bridge.py
@@ -0,0 +1,466 @@
+"""Unit tests for host/rh_bridge.c (RenHDrum bridge) and Hookshot vibration hooks.
+
+Covers:
+1. Fallback behavior when renhdrum.dll is absent, attach/detach/cleanup safety, audio buffer zeroing.
+2. Step 2a: Per-pad claiming (rh_pad_claimed) + multi-pad non-silencing + hook ordering in pad_sdl.c / nn_hid.c.
+3. Step 2b/2c: Strict major.minor DLL version check and missing renhdrum_version rejection in rh_load.
+4. Step 3: Wired-only 40 ms packet resend (>= 3 repeats in 200 ms), silent packet non-resend, BT Level 4 bridge pass-through.
+
+Run with: python -I -B tests/test_rh_bridge.py
+"""
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+RH_BRIDGE = ROOT / "host" / "rh_bridge.c"
+PAD_SDL = ROOT / "host" / "pad_sdl.c"
+NN_HID = ROOT / "host" / "nn_hid.c"
+REAL_DLL = ROOT / "renhdrum.dll"
+
+COMMON_ENV = dict(os.environ)
+if "msys64" not in COMMON_ENV.get("PATH", "").lower():
+    COMMON_ENV["PATH"] = COMMON_ENV.get("PATH", "") + r";C:\msys64\ucrt64\bin"
+CC = shutil.which(COMMON_ENV.get("CC", "gcc"), path=COMMON_ENV["PATH"]) or COMMON_ENV.get("CC", "gcc")
+
+
+def compile_and_run(tmpdir: Path, c_name: str, src: str, extra_flags=None):
+    c = tmpdir / c_name
+    c.write_text(src, encoding="utf-8")
+    exe = tmpdir / f"{c.stem}.exe"
+    cmd = [
+        CC, "-std=c11", "-Wall", "-Wextra",
+        str(c), str(RH_BRIDGE),
+        "-I", str(ROOT / "host"),
+        "-o", str(exe),
+    ]
+    if extra_flags:
+        cmd.extend(extra_flags)
+    res = subprocess.run(cmd, capture_output=True, text=True, env=COMMON_ENV)
+    if res.returncode != 0:
+        raise AssertionError(f"Compilation failed for {c_name}:\n{res.stderr}")
+    run_res = subprocess.run([str(exe)], capture_output=True, text=True, env=COMMON_ENV, cwd=str(tmpdir))
+    if run_res.returncode != 0:
+        raise AssertionError(f"Execution failed for {c_name} (rc={run_res.returncode}):\nSTDOUT:\n{run_res.stdout}\nSTDERR:\n{run_res.stderr}")
+    return run_res.stdout, run_res.stderr
+
+
+def build_dll(tmpdir: Path, c_name: str, dll_name: str, src: str):
+    c = tmpdir / c_name
+    c.write_text(src, encoding="utf-8")
+    dll = tmpdir / dll_name
+    res = subprocess.run([
+        CC, "-shared", "-std=c11", "-Wall", "-Wextra",
+        str(c), "-o", str(dll),
+    ], capture_output=True, text=True, env=COMMON_ENV)
+    if res.returncode != 0:
+        raise AssertionError(f"DLL compilation failed for {dll_name}:\n{res.stderr}")
+    return dll
+
