+        {
+            std::scoped_lock lock{renhdrum_mutex};
+            if (!xbox_rumble) {
+                return false;
+            }
+            renhdrum_xbox_rumble_push_half_sample(xbox_rumble, now_us, is_right, v.low_amplitude,
+                                                  v.low_frequency, v.high_amplitude,
+                                                  v.high_frequency);
+        }
+        TickXboxRumble(now_us);
+        return true;
+    }
