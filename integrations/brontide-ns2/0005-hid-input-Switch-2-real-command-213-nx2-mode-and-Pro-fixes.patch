+// B017: patent-shaped HD Rumble 2 -> 1 translation (JP 2026015701). Points are guesses.
+static float ApplyNx2MapExplicit(float a, float t, float p1, float p2, float p3, float p4) {
+    if (a < t) {
+        return 0.0f;
+    }
+    if (a >= 1.0f) {
+        return p4;
+    }
+    if (a < 0.1f) {
+        if (0.1f <= t) {
+            return p2;
+        }
+        return p1 + (a - t) * (p2 - p1) / (0.1f - t);
+    }
+    if (a < 0.5f) {
+        return p2 + (a - 0.1f) * (p3 - p2) / (0.5f - 0.1f);
+    }
+    return p3 + (a - 0.5f) * (p4 - p3) / (1.0f - 0.5f);
+}
+
+static float ApplyNx2Map(float a) {
+    const float t = Settings::values.hd_rumble_nx2_t.GetValue() / 1000.0f;
+    const float p1 = Settings::values.hd_rumble_nx2_p1.GetValue() / 1000.0f;
+    const float p2 = Settings::values.hd_rumble_nx2_p2.GetValue() / 1000.0f;
+    const float p3 = Settings::values.hd_rumble_nx2_p3.GetValue() / 1000.0f;
+    const float p4 = Settings::values.hd_rumble_nx2_p4.GetValue() / 1000.0f;
+    return ApplyNx2MapExplicit(a, t, p1, p2, p3, p4);
+}
+
+struct Nx2BoostState {
+    bool was_zero{true};
+    std::chrono::steady_clock::time_point start_time{};
+};
+
+static std::array<std::array<std::array<Nx2BoostState, 2>, 2>, 10> s_nx2_boost_states{};
+static std::mutex s_nx2_boost_mutex;
+
+static float ApplyNx2Boost(std::size_t npad_idx, std::size_t dev_idx, std::size_t band_idx,
+                           float amp, float freq, float boost_factor, int boost_duration_ms,
+                           std::chrono::steady_clock::time_point now) {
+    if (npad_idx >= 10 || dev_idx >= 2 || band_idx >= 2) {
+        return amp;
+    }
+    std::scoped_lock lock{s_nx2_boost_mutex};
+    auto& state = s_nx2_boost_states[npad_idx][dev_idx][band_idx];
+
+    if (amp <= 0.0f) {
+        state.was_zero = true;
+        state.start_time = {};
+        return 0.0f;
+    }
+
+    if (state.was_zero) {
+        state.was_zero = false;
+        if (freq < 150.0f && boost_duration_ms > 0 && boost_factor > 1.0f) {
+            state.start_time = now;
+        } else {
+            state.start_time = {};
+        }
+    }
+
+    if (state.start_time != std::chrono::steady_clock::time_point{}) {
+        const auto elapsed_ms =
+            std::chrono::duration_cast<std::chrono::milliseconds>(now - state.start_time).count();
+        if (elapsed_ms < boost_duration_ms) {
+            amp = (std::min)(1.0f, amp * boost_factor);
+        } else {
+            state.start_time = {};
+        }
+    }
+
+    return amp;
+}
+
+// B017: self-test patent-shaped map against estimated points
+static bool RunNx2MapSelfTest() {
+    const auto approx = [](float val, float expected, float eps = 0.005f) {
+        return std::abs(val - expected) <= eps;
+    };
+    constexpr float t = 0.005f;
+    constexpr float p1 = 0.010f;
+    constexpr float p2 = 0.500f;
+    constexpr float p3 = 0.800f;
+    constexpr float p4 = 1.000f;
+
+    if (ApplyNx2MapExplicit(0.004f, t, p1, p2, p3, p4) != 0.0f) {
+        return false;
+    }
+    if (!approx(ApplyNx2MapExplicit(0.010f, t, p1, p2, p3, p4), 0.036f)) {
+        return false;
+    }
+    if (!approx(ApplyNx2MapExplicit(0.046f, t, p1, p2, p3, p4), 0.223f)) {
+        return false;
+    }
+    if (!approx(ApplyNx2MapExplicit(0.100f, t, p1, p2, p3, p4), 0.500f)) {
+        return false;
+    }
+    if (!approx(ApplyNx2MapExplicit(1.000f, t, p1, p2, p3, p4), 1.000f)) {
+        return false;
+    }
+    return true;
+}
+
+[[maybe_unused]] static float ApplyNx2Curve(float a, float k) {
+    constexpr float knee = 0.02f;
+    if (a <= knee || k >= 1.0f) {
+        return a;
+    }
+    return knee + (1.0f - knee) * std::pow((a - knee) / (1.0f - knee), k);
+}
