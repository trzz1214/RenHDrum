+    // B010 test flag: hdrumble_ounce_mounted.txt next to the exe with 1 answers "mounted".
+    // Read once, then remembered.
+    static const bool flag_read_ok = [] {
+        std::error_code ec;
+        const auto path = Common::FS::GetExeDirectory() / "hdrumble_ounce_mounted.txt";
+        std::ifstream file(path);
+        int value = 0;
+        const bool opened = file.is_open() && std::filesystem::is_regular_file(path, ec);
+        if (opened) {
+            file >> value;
+        }
+        return opened && value == 1;
+    }();
+    static std::atomic<bool> logged{false};
+    if (!logged.exchange(true)) {
+        LOG_INFO(Service_HID, "Vibration 220 IsOunceVibrationDeviceMounted returns {} (flag file {})",
+                 flag_read_ok ? 1 : 0, flag_read_ok ? "found with 1" : "missing or not 1");
+    }
+    *out = flag_read_ok ? 1 : 0;
     R_SUCCEED();
 }
 
