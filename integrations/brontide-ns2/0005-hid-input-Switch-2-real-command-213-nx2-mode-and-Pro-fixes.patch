+Result IHidServer::SendVibrationValueInMode(Core::HID::VibrationDeviceHandle vibration_device_handle,
+                                             u32 mode, Core::HID::VibrationValue vibration_value,
+                                             ClientAppletResourceUserId aruid) {
+    LOG_DEBUG(Service_HID,
+              "called, npad_type={}, npad_id={}, device_index={}, mode={}, "
+              "applet_resource_user_id={}",
+              vibration_device_handle.npad_type, vibration_device_handle.npad_id,
+              vibration_device_handle.device_index, mode, aruid.pid);
+
+    // B010: the 0x20 byte layout (handle 4, mode 4, value 16, aruid 8) is a guess, so the first
+    // call and every mode change print the raw fields to check the field order. If the floats
+    // look absurd, swap handle and mode.
+    static std::atomic<bool> mode_213_seen{false};
+    static std::atomic<u32> last_mode_213{0};
+    if (!mode_213_seen.exchange(true) || last_mode_213.exchange(mode) != mode) {
+        last_mode_213 = mode;
+        LOG_INFO(Service_HID,
+                 "Vibration 213 mode = {}, handle(type={}, npad_id={}, index={}), "
+                 "value=({}, {}, {}, {})",
+                 mode, vibration_device_handle.npad_type, vibration_device_handle.npad_id,
+                 vibration_device_handle.device_index, vibration_value.low_amplitude,
+                 vibration_value.low_frequency, vibration_value.high_amplitude,
+                 vibration_value.high_frequency);
+    }
+
+    // Never an error: rumble is best effort and the layout is only known from captures.
+    const auto result =
+        GetResourceManager()->SendVibrationValue(aruid.pid, vibration_device_handle, vibration_value);
+    if (result.IsError()) {
+        LOG_DEBUG(Service_HID, "failed to send vibration 213, result={:#x}", result.raw);
+    }
     R_SUCCEED();
 }
 
