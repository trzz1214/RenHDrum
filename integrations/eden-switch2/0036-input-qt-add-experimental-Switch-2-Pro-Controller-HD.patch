+        std::array<std::uint8_t, RENHDRUM_PRO2_REPORT_SIZE> probe{};
+        if (pro2_api.pro2_silent_report(handle, probe.data()) != RENHDRUM_OK ||
+            !SendPro2Effect(gamepad, joystick, probe)) {
