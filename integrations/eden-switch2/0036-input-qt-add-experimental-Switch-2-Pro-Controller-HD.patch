@@ -1416,6 +1463,58 @@ std::shared_ptr<RenHDrumPad> RenHDrumPad::Create(SDL_Joystick* joystick, SDL_Gam
     }
     const Uint16 vid = SDL_GetJoystickVendor(joystick);
     const Uint16 pid = SDL_GetJoystickProduct(joystick);
+    if (IsSwitch2ProController(vid, pid)) {
+        if (SDL_GetJoystickConnectionState(joystick) == SDL_JOYSTICK_CONNECTION_WIRELESS) {
+            LOG_INFO(Input, "RenHDrum: Switch 2 Pro Controller over Bluetooth is not supported yet, "
+                            "using the standard rumble");
+            return nullptr;
+        }
+        const auto& pro2_api = Api();
+        if (!pro2_api.HasPro2()) {
