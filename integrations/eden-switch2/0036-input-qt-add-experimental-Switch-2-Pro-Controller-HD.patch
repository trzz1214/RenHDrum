+
+bool SendPro2Effect(SDL_Gamepad* gamepad, SDL_Joystick* joystick,
+                    const std::array<std::uint8_t, RENHDRUM_PRO2_REPORT_SIZE>& report) {
+    if (gamepad) {
+        return SDL_SendGamepadEffect(gamepad, report.data(), static_cast<int>(report.size()));
+    }
+    return SDL_SendJoystickEffect(joystick, report.data(), static_cast<int>(report.size()));
+}
+
 /// Xbox One / Series and Xbox 360 style pads, Microsoft's or not (GameSir, 8BitDo, PowerA...).
 /// RenHDrum's converter was tuned on an Xbox One S; others get the same four-motor mix, and
 /// a pad whose path has no trigger motors (XInput) keeps only the grips.
@@ -339,7 +368,7 @@ UserSettings ReadUserSettings(const RenHdcStore* s) {
 }
 
