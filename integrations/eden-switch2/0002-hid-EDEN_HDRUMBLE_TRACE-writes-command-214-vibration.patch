Subject: [PATCH 2/9] hid: EDEN_HDRUMBLE_TRACE writes command 214 vibration
 values to a CSV

Feito com Claude Code
---
 src/core/hle/service/hid/hid_server.cpp | 84 +++++++++++++++++++++++++
 1 file changed, 84 insertions(+)

diff --git a/src/core/hle/service/hid/hid_server.cpp b/src/core/hle/service/hid/hid_server.cpp
index f2a7b7d..232f38c 100644
--- a/src/core/hle/service/hid/hid_server.cpp
+++ b/src/core/hle/service/hid/hid_server.cpp
@@ -7,7 +7,15 @@
 #include <algorithm>
 #include <array>
 
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <mutex>
+
 #include "common/common_types.h"
+#include "common/fs/path_util.h"
 #include "common/logging.h"
 #include "common/settings.h"
 #include "core/hle/kernel/k_shared_memory.h"
@@ -1113,6 +1121,78 @@ Result IHidServer::IsVibrationDeviceMounted(
     R_SUCCEED();
 }
 
+namespace {
+// EDEN_HDRUMBLE_TRACE=1 (environment or nx2_switches.txt): every change of a vibration value sent
+// through command 214 goes to <log dir>/hdrumble_trace.csv, for studying a game's HD Rumble.
+class Nx2VibrationTrace {
+public:
+    static Nx2VibrationTrace& Instance() {
+        static Nx2VibrationTrace trace;
+        return trace;
+    }
+
+    bool Enabled() const {
+        return file != nullptr;
+    }
+
+    void Record(u64 mode, const Core::HID::VibrationDeviceHandle& handle,
+                const Core::HID::VibrationValue& value) {
+        std::scoped_lock lock{mutex};
+        if (!file || lines >= MaxLines) {
+            return;
+        }
+        const u32 key = (static_cast<u32>(handle.npad_id) << 8) |
+                        static_cast<u32>(handle.device_index);
+        auto& last = last_values[key];
+        if (std::memcmp(&last, &value, sizeof(value)) == 0) {
+            return;
+        }
+        last = value;
+        const auto now = std::chrono::steady_clock::now();
+        const double ms = std::chrono::duration<double, std::milli>(now - start).count();
+        std::fprintf(file, "%.3f,%llu,%u,%u,%u,%.4f,%.2f,%.4f,%.2f\n", ms,
+                     static_cast<unsigned long long>(mode), static_cast<u32>(handle.npad_type),
+                     static_cast<u32>(handle.npad_id), static_cast<u32>(handle.device_index),
+                     value.low_amplitude, value.low_frequency, value.high_amplitude,
+                     value.high_frequency);
+        if (++lines % 256 == 0) {
+            std::fflush(file);
+        }
+    }
+
+    ~Nx2VibrationTrace() {
+        if (file) {
+            std::fclose(file);
+        }
+    }
+
+private:
+    Nx2VibrationTrace() {
+        const char* env = std::getenv("EDEN_HDRUMBLE_TRACE");
+        if (!env || std::strcmp(env, "1") != 0) {
+            return;
+        }
+        const auto path =
+            Common::FS::GetEdenPath(Common::FS::EdenPath::LogDir) / "hdrumble_trace.csv";
+        file = std::fopen(path.string().c_str(), "w");
+        if (!file) {
+            LOG_ERROR(Service_HID, "HD Rumble trace: could not open {}", path.string());
+            return;
+        }
+        std::fputs("ms,mode,npad_type,npad_id,device_index,low_amp,low_freq,high_amp,high_freq\n",
+                   file);
+        LOG_INFO(Service_HID, "HD Rumble trace: writing {}", path.string());
+    }
+
+    static constexpr u64 MaxLines = 3'000'000;
+    std::mutex mutex;
+    std::FILE* file{};
+    u64 lines{};
+    std::map<u32, Core::HID::VibrationValue> last_values;
+    std::chrono::steady_clock::time_point start{std::chrono::steady_clock::now()};
+};
+} // namespace
+
 Result IHidServer::SendNx2VibrationValues(
     u64 unknown, AppletResourceUserId aruid,
     InArray<Core::HID::VibrationDeviceHandle, BufferAttr_HipcPointer> vibration_handles,
@@ -1123,7 +1203,11 @@ Result IHidServer::SendNx2VibrationValues(
     // captures, so an unexpected handle or layout shouldn't return an error a game may treat as
     // fatal.
     const auto count = (std::min)(vibration_handles.size(), vibration_values.size());
+    auto& trace = Nx2VibrationTrace::Instance();
     for (std::size_t i = 0; i < count; i++) {
+        if (trace.Enabled()) {
+            trace.Record(unknown, vibration_handles[i], vibration_values[i]);
+        }
         const auto result = GetResourceManager()->SendVibrationValue(
             aruid.pid, vibration_handles[i], vibration_values[i]);
         if (result.IsError()) {
