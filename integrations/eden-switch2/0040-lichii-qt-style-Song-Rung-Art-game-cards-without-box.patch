 GameCard::GameCard(QObject* parent) : QStyledItemDelegate{parent} {
     setObjectName("GameCard");
 }
 
+QRectF GameCard::artCoverRect(const QStyleOptionViewItem& option, const QModelIndex& index,
+                              bool lifted) const {
+    const u32 raw_icon_size = UISettings::values.game_cover_size.GetValue();
+    const int icon_size =
+        raw_icon_size == 0 ? std::max(64, option.rect.width() - 64) : static_cast<int>(raw_icon_size);
+
+    QSizeF cover_size(icon_size, icon_size);
+    const QPixmap icon_pixmap = index.data(Qt::DecorationRole).value<QPixmap>();
+    if (!icon_pixmap.isNull()) {
+        QSize scaled = icon_pixmap.size();
+        scaled.scale(icon_size, icon_size, Qt::KeepAspectRatio);
+        cover_size = QSizeF(scaled);
+    }
+
+    qreal slot_left = option.rect.left();
+    qreal slot_width = option.rect.width();
+    qreal base_top = option.rect.top() + kArtTopClearance;
+
+    if (m_columns >= 1) {
+        const int cell_width = option.rect.width();
+        const int card_width = cell_width - m_padding;
+        const int column = index.row() % m_columns;
+        const int row_width = m_columns * cell_width;
+        const int total_gap = row_width - cardMargin * 2 - m_columns * card_width;
+        const int gap = (m_columns > 1) ? (total_gap / (m_columns - 1)) : 0;
+        slot_left = option.rect.left() - column * cell_width + cardMargin +
+                    column * (card_width + gap) + 4;
+        slot_width = card_width - cardMargin;
+    } else {
+        const int content_top =
+            option.rect.top() + std::max(0, (option.rect.height() - m_contentSize.height()) / 2);
+        base_top = content_top + kArtTopClearance;
+    }
+
+    const qreal cover_x = slot_left + (slot_width - cover_size.width()) * 0.5;
+    const qreal cover_y = base_top - (lifted ? kArtLiftPx : 0);
+    return QRectF(cover_x, cover_y, cover_size.width(), cover_size.height());
+}
+
+void GameCard::paintArt(QPainter* painter, const QStyleOptionViewItem& option,
+                        const QModelIndex& index) const {
+    painter->save();
+    painter->setRenderHint(QPainter::Antialiasing, true);
+    painter->setRenderHint(QPainter::SmoothPixmapTransform, true);
+
+    const bool dark = UISettings::IsDarkTheme();
+    const RenHDrumQt::PaletteTokens t = RenHDrumQt::Tokens(dark);
+    const bool selected = (option.state & QStyle::State_Selected) != 0;
+    const bool hovered = (option.state & QStyle::State_MouseOver) != 0;
+
+    const QRectF baseRect = artCoverRect(option, index, false);
+    const QRectF coverRect =
+        selected ? baseRect.translated(0.0, -static_cast<qreal>(kArtLiftPx)) : baseRect;
+
+    const int shadow_pad = kArtShadowBlur + 8;
+    const QString shadow_key = QStringLiteral("art_shadow:%1x%2:%3")
+                                   .arg(static_cast<int>(std::ceil(coverRect.width())))
+                                   .arg(static_cast<int>(std::ceil(coverRect.height())))
+                                   .arg(dark ? 1 : 0);
+    const QPixmap shadow = CachedBlurredRoundedBox(
+        shadow_key, coverRect.size(), kCardRadius, kArtShadowBlur, shadow_pad,
+        QColor(0, 0, 0, dark ? kArtShadowAlphaDark : kArtShadowAlphaLight));
+    if (!shadow.isNull()) {
+        painter->drawPixmap(coverRect.topLeft() + QPointF(-shadow_pad, -shadow_pad + kArtShadowOffsetY),
+                            shadow);
+    }
+
+    if (selected) {
+        const int glow_pad = kArtGlowRadius + 8;
+        QColor glow_color = t.accent;
+        glow_color.setAlphaF(kArtGlowAlpha);
+        const QString glow_key = QStringLiteral("art_glow:%1x%2:%3")
+                                     .arg(static_cast<int>(std::ceil(coverRect.width())))
+                                     .arg(static_cast<int>(std::ceil(coverRect.height())))
+                                     .arg(glow_color.rgba(), 0, 16);
+        const QPixmap glow = CachedBlurredRoundedBox(
+            glow_key, coverRect.size(), kCardRadius + kArtRingOffset, kArtGlowRadius, glow_pad,
+            glow_color);
+        if (!glow.isNull()) {
+            painter->drawPixmap(coverRect.topLeft() + QPointF(-glow_pad, -glow_pad), glow);
+        }
+    }
+
+    QPainterPath cardPath;
+    cardPath.addRoundedRect(coverRect, kCardRadius, kCardRadius);
+
+    const QPixmap icon_pixmap = index.data(Qt::DecorationRole).value<QPixmap>();
+    painter->save();
+    painter->setClipPath(cardPath);
+    if (icon_pixmap.isNull()) {
+        painter->fillPath(cardPath, t.surface_raised);
+    } else {
+        if (icon_pixmap.hasAlphaChannel()) {
+            painter->fillPath(cardPath, t.surface);
+        }
+        painter->drawPixmap(coverRect, icon_pixmap, QRectF(icon_pixmap.rect()));
+    }
+    QPainterPath innerPath;
+    innerPath.addRoundedRect(coverRect.adjusted(0.5, 0.5, -0.5, -0.5), kCardRadius - 0.5,
+                             kCardRadius - 0.5);
+    painter->setBrush(Qt::NoBrush);
+    painter->setPen(QPen(QColor(255, 255, 255, kArtInnerBorderAlpha), 1.0));
+    painter->drawPath(innerPath);
+    painter->restore();
+
+    if (selected) {
+        const qreal expand = kArtRingOffset + kArtRingWidth * 0.5;
+        const QRectF ringRect = coverRect.adjusted(-expand, -expand, expand, expand);
+        painter->setBrush(Qt::NoBrush);
+        painter->setPen(QPen(t.accent, kArtRingWidth));
+        painter->drawRoundedRect(ringRect, kCardRadius + expand, kCardRadius + expand);
+    } else if (hovered) {
+        const qreal expand = kArtRingOffset + kArtHoverRingWidth * 0.5;
+        const QRectF ringRect = coverRect.adjusted(-expand, -expand, expand, expand);
+        const QColor hoverColor =
+            dark ? QColor(255, 255, 255, kArtHoverRingAlpha)
+                 : QColor(t.text.red(), t.text.green(), t.text.blue(), kArtHoverRingAlpha);
+        painter->setBrush(Qt::NoBrush);
+        painter->setPen(QPen(hoverColor, kArtHoverRingWidth));
+        painter->drawRoundedRect(ringRect, kCardRadius + expand, kCardRadius + expand);
+    }
+
+    if (UISettings::values.show_game_name.GetValue()) {
+        const u32 icon_size = UISettings::values.game_cover_size.GetValue();
+        const qreal text_width = std::min<qreal>(
+            std::max<qreal>(baseRect.width() + 16.0, 96.0),
+            static_cast<qreal>(option.rect.width()) - 8.0);
+        const qreal text_left = baseRect.center().x() - text_width * 0.5;
+        const qreal text_top = baseRect.bottom() + kArtTitleGap;
+        const QRectF textRect(text_left, text_top, text_width,
+                              std::max<qreal>(16.0, option.rect.bottom() - text_top));
+
+        const QString title = index.data(Qt::DisplayRole).toString().split(QLatin1Char('\n')).first();
+
+        QFont font = RenHDrumQt::UiFont(9.5);
+        font.setWeight(selected ? QFont::Bold : QFont::Normal);
+        font.setPixelSize(
+            std::max(11.0, std::sqrt(static_cast<double>(icon_size == 0 ? 96 : icon_size))));
+        painter->setFont(font);
+        painter->setPen(selected ? t.text : t.muted);
+
+        const QFontMetrics fm(font);
+        QTextOption text_option;
+        text_option.setWrapMode(QTextOption::WrapAtWordBoundaryOrAnywhere);
+        QTextLayout layout(title, font);
+        layout.setTextOption(text_option);
+        QStringList lines;
+        layout.beginLayout();
+        for (int i = 0; i < 2; ++i) {
+            QTextLine line = layout.createLine();
+            if (!line.isValid()) {
+                break;
+            }
+            line.setLineWidth(textRect.width());
+            lines.append(i == 0 ? title.mid(line.textStart(), line.textLength()).trimmed()
+                                : fm.elidedText(title.mid(line.textStart()).trimmed(),
+                                                Qt::ElideRight,
+                                                static_cast<int>(textRect.width())));
+        }
+        layout.endLayout();
+        painter->drawText(textRect, Qt::AlignHCenter | Qt::AlignTop,
+                          lines.join(QLatin1Char('\n')));
+    }
+
+    painter->restore();
+}
+
 void GameCard::paint(QPainter* painter, const QStyleOptionViewItem& option,
                      const QModelIndex& index) const {
     if (!index.isValid())
         return;
 
+    if (IsSongRungArt()) {
+        paintArt(painter, option, index);
+        return;
+    }
+
     painter->save();
     painter->setRenderHint(QPainter::Antialiasing);
 
@@ -110,6 +407,14 @@ void GameCard::paint(QPainter* painter, const QStyleOptionViewItem& option,
 }
 
 QRect GameCard::getCardRect(const QStyleOptionViewItem& option, const QModelIndex& index) const {
+    if (IsSongRungArt()) {
+        const QRectF base = artCoverRect(option, index, false);
+        const int title_extra = UISettings::values.show_game_name.GetValue() ? 48 : 8;
+        return QRectF(base.left() - 6.0, base.top() - kArtLiftPx - 6.0, base.width() + 12.0,
+                      base.height() + kArtLiftPx + 6.0 + title_extra)
+            .toAlignedRect();
+    }
+
     const int cell_width = option.rect.width();
 
     const int card_width = cell_width - m_padding;
