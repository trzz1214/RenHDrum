+namespace {
+
+// tune after review
+constexpr qreal kCardRadius = 12.0;
+constexpr int kArtLiftPx = 8;
+constexpr qreal kArtRingOffset = 3.0;
+constexpr qreal kArtRingWidth = 2.0;
+constexpr qreal kArtHoverRingWidth = 1.5;
+constexpr qreal kArtGlowAlpha = 0.45;
+constexpr int kArtGlowRadius = 24;
+constexpr int kArtInnerBorderAlpha = 56;
+constexpr int kArtHoverRingAlpha = 90;
+constexpr int kArtShadowBlur = 16;
+constexpr int kArtShadowAlphaDark = 145;
+constexpr int kArtShadowAlphaLight = 72;
+constexpr int kArtShadowOffsetY = 6;
+constexpr int kArtTopClearance = 24;
+constexpr int kArtTitleGap = 10;
+
+QImage BlurArgbPremultiplied(const QImage& source, int radius) {
+    if (source.isNull() || radius <= 0) {
+        return source;
+    }
+    QImage img = source.convertToFormat(QImage::Format_ARGB32_Premultiplied);
+    const int w = img.width();
+    const int h = img.height();
+    QImage tmp(w, h, QImage::Format_ARGB32_Premultiplied);
+
+    // 3-pass separable box blur approximates a smooth Gaussian kernel.
+    const int box = std::max(1, (radius * 2) / 3);
+    const int half = box / 2;
+    const int span = half * 2 + 1;
+
+    std::vector<u32> line_buf(static_cast<size_t>(std::max(w, h)));
+
+    for (int pass = 0; pass < 3; ++pass) {
+        // Horizontal pass: img -> tmp
+        for (int y = 0; y < h; ++y) {
+            const auto* src = reinterpret_cast<const QRgb*>(img.constScanLine(y));
+            auto* dst = reinterpret_cast<QRgb*>(tmp.scanLine(y));
+            int sum_a = 0, sum_r = 0, sum_g = 0, sum_b = 0;
+            for (int k = -half; k <= half; ++k) {
+                const int sx = std::clamp(k, 0, w - 1);
+                const QRgb px = src[sx];
+                sum_a += qAlpha(px);
+                sum_r += qRed(px);
+                sum_g += qGreen(px);
+                sum_b += qBlue(px);
+            }
+            for (int x = 0; x < w; ++x) {
+                dst[x] = qRgba(sum_r / span, sum_g / span, sum_b / span, sum_a / span);
+                const int out_x = std::clamp(x - half, 0, w - 1);
+                const int in_x = std::clamp(x + half + 1, 0, w - 1);
+                const QRgb p_out = src[out_x];
+                const QRgb p_in = src[in_x];
+                sum_a += qAlpha(p_in) - qAlpha(p_out);
+                sum_r += qRed(p_in) - qRed(p_out);
+                sum_g += qGreen(p_in) - qGreen(p_out);
+                sum_b += qBlue(p_in) - qBlue(p_out);
+            }
+        }
+        // Vertical pass: tmp -> img
+        for (int x = 0; x < w; ++x) {
+            for (int y = 0; y < h; ++y) {
+                line_buf[static_cast<size_t>(y)] =
+                    reinterpret_cast<const QRgb*>(tmp.constScanLine(y))[x];
+            }
+            int sum_a = 0, sum_r = 0, sum_g = 0, sum_b = 0;
+            for (int k = -half; k <= half; ++k) {
+                const int sy = std::clamp(k, 0, h - 1);
+                const QRgb px = line_buf[static_cast<size_t>(sy)];
+                sum_a += qAlpha(px);
+                sum_r += qRed(px);
+                sum_g += qGreen(px);
+                sum_b += qBlue(px);
+            }
+            for (int y = 0; y < h; ++y) {
+                reinterpret_cast<QRgb*>(img.scanLine(y))[x] =
+                    qRgba(sum_r / span, sum_g / span, sum_b / span, sum_a / span);
+                const int out_y = std::clamp(y - half, 0, h - 1);
+                const int in_y = std::clamp(y + half + 1, 0, h - 1);
+                const QRgb p_out = line_buf[static_cast<size_t>(out_y)];
+                const QRgb p_in = line_buf[static_cast<size_t>(in_y)];
+                sum_a += qAlpha(p_in) - qAlpha(p_out);
+                sum_r += qRed(p_in) - qRed(p_out);
+                sum_g += qGreen(p_in) - qGreen(p_out);
+                sum_b += qBlue(p_in) - qBlue(p_out);
+            }
+        }
+    }
+    return img;
+}
+
+QPixmap CachedBlurredRoundedBox(const QString& key, const QSizeF& box_size, qreal radius,
+                                int blur_radius, int pad, const QColor& color) {
+    QPixmap pix;
+    if (QPixmapCache::find(key, &pix)) {
+        return pix;
+    }
+    const int w = std::max(1, static_cast<int>(std::ceil(box_size.width()))) + pad * 2;
+    const int h = std::max(1, static_cast<int>(std::ceil(box_size.height()))) + pad * 2;
+    QImage canvas(w, h, QImage::Format_ARGB32_Premultiplied);
+    canvas.fill(Qt::transparent);
+    {
+        QPainter p(&canvas);
+        p.setRenderHint(QPainter::Antialiasing, true);
+        p.setPen(Qt::NoPen);
+        p.setBrush(color);
+        p.drawRoundedRect(QRectF(pad, pad, box_size.width(), box_size.height()), radius, radius);
+    }
+    pix = QPixmap::fromImage(BlurArgbPremultiplied(canvas, blur_radius));
+    QPixmapCache::insert(key, pix);
+    return pix;
+}
+
