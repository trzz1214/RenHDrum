 #include "lichii/game/common.h"
 #include "lichii/game/game_card.h"
@@ -57,6 +58,26 @@ void GameGrid::ApplyFilter(const QString& edit_filter_text, GameListModel* model
 void GameGrid::UpdateIconSize() {
     const u32 icon_size = UISettings::values.game_cover_size.GetValue();
 
+    if (IsSongRungArt()) {
+        const int effective_icon = icon_size == 0 ? 96 : static_cast<int>(icon_size);
+        constexpr int widthMargin = 48;
+        const int heightMargin = UISettings::values.show_game_name ? (24 + 10 + 42) : (24 + 20);
+
+        const int view_width = viewport()->width();
+        const double spacing = 0.01;
+        const int min_item_width = effective_icon + widthMargin;
+        const int columns = std::max(1, (view_width - 16) / min_item_width);
+        const int stretched_width = ((view_width) - (spacing * (columns - 1))) / columns;
+
+        const QSize grid_size(stretched_width, effective_icon + heightMargin);
+        setUpdatesEnabled(false);
+        setGridSize(grid_size);
+        m_gameCard->setSize(grid_size, grid_size, stretched_width - min_item_width, columns);
+        setUpdatesEnabled(true);
+        viewport()->update();
+        return;
+    }
+
     int heightMargin = 0;
     // The card hugs the icon; the title wraps to the icon's width, so extra width is only
     // needed for the "no icon" case. Leftover row space becomes the gap between cards.
