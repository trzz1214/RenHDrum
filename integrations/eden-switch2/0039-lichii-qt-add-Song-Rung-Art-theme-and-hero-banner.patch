+namespace {
+
+// tune after review
+constexpr qreal kHeroHeightRatio = 0.55;
+constexpr int kHeroMinHeight = 240;
+constexpr int kHeroShelfReserveMin = 140;
+constexpr int kHeroFadeMs = 250;
+constexpr qreal kHeroCropFocusY = 1.0 / 3.0;
+constexpr qreal kHeroTitlePointSize = 30.0;
+
+constexpr qreal kOverlayAlphaTop = 0.55;
+constexpr qreal kOverlayAlphaUpper = 0.10;
+constexpr qreal kOverlayAlphaMid = 0.25;
+constexpr qreal kOverlayAlphaBottom = 0.94;
+constexpr qreal kOverlayStopUpper = 0.22;
+constexpr qreal kOverlayStopMid = 0.55;
+
+QColor WithAlphaF(QColor c, qreal alpha) {
+    c.setAlphaF(alpha);
+    return c;
+}
+
+void PaintHeroGradient(QPainter& painter, const QSize& size, const QColor& window_color) {
+    QLinearGradient overlay(0, 0, 0, size.height());
+    overlay.setColorAt(0.0, WithAlphaF(window_color, kOverlayAlphaTop));
+    overlay.setColorAt(kOverlayStopUpper, WithAlphaF(window_color, kOverlayAlphaUpper));
+    overlay.setColorAt(kOverlayStopMid, WithAlphaF(window_color, kOverlayAlphaMid));
+    overlay.setColorAt(1.0, WithAlphaF(window_color, kOverlayAlphaBottom));
+    painter.fillRect(QRect(QPoint(0, 0), size), overlay);
+}
+
+QPixmap RenderBlurredCover(const QPixmap& source, const QSize& size, const QColor& window_color,
+                           bool dark) {
+    QPixmap out(size);
+    out.fill(window_color);
+    if (source.isNull() || size.isEmpty()) {
+        return out;
+    }
+
+    QPainter painter(&out);
+    painter.setRenderHint(QPainter::SmoothPixmapTransform);
+
+    const QColor average = source.scaled(1, 1, Qt::IgnoreAspectRatio, Qt::SmoothTransformation)
+                               .toImage()
+                               .pixelColor(0, 0);
+    QRadialGradient glow(QPointF(size.width() * 0.5, size.height() * 0.28), size.width() * 0.72);
+    QColor glow_color = dark ? average.darker(175) : average;
+    glow_color.setAlpha(dark ? 125 : 85);
+    glow.setColorAt(0.0, glow_color);
+    glow.setColorAt(1.0, Qt::transparent);
+    painter.fillRect(out.rect(), glow);
+
+    const QPixmap tiny = source.scaledToWidth(24, Qt::SmoothTransformation)
+                             .scaledToWidth(96, Qt::SmoothTransformation);
+    const QSize expanded = size * 1.25;
+    const QPixmap blurred =
+        tiny.scaled(expanded, Qt::KeepAspectRatioByExpanding, Qt::SmoothTransformation);
+    painter.setOpacity(dark ? 0.42 : 0.30);
+    painter.drawPixmap((size.width() - blurred.width()) / 2,
+                       (size.height() - blurred.height()) / 2, blurred);
+    painter.setOpacity(1.0);
+    return out;
+}
+
+} // namespace
+
+HeroBanner::HeroBanner(QWidget* parent) : QWidget{parent} {
+    setAttribute(Qt::WA_OpaquePaintEvent, true);
+    setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Fixed);
+
+    fade.setStartValue(0.0);
+    fade.setEndValue(1.0);
+    fade.setDuration(kHeroFadeMs);
+    fade.setEasingCurve(QEasingCurve::OutCubic);
+    connect(&fade, &QVariantAnimation::valueChanged, this, [this] { update(); });
+    connect(&fade, &QVariantAnimation::finished, this, [this] { previous_pixmap = {}; });
+
+    auto* const root = new QVBoxLayout(this);
+    root->setContentsMargins(32, 16, 32, 20);
+    root->setSpacing(6);
+    root->addStretch(1);
+
+    title_label = new QLabel(this);
+    title_label->setWordWrap(false);
+    title_label->setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Preferred);
+    title_label->setAttribute(Qt::WA_TransparentForMouseEvents, true);
+    root->addWidget(title_label);
+
+    meta_label = new QLabel(this);
+    meta_label->setWordWrap(false);
+    meta_label->setAttribute(Qt::WA_TransparentForMouseEvents, true);
+    meta_label->hide();
+    root->addWidget(meta_label);
+
+    auto* const buttons = new QHBoxLayout;
+    buttons->setContentsMargins(0, 6, 0, 0);
+    buttons->setSpacing(10);
+
+    play_button = new QPushButton(tr("Play"), this);
+    play_button->setProperty("songRungPrimary", true);
+    play_button->setCursor(Qt::PointingHandCursor);
+    play_button->setMinimumWidth(100);
+    connect(play_button, &QPushButton::clicked, this, &HeroBanner::PlayClicked);
+    buttons->addWidget(play_button);
+
+    change_art_button = new QPushButton(tr("Change Art\u2026"), this);
+    change_art_button->setCursor(Qt::PointingHandCursor);
+    connect(change_art_button, &QPushButton::clicked, this, &HeroBanner::ChangeArtClicked);
+    buttons->addWidget(change_art_button);
+    buttons->addStretch(1);
+
+    root->addLayout(buttons);
+
+    title_label->hide();
+    play_button->hide();
+    change_art_button->hide();
+
+    ApplyThemeStyles();
+}
+
+int HeroBanner::ComputeHeight(int available_height) {
+    if (available_height <= 0) {
+        return kHeroMinHeight;
+    }
+    const int desired =
+        std::max(kHeroMinHeight, static_cast<int>(std::lround(available_height * kHeroHeightRatio)));
+    if (available_height <= kHeroShelfReserveMin) {
+        return std::max(0, available_height);
+    }
+    return std::min(desired, available_height - kHeroShelfReserveMin);
+}
+
+void HeroBanner::SetGame(u64 program_id, const QString& title, const QString& meta,
+                         const QPixmap& fallback) {
+    const bool same_game = (program_id == current_program_id && current_program_id != 0);
+    if (same_game && title == current_title && meta == current_meta &&
+        fallback.cacheKey() == fallback_cover.cacheKey()) {
+        return;
+    }
+
+    const QPixmap prev = CurrentComposedPixmap();
+    const bool game_changed = (program_id != current_program_id) ||
+                              (fallback.cacheKey() != fallback_cover.cacheKey());
+
+    current_program_id = program_id;
+    current_title = title;
+    current_meta = meta;
+    fallback_cover = fallback;
+
+    if (!same_game) {
+        ReloadHeroFromDisk();
+    }
+
+    const bool has_game = (current_program_id != 0 || !current_title.isEmpty());
+    title_label->setVisible(has_game);
+    play_button->setVisible(has_game);
+    change_art_button->setVisible(current_program_id != 0);
+    meta_label->setText(current_meta);
+    meta_label->setVisible(has_game && !current_meta.isEmpty());
+    UpdateTitleText();
+
+    if (game_changed && !prev.isNull() && isVisible()) {
+        previous_pixmap = prev;
+        fade.stop();
+        fade.start();
+    }
+    update();
+}
+
+void HeroBanner::SetTitle(u64 program_id, const QString& title) {
+    if (program_id == 0 || program_id != current_program_id || title == current_title) {
+        return;
+    }
+    current_title = title;
+    UpdateTitleText();
+}
+
+void HeroBanner::InvalidateHero(u64 program_id) {
+    if (program_id == 0) {
+        return;
+    }
+    hero_generations[program_id] = hero_generations.value(program_id, 0) + 1;
+    if (program_id != current_program_id) {
+        return;
+    }
+    const QPixmap prev = CurrentComposedPixmap();
+    ReloadHeroFromDisk();
+    if (!prev.isNull() && isVisible()) {
+        previous_pixmap = prev;
+        fade.stop();
+        fade.start();
+    }
+    update();
+}
+
+void HeroBanner::RefreshTheme() {
+    previous_pixmap = {};
+    ApplyThemeStyles();
+    update();
+}
+
+void HeroBanner::ReloadHeroFromDisk() {
+    raw_hero = {};
+    if (current_program_id == 0) {
+        return;
+    }
+    const std::vector<u8> bytes = QtCommon::Game::ReadCustomHero(current_program_id);
+    if (!bytes.empty()) {
+        raw_hero.loadFromData(bytes.data(), static_cast<uint>(bytes.size()));
+    }
+}
+
+void HeroBanner::UpdateTitleText() {
+    if (!title_label) {
+        return;
+    }
+    const int avail = std::max(120, width() - 64);
+    const QFontMetrics fm(title_label->font());
+    title_label->setText(fm.elidedText(current_title, Qt::ElideRight, avail));
+}
+
+bool HeroBanner::EffectiveDark() const {
+    return UISettings::IsDarkTheme();
+}
+
+void HeroBanner::ApplyThemeStyles() {
+    const bool dark = EffectiveDark();
+    const RenHDrumQt::PaletteTokens t = RenHDrumQt::Tokens(dark);
+
+    QFont title_font = RenHDrumQt::UiFont(kHeroTitlePointSize);
+    title_font.setWeight(QFont::Bold);
+    title_label->setFont(title_font);
+    title_label->setStyleSheet(QStringLiteral("color: %1; background: transparent;").arg(t.text.name()));
+
+    auto* const shadow = new QGraphicsDropShadowEffect(title_label);
+    shadow->setBlurRadius(dark ? 16 : 10);
+    shadow->setOffset(0, dark ? 2 : 1);
+    shadow->setColor(dark ? QColor(0, 0, 0, 195) : QColor(255, 255, 255, 200));
+    title_label->setGraphicsEffect(shadow);
+
+    QFont meta_font = RenHDrumQt::UiFont(10.0);
+    meta_font.setWeight(QFont::Medium);
+    meta_label->setFont(meta_font);
+    meta_label->setStyleSheet(QStringLiteral("color: %1; background: transparent;").arg(t.muted.name()));
+
+    if (play_button) {
+        play_button->setFont(RenHDrumQt::UiFont(10.0));
+        if (play_button->style()) {
+            play_button->style()->unpolish(play_button);
+            play_button->style()->polish(play_button);
+        }
+    }
+
+    if (change_art_button) {
+        change_art_button->setFont(RenHDrumQt::UiFont(9.5));
+        const QString bg = dark ? QStringLiteral("rgba(32, 30, 28, 178)")
+                                : QStringLiteral("rgba(255, 255, 255, 205)");
+        const QString hover_bg = dark ? QStringLiteral("rgba(48, 44, 40, 220)")
+                                      : QStringLiteral("rgba(253, 235, 214, 235)");
+        const QString border = dark ? QStringLiteral("rgba(255, 255, 255, 42)")
+                                    : QStringLiteral("rgba(30, 27, 24, 38)");
+        change_art_button->setStyleSheet(
+            QStringLiteral("QPushButton {"
+                           "  background-color: %1;"
+                           "  color: %2;"
+                           "  border: 1px solid %3;"
+                           "  border-radius: 5px;"
+                           "  padding: 5px 14px;"
+                           "  min-height: 26px;"
+                           "}"
+                           "QPushButton:hover {"
+                           "  background-color: %4;"
+                           "  border-color: %5;"
+                           "}")
+                .arg(bg, t.text.name(), border, hover_bg, t.accent.name()));
+    }
+}
+
+QString HeroBanner::CacheKey(const QSize& logical_size, qreal dpr, bool dark) const {
+    const int dpr_pct = static_cast<int>(std::lround(dpr * 100.0));
+    if (!raw_hero.isNull()) {
+        const u64 gen = hero_generations.value(current_program_id, 0);
+        return QStringLiteral("hero:%1:%2x%3:%4:%5:%6")
+            .arg(current_program_id, 0, 16)
+            .arg(logical_size.width())
+            .arg(logical_size.height())
+            .arg(dpr_pct)
+            .arg(dark ? 1 : 0)
+            .arg(gen);
+    }
+    if (!fallback_cover.isNull()) {
+        return QStringLiteral("hero_fb:%1:%2x%3:%4:%5")
+            .arg(fallback_cover.cacheKey())
+            .arg(logical_size.width())
+            .arg(logical_size.height())
+            .arg(dpr_pct)
+            .arg(dark ? 1 : 0);
+    }
+    return QStringLiteral("hero_empty:%1x%2:%3:%4")
+        .arg(logical_size.width())
+        .arg(logical_size.height())
+        .arg(dpr_pct)
+        .arg(dark ? 1 : 0);
+}
+
+QPixmap HeroBanner::BuildComposedPixmap(const QSize& logical_size, qreal dpr, bool dark) const {
+    if (logical_size.isEmpty()) {
+        return {};
+    }
+    const QSize pixel_size(std::max(1, static_cast<int>(std::lround(logical_size.width() * dpr))),
+                           std::max(1, static_cast<int>(std::lround(logical_size.height() * dpr))));
+    const QColor window_color = RenHDrumQt::Tokens(dark).window;
+
+    QPixmap out(pixel_size);
+    out.fill(window_color);
+
+    if (!raw_hero.isNull()) {
+        const QPixmap scaled =
+            raw_hero.scaled(pixel_size, Qt::KeepAspectRatioByExpanding, Qt::SmoothTransformation);
+        const int src_x = std::max(0, (scaled.width() - pixel_size.width()) / 2);
+        const int src_y = std::max(
+            0, static_cast<int>(std::lround((scaled.height() - pixel_size.height()) * kHeroCropFocusY)));
+        QPainter painter(&out);
+        painter.setRenderHint(QPainter::SmoothPixmapTransform, true);
+        painter.drawPixmap(QRect(QPoint(0, 0), pixel_size), scaled,
+                           QRect(src_x, src_y, pixel_size.width(), pixel_size.height()));
+        PaintHeroGradient(painter, pixel_size, window_color);
+    } else if (!fallback_cover.isNull()) {
+        out = RenderBlurredCover(fallback_cover, pixel_size, window_color, dark);
+        QPainter painter(&out);
+        PaintHeroGradient(painter, pixel_size, window_color);
+    }
+
+    out.setDevicePixelRatio(dpr);
+    return out;
+}
+
+QPixmap HeroBanner::CurrentComposedPixmap() const {
+    const QSize logical_size = size();
+    if (logical_size.isEmpty()) {
+        return {};
+    }
+    const qreal dpr = std::max<qreal>(1.0, devicePixelRatioF());
+    const bool dark = EffectiveDark();
+    const QString key = CacheKey(logical_size, dpr, dark);
+    QPixmap composed;
+    if (!QPixmapCache::find(key, &composed)) {
+        composed = BuildComposedPixmap(logical_size, dpr, dark);
+        if (!composed.isNull()) {
+            QPixmapCache::insert(key, composed);
+        }
+    }
+    return composed;
+}
+
+void HeroBanner::paintEvent(QPaintEvent*) {
+    const QPixmap current = CurrentComposedPixmap();
+    QPainter painter(this);
+    if (fade.state() == QAbstractAnimation::Running && !previous_pixmap.isNull()) {
+        painter.drawPixmap(rect(), previous_pixmap);
+        painter.setOpacity(fade.currentValue().toReal());
+    }
+    if (!current.isNull()) {
+        painter.drawPixmap(rect(), current);
+    } else {
+        painter.fillRect(rect(), RenHDrumQt::Tokens(EffectiveDark()).window);
+    }
+}
+
+void HeroBanner::resizeEvent(QResizeEvent* event) {
+    QWidget::resizeEvent(event);
+    UpdateTitleText();
+}
+
+void HeroBanner::changeEvent(QEvent* event) {
+    if (event->type() == QEvent::PaletteChange ||
+        event->type() == QEvent::ApplicationPaletteChange) {
+        previous_pixmap = {};
+        ApplyThemeStyles();
+        update();
+    }
+    QWidget::changeEvent(event);
+}
