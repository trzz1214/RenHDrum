+void ConfigurePerGame::UpdateHeroPreview(const QPixmap& map) {
+    hero_scene->clear();
+    const int w = ui->hero_view->maximumWidth();
+    const int h = ui->hero_view->maximumHeight();
+    hero_scene->setSceneRect(0, 0, w, h);
+    if (map.isNull()) {
+        auto* item = hero_scene->addText(tr("No background"));
+        item->setDefaultTextColor(palette().color(QPalette::PlaceholderText));
+        const QRectF br = item->boundingRect();
+        item->setPos((w - br.width()) * 0.5, (h - br.height()) * 0.5);
+        return;
+    }
+    QPixmap scaled = map.scaled(w, h, Qt::KeepAspectRatioByExpanding, Qt::SmoothTransformation);
+    if (scaled.width() > w || scaled.height() > h) {
+        const int x = std::max(0, (scaled.width() - w) / 2);
+        const int y = std::max(0, (scaled.height() - h) / 3);
+        scaled = scaled.copy(x, y, std::min(w, scaled.width()), std::min(h, scaled.height()));
+    }
+    hero_scene->addPixmap(scaled);
+}
+
+void ConfigurePerGame::StageCustomHero(QImage hero) {
+    if (hero.isNull()) {
+        return;
+    }
+    pending_custom_hero = std::move(hero);
+    remove_custom_hero = false;
+    UpdateHeroPreview(QPixmap::fromImage(pending_custom_hero));
+    UpdateRemoveHeroButton();
+}
+
+void ConfigurePerGame::OnUploadCustomHero() {
+    if (title_id == 0 || detect_hero_watcher.isRunning()) {
+        return;
+    }
+    const QString default_dir =
+        file_path.has_parent_path()
+            ? QString::fromStdString(Common::FS::PathToUTF8String(file_path.parent_path()))
+            : QStandardPaths::writableLocation(QStandardPaths::PicturesLocation);
+    const QString selected = QtCommon::Frontend::GetOpenFileName(
+        tr("Select Background Art"), default_dir,
+        tr("Images (*.png *.jpg *.jpeg *.bmp *.webp);;All Files (*)"));
+    if (selected.isEmpty()) {
+        return;
+    }
+    QImage img = ReadIconFile(selected);
+    if (img.isNull()) {
+        QMessageBox::warning(this, tr("Invalid Image"),
+                             tr("Select a PNG, JPEG, BMP or WebP image up to 8 MiB, "
+                                "8192 pixels per side and 16 megapixels."));
+        return;
+    }
+    StageCustomHero(std::move(img));
+}
+
+void ConfigurePerGame::OnDetectCustomHero() {
+    if (title_id == 0 || detect_hero_watcher.isRunning()) {
+        return;
+    }
+    const std::string api_key = UISettings::values.steamgriddb_api_key.GetValue();
+    if (api_key.empty()) {
+        QMessageBox::information(
+            this, tr("Find Background"),
+            tr("Set a SteamGridDB API key in Settings to look up background art automatically, or "
+               "upload an image."));
+        return;
+    }
+    QString query_qstr = ui->display_name->text().trimmed();
+    if (query_qstr.isEmpty()) {
+        query_qstr = QFileInfo(QString::fromStdString(
+            Common::FS::PathToUTF8String(file_path))).completeBaseName();
+    }
+    const std::string query = query_qstr.toStdString();
+    if (query.empty()) {
+        QMessageBox::information(
+            this, tr("Find Background"),
+            tr("Please enter a game name first so background art can be looked up."));
+        return;
+    }
+
+    ui->button_detect_hero->setEnabled(false);
+    ui->button_detect_hero->setText(tr("Finding..."));
+    ui->button_upload_hero->setEnabled(false);
+    ui->button_remove_hero->setEnabled(false);
+    ui->display_name->setEnabled(false);
+    ui->buttonBox->button(QDialogButtonBox::Ok)->setEnabled(false);
+    if (auto* apply = ui->buttonBox->button(QDialogButtonBox::Apply)) {
+        apply->setEnabled(false);
+    }
+
+    detect_hero_cancel = std::make_shared<std::atomic_bool>(false);
+    const bool prefer_newest = (title_id >> 56) == 0x04;
+    detect_hero_watcher.setFuture(
+        QtConcurrent::run([query, api_key, prefer_newest, cancel = detect_hero_cancel] {
+            return LookUpSteamGridDbHero(query, api_key, *cancel, prefer_newest);
+        }));
+}
+
+void ConfigurePerGame::OnRemoveCustomHero() {
+    if (title_id == 0 || detect_hero_watcher.isRunning()) {
+        return;
+    }
+    pending_custom_hero = {};
+    remove_custom_hero = has_custom_hero;
+    UpdateHeroPreview({});
+    UpdateRemoveHeroButton();
+}
+
+void ConfigurePerGame::UpdateRemoveHeroButton() {
+    ui->button_remove_hero->setEnabled(!pending_custom_hero.isNull() ||
+                                       (has_custom_hero && !remove_custom_hero));
+}
