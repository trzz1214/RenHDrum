+ArtworkLookupResult LookUpSteamGridDbHero(const std::string& title, const std::string& api_key,
+                                          const std::atomic_bool& cancel, bool prefer_newest) {
+    ArtworkLookupResult out;
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds{30};
+    const auto failed = [&out](const HttpResult& res) {
+        out.status = ToArtworkFailureStatus(res);
+        out.detail = res.detail;
+        return out;
+    };
+    try {
+        const auto resolved = ResolveSgdbGameId(title, api_key, deadline, cancel, prefer_newest);
+        if (resolved.status != ArtworkLookupStatus::Found) {
+            out.status = resolved.status;
+            out.detail = resolved.detail;
+            return out;
+        }
+        const auto list = HttpGet(
+            fmt::format("{}/heroes/game/{}?types=static&mimes=image/png,image/jpeg", SgdbApiBase,
+                        resolved.game_id),
+            deadline, cancel, api_key);
+        if (list.status != HttpStatus::Ok) {
+            return failed(list);
+        }
+        for (const auto& url : ParseSgdbHeroUrls(list.body)) {
+            const auto image = HttpGet(url, deadline, cancel, {}, MaxHeroHttpBodySize);
+            if (image.status == HttpStatus::Cancelled || image.status == HttpStatus::Timeout) {
+                return failed(image);
+            }
+            QImage decoded;
+            if (image.status == HttpStatus::Ok &&
+                decoded.loadFromData(reinterpret_cast<const uchar*>(image.body.data()),
+                                     static_cast<int>(image.body.size()))) {
+                out.status = ArtworkLookupStatus::Found;
+                out.image = std::move(decoded);
+                return out;
+            }
+        }
+        out.status = ArtworkLookupStatus::NotFound;
+    } catch (const std::exception& e) {
+        out.status = ArtworkLookupStatus::NetworkError;
+        out.detail = e.what();
+    }
+    return out;
+}
