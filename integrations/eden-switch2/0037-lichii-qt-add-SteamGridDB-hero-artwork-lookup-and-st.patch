+
+std::vector<u8> ReadCustomHero(u64 program_id) {
+    if (program_id == 0) {
+        return {};
+    }
+    constexpr qint64 MaxHeroBytes = 16 * 1024 * 1024;
+    QFile file(QString::fromStdString(Common::FS::PathToUTF8String(CustomHeroPath(program_id))));
+    if (!file.open(QIODevice::ReadOnly) || file.size() > MaxHeroBytes) {
+        return {};
+    }
+    const QByteArray bytes = file.read(MaxHeroBytes + 1);
+    if (bytes.size() > MaxHeroBytes) {
+        return {};
+    }
+    return std::vector<u8>(bytes.begin(), bytes.end());
+}
+
+bool SaveCustomHero(u64 program_id, const QImage& image) {
+    if (program_id == 0 || image.isNull()) {
+        return false;
+    }
+    constexpr int MaxHeroWidth = 1920;
+    const QImage scaled =
+        image.width() > MaxHeroWidth
+            ? image.scaledToWidth(MaxHeroWidth, Qt::SmoothTransformation)
+            : image;
+    const auto path = CustomHeroPath(program_id);
+    if (!Common::FS::CreateDirs(path.parent_path())) {
+        LOG_ERROR(Frontend, "Cannot create the custom artwork folder");
+        return false;
+    }
+    QSaveFile file(QString::fromStdString(Common::FS::PathToUTF8String(path)));
+    if (!file.open(QIODevice::WriteOnly) || !scaled.save(&file, "JPEG", 90) || !file.commit()) {
+        LOG_ERROR(Frontend, "Cannot write custom hero for {:016X}", program_id);
+        return false;
+    }
+    return true;
+}
+
+bool RemoveCustomHero(u64 program_id) {
+    return RemoveCustomFile(CustomHeroPath(program_id));
+}
