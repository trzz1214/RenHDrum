+// Static PNG/JPEG hero URLs from a SteamGridDB response, skipping animated images.
+std::vector<std::string> ParseSgdbHeroUrls(const std::string& body) {
+    std::vector<std::string> urls;
+    const auto json = nlohmann::json::parse(body, nullptr, false);
+    if (json.is_discarded() || !json.is_object() || !json.contains("data") ||
+        !json["data"].is_array()) {
+        return urls;
+    }
+    for (const auto& item : json["data"]) {
+        if (urls.size() >= MaxSgdbChoices) {
+            break;
+        }
+        if (!item.is_object() || !item.contains("url") || !item["url"].is_string()) {
+            continue;
+        }
+        if (item.contains("mime") && item["mime"].is_string()) {
+            const auto mime = item["mime"].get<std::string>();
+            if (mime != "image/png" && mime != "image/jpeg") {
+                continue;
+            }
+        }
+        const auto url = item["url"].get<std::string>();
+        const auto lower_url = Common::ToLower(url);
+        const auto query_pos = lower_url.find('?');
+        const std::string_view path_view = query_pos == std::string::npos
+                                               ? std::string_view{lower_url}
+                                               : std::string_view{lower_url}.substr(0, query_pos);
+        if (path_view.ends_with(".webp") || path_view.ends_with(".gif")) {
+            continue;
+        }
+        urls.push_back(url);
+    }
+    return urls;
+}
