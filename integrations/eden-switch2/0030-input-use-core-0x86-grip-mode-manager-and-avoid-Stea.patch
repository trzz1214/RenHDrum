         }
@@ -1323,6 +1394,10 @@ std::shared_ptr<RenHDrumPad> RenHDrumPad::Create(SDL_Joystick* joystick, SDL_Gam
     if (!joystick || !IsRenHDrumLoaded()) {
         return nullptr;
     }
