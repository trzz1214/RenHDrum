+    refresh_timer.setInterval(1000);
+    connect(&refresh_timer, &QTimer::timeout, this, [this] {
+        RefreshPads();
+        RefreshStatus();
+    });
+    refresh_timer.start();
+
+    RefreshPads();
+    ApplyEnabledState();
+    RefreshStatus();
