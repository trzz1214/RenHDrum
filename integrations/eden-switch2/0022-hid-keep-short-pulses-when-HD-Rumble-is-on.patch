Subject: [PATCH 22/23] hid: keep short pulses when HD Rumble is on

---
 src/hid_core/frontend/emulated_controller.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/hid_core/frontend/emulated_controller.cpp b/src/hid_core/frontend/emulated_controller.cpp
index a8759dc..d273f67 100644
--- a/src/hid_core/frontend/emulated_controller.cpp
+++ b/src/hid_core/frontend/emulated_controller.cpp
@@ -1266,7 +1266,9 @@ bool EmulatedController::SetVibration(DeviceIndex device_index, const VibrationV
         return false;
     }
 
-    if (!Settings::values.enable_accurate_vibrations.GetValue()) {
+    // RenHDrum paces short pulses itself; dropping them here loses clicks
+    if (!Settings::values.enable_accurate_vibrations.GetValue() &&
+        !Settings::values.hd_rumble_enabled.GetValue()) {
         using std::chrono::duration_cast;
         using std::chrono::milliseconds;
         using std::chrono::steady_clock;
