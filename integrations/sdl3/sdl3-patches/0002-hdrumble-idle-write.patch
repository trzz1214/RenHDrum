+// HD Rumble (eden-hdr, port of Ryuhdr's SDL2 patch): the Switch pad behind a joystick handle; the joysticks must be locked
+static SDL_HIDAPI_Device *HDRumble_GetSwitchDevice(SDL_Joystick *joystick)
+{
+    SDL_HIDAPI_Device *device = NULL;
+
+    if (!SDL_IsJoystickValid(joystick) || joystick->driver != &SDL_HIDAPI_JoystickDriver ||
+        !HIDAPI_GetJoystickDevice(joystick, &device) || device->driver != &SDL_HIDAPI_DriverSwitch) {
+        return NULL;
+    }
+    return device;
+}
+
+/* USB no-queue (Ryuhdr card 1). gap_ms = minimum gap between writes (5-100), pause_ms = pause of the rumble thread after a
+   write to this pad (1-10; SDL's default is 10). Returns 1 when active, 0 when not (Bluetooth pad, B1 on, input-only pad,
+   enable = 0), -1 when this is not a HIDAPI Switch pad. */
+int SDLCALL SDL_HDRumbleSetNoQueue(SDL_Joystick *joystick, int enable, int gap_ms, int pause_ms)
+{
+    SDL_HIDAPI_Device *device;
+    int result = -1;
+
+    SDL_LockJoysticks();
+    device = HDRumble_GetSwitchDevice(joystick);
+    if (device) {
+        result = HIDAPI_DriverSwitch_SetHDNoQueue(device, enable != 0, gap_ms, false);
+        SDL_SetAtomicInt(&device->hd_pause_ms, result == 1 ? (pause_ms < 1 ? 1 : (pause_ms > 10 ? 10 : pause_ms)) : 0);
+    }
+    SDL_UnlockJoysticks();
+    return result;
+}
+
+/* Bluetooth fast (Ryuhdr card B3): the no-queue writes for a Bluetooth pad; the rumble thread keeps SDL's 10 ms pause.
+   Returns 1 when active, 0 when not (wired pad, B1 on, input-only pad, enable = 0), -1 when this is not a HIDAPI Switch pad. */
+int SDLCALL SDL_HDRumbleSetNoQueueBluetooth(SDL_Joystick *joystick, int enable, int gap_ms)
+{
+    SDL_HIDAPI_Device *device;
+    int result = -1;
+
+    SDL_LockJoysticks();
+    device = HDRumble_GetSwitchDevice(joystick);
+    if (device) {
+        result = HIDAPI_DriverSwitch_SetHDNoQueue(device, enable != 0, gap_ms, true);
+        SDL_SetAtomicInt(&device->hd_pause_ms, 0);
+    }
+    SDL_UnlockJoysticks();
+    return result;
+}
+
+/* Bluetooth after input (Ryuhdr card B1). SDL_SendJoystickEffect only hands the packet over; it is written right after the next
+   input report while the rumble thread is idle. Returns 1 when active, 0 when not (wired pad, no-queue on, input-only pad,
+   enable = 0), -1 when this is not a HIDAPI Switch pad. */
+int SDLCALL SDL_HDRumbleSetBluetoothAfterInput(SDL_Joystick *joystick, int enable)
+{
+    SDL_HIDAPI_Device *device;
+    int result = -1;
+
+    SDL_LockJoysticks();
+    device = HDRumble_GetSwitchDevice(joystick);
+    if (device) {
+        result = HIDAPI_DriverSwitch_SetHDBtAfterInput(device, enable != 0);
+    }
+    SDL_UnlockJoysticks();
+    return result;
+}
