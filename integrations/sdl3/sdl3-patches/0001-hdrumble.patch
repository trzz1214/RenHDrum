+static bool HDRumble_IsNeutral(const SwitchRumbleData_t *pRumble)
+{
+    return (pRumble->rgucData[0] == 0x00 && pRumble->rgucData[1] == 0x01 &&
+            pRumble->rgucData[2] == 0x40 && pRumble->rgucData[3] == 0x40) ||
+           (pRumble->rgucData[0] == 0x00 && pRumble->rgucData[1] == 0x00 &&
+            pRumble->rgucData[2] == 0x00 && pRumble->rgucData[3] == 0x00);
+}
+
+static bool HDRumble_IsClickPacket(const Uint8 *packet8)
+{
+    return !((packet8[0] & 0x03) == 0 && (packet8[3] & 0xC0) == 0x40);
+}
