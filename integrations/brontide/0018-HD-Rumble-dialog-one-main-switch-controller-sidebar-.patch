+        } else if (sdl_joystick) {
+            SDL_RumbleJoystick(sdl_joystick.get(), 0, 0, 0);
+        }
+        CleanupRenHDrum();
+        if (sdl_joystick) {
+            InitRenHDrum();
+        }
+    }
