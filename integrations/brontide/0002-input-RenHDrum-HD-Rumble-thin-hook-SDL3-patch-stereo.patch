+// Compatibility definitions for MSVC STL vectorized algorithms
+// Required when static Qt6 prebuilts reference vector algorithm symbols introduced in newer toolsets.
+
+#ifdef _MSC_VER
+
+#include <__msvc_minmax.hpp>
+#include <algorithm>
+#include <cstdint>
+#include <utility>
+
+extern "C" {
+
+__declspec(noalias) void __stdcall __std_rotate(void* _First, void* _Mid, void* _Last) noexcept {
+    if (_First == _Mid || _Mid == _Last) {
+        return;
+    }
+    char* first = static_cast<char*>(_First);
+    char* mid = static_cast<char*>(_Mid);
+    char* last = static_cast<char*>(_Last);
+    std::rotate(first, mid, last);
+}
+
+void* __stdcall __std_unique_8(void* _First, void* _Last) noexcept {
+    if (_First == _Last) {
+        return _First;
+    }
+    uint64_t* first = static_cast<uint64_t*>(_First);
+    uint64_t* last = static_cast<uint64_t*>(_Last);
+    return std::unique(first, last);
+}
+
+void* __stdcall __std_unique_4(void* _First, void* _Last) noexcept {
+    if (_First == _Last) {
+        return _First;
+    }
+    uint32_t* first = static_cast<uint32_t*>(_First);
+    uint32_t* last = static_cast<uint32_t*>(_Last);
+    return std::unique(first, last);
+}
+
+__declspec(noalias) void __stdcall __std_replace_copy_1(
+    const void* _First, const void* _Last, void* _Dest, uint8_t _Old_val, uint8_t _New_val) noexcept {
+    const uint8_t* first = static_cast<const uint8_t*>(_First);
+    const uint8_t* last = static_cast<const uint8_t*>(_Last);
+    uint8_t* dest = static_cast<uint8_t*>(_Dest);
+    std::replace_copy(first, last, dest, _Old_val, _New_val);
+}
+
+__declspec(noalias) void __stdcall __std_replace_copy_2(
+    const void* _First, const void* _Last, void* _Dest, uint16_t _Old_val, uint16_t _New_val) noexcept {
+    const uint16_t* first = static_cast<const uint16_t*>(_First);
+    const uint16_t* last = static_cast<const uint16_t*>(_Last);
+    uint16_t* dest = static_cast<uint16_t*>(_Dest);
+    std::replace_copy(first, last, dest, _Old_val, _New_val);
+}
+
+_Min_max_element_t __stdcall __std_minmax_element_2u(const void* _First, const void* _Last) noexcept {
+    if (_First == _Last) {
+        return {_First, _First};
+    }
+    const uint16_t* first = static_cast<const uint16_t*>(_First);
+    const uint16_t* last = static_cast<const uint16_t*>(_Last);
+    const auto p = std::minmax_element(first, last);
+    return {p.first, p.second};
+}
+
+} // extern "C"
+
+#endif // _MSC_VER
