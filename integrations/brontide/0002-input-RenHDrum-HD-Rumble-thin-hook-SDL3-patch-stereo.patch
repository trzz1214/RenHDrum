+    void TickRenHDrum(int64_t now_us) {
+        if (!renhdrum_engine || !sdl_joystick) {
+            return;
+        }
+        uint8_t packet[10];
+        if (renhdrum_engine_tick(renhdrum_engine, now_us, packet) == 1) {
